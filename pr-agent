    --arg cycle_active "$cyc" --arg last_cycle "$last_cycle" --arg gh_err "$gh_err" \
    --arg watch "$watch_lbl" --arg interval "$INTERVAL" --arg perm_mode "$PERM_MODE" \
    --arg extras "$extras" --arg concurrency "$CONCURRENCY" \
    --arg max_rounds "$MAX_ROUNDS" --arg max_fails "$MAX_FAILS" --arg retry_max "$RETRY_MAX" \
    --arg reacts "$reacts" --arg table_rows "$TABLE_ROWS" --arg activity_lines "$ACTIVITY_LINES" \
    --arg title_w "$TITLE_W" --arg title_lines "$TITLE_LINES" \
    '{v: 1, now: $now, repo: $repo, update: $update, gh_error: ($gh_err == "1"),
      loading: true, pending_ts: 0, models_ts: 0,
      watcher: {running: ($running == "1"), pid: $pid, launchd: ($launchd == "1"),
                cycle_active: ($cycle_active == "1"),
                last_cycle: ($last_cycle | tonumber? // 0), interval: ($interval | tonumber? // 120)},
      watch: $watch,
      cfg: {perm_mode: $perm_mode, extras: $extras, concurrency: ($concurrency | tonumber? // 2),
            max_rounds: ($max_rounds | tonumber? // 10), max_fails: ($max_fails | tonumber? // 3),
            retry_max: ($retry_max | tonumber? // 3), reacts: $reacts,
            table_rows: ($table_rows | tonumber? // 0), activity_lines: ($activity_lines | tonumber? // 6),
            title_w: ($title_w | tonumber? // 0), title_lines: ($title_lines | tonumber? // 3)},
      prs: [], activity: []}'
}

review_cell() { # reviewDecision isDraft -> sets CELL_T / CELL_C
  if [ "$2" = "true" ]; then CELL_T="draft"; CELL_C="$C_DIM"; return; fi
  case "$1" in
    APPROVED)          CELL_T="✓ approved";     CELL_C="$C_GREEN" ;;
    CHANGES_REQUESTED) CELL_T="✗ changes req."; CELL_C="$C_RED" ;;
    REVIEW_REQUIRED)   CELL_T="◷ needs review"; CELL_C="$C_YELLOW" ;;
    *)                 CELL_T="— no review";    CELL_C="$C_DIM" ;;
  esac
}

state_cell() { # pr gh_state pending -> sets CELL_T / CELL_C and records hint buckets.
               # Pure: reads the record's S_* inputs captured by status_gather
               # (S_AGENT/S_STARTED, S_WTB/S_SB/S_SP, S_SKIP, S_FC, S_RETRYUP, S_GAVEUP,
               # S_ROUNDS) — no marker probes, no map/seen/prs reads.
  local pr="$1" fnow
  case "${S_AGENT:-}" in
    working)
      fnow="${SNOW:-$(date +%s)}"
      CELL_T="↻ agent working $(fmt_ago $(( fnow - S_STARTED )))"; CELL_C="$C_YELLOW$C_BOLD"
      H_WORKING+=" $pr"; return ;;
    interrupted) CELL_T="✗ run interrupted"; CELL_C="$C_RED"; H_DIED+=" $pr"; return ;;
    reading)     CELL_T="↻ reading feedback"; CELL_C="$C_YELLOW"; return ;;
  esac
  case "$2" in
    MERGED) CELL_T="merged — done"; CELL_C="$C_DIM"; return ;;
    CLOSED) CELL_T="closed"; CELL_C="$C_DIM"; return ;;
  esac
  # blocked beats the sync cells — no agent can run while the branch sits in the main checkout;
  # both stay above skip_reason — sync_blocked is a sticky needs-you state for PRs the watcher skips
  if [ "$S_WTB" = "1" ]; then CELL_T="⚠ worktree blocked"; CELL_C="$C_YELLOW"; H_BLOCKED+=" $pr"; return; fi
  if [ "$S_SB" = "1" ]; then CELL_T="✗ main-sync failed — needs you"; CELL_C="$C_RED"; H_SYNCFAIL+=" $pr"; return; fi
  if [ "$S_SP" = "1" ]; then CELL_T="● behind base — sync queued"; CELL_C="$C_CYAN$C_BOLD"; H_PENDING+=" $pr"; return; fi
  case "$S_SKIP" in
    paused)        CELL_T="⏸ paused"; CELL_C="$C_YELLOW"; H_PAUSED+=" $pr"; return ;;
    "round limit") CELL_T="⏸ hit $MAX_ROUNDS-round limit"; CELL_C="$C_RED"; H_LIMIT+=" $pr"; return ;;
    approved)      CELL_T="✓ approved — stopped"; CELL_C="$C_GREEN"; return ;;
  esac
  if [ "${3:-0}" -gt 0 ]; then
    if [ "$S_FC" -gt 0 ]; then
      CELL_T="✗ failed $S_FC/$MAX_FAILS, retrying"; CELL_C="$C_RED"; H_FAILED+=" $pr"
    else
      CELL_T="● $3 new item$([ "$3" -gt 1 ] && echo s || true)"; CELL_C="$C_CYAN$C_BOLD"
    fi
    H_PENDING+=" $pr"; return
  fi
  if [ "$S_RETRYUP" = "1" ]; then CELL_T="✗ review bot failing"; CELL_C="$C_RED"; H_BOTFAIL+=" $pr"; return; fi
  if [ "$S_GAVEUP" = "1" ]; then CELL_T="✗ gave up — needs you"; CELL_C="$C_RED"; H_GAVEUP+=" $pr"; return; fi
  if [ "$S_ROUNDS" -eq 0 ]; then CELL_T="· waiting for review"; CELL_C="$C_DIM"; return; fi
  CELL_T="✓ all feedback handled"; CELL_C="$C_GREEN"
}

recent_event_groups() { # -> watch.log events as collapsed "count<TAB>raw line" groups, oldest first
  { grep -E '^\[[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}\] ' "$LOG_FILE" 2>/dev/null || true; } \
    | awk '{ m = substr($0, 23) }
           m == pm { c++; pl = $0; next }
           NR > 1  { print c "\t" pl }
                   { pm = m; pl = $0; c = 1 }
           END     { if (pl != "") print c "\t" pl }'
}

recent_events() { # n width -> last n collapsed groups (on stdin) formatted as activity lines
  local today re='^PR #([0-9]+): (.*)$' cnt line ts msg when tag style
  today="$(date -r "${SNOW:-$(date +%s)}" +%F 2>/dev/null || date +%F)"
  tail -n "$1" \
    | while IFS=$'\t' read -r cnt line; do
        ts="${line:1:19}" msg="${line:22}" tag='' style=''
        if [ "${ts:0:10}" = "$today" ]; then when="${ts:11:5}"
        else when="$(date -j -f %Y-%m-%d "${ts:0:10}" '+%b %d' 2>/dev/null) ${ts:11:5}"; fi
        if [[ "$msg" =~ $re ]]; then tag="#${BASH_REMATCH[1]}"; msg="${BASH_REMATCH[2]}"; fi
        msg="$(printf '%s' "$msg" | sed -E \
          -e 's/^resuming session ([^ ]+) in .*/resumed agent session \1/' \
          -e 's/^starting new session in .*/started a new agent session/' \
          -e 's/^round done at .*/round finished ✓/' \
          -e 's/^1 new feedback item\(s\) since .*/1 new comment → agent started/' \
          -e 's/^([0-9]+) new feedback item\(s\) since .*/\1 new comments → agent started/' \
          -e 's/^mapped to session /linked to session /' \
          -e 's/^watcher started \(.*(interval=|every )([0-9]+)s.*/watcher started (polls every \2s)/' \
          -e 's/^skipped — session busy.*/skipped: session busy, feedback kept pending/')"
        case "$msg" in
          *finished*|*handled*|*[Aa]pproved*|*reachable*) style="$C_GREEN" ;;
          *fail*|*"gave up"*|*WARNING*|*limit*|*"couldn't"*) style="$C_RED" ;;
          *"new item"*|*comment*|*instruction*) style="$C_CYAN" ;;
          *session*|*skipped*|*paused*) style="$C_YELLOW" ;;
          *) style="$C_DIM" ;;
        esac
        [ "$cnt" -gt 1 ] && msg="$msg (×$cnt)"
        printf '  %s  %s  %s\n' "${C_DIM}$(pad "$when" 12)${C_RESET}" "${C_BOLD}$(pad "$tag" 5)${C_RESET}" \
          "${style}$(trunc "$msg" $(( $2 - 25 )))${C_RESET}"
      done
}

render_hint() { # running -> one contextual "what now" line
  local hint
  if [ "$1" -eq 0 ] && [ -n "$H_PENDING" ]; then
    hint="${C_YELLOW}⚠ watcher is off — new feedback on $(hash_list "$H_PENDING") won't be handled.${C_RESET} Start it: ${C_BOLD}pr-agent on${C_RESET}  (or once: ${C_BOLD}pr-agent run $(first_of "$H_PENDING")${C_RESET})"
  elif [ -n "$H_SYNCFAIL" ]; then
    hint="${C_RED}✗ $(hash_list "$H_SYNCFAIL"): couldn't sync the branch with the base ${MAX_FAILS}× in a row.${C_RESET} See ${C_BOLD}pr-agent logs $(first_of "$H_SYNCFAIL")${C_RESET} — retry with ${C_BOLD}pr-agent sync --apply${C_RESET}"
  elif [ -n "$H_GAVEUP" ]; then
    hint="${C_RED}✗ $(hash_list "$H_GAVEUP"): agent failed ${MAX_FAILS}× in a row and was escalated on the PR.${C_RESET} See ${C_BOLD}pr-agent logs $(first_of "$H_GAVEUP")${C_RESET}, then ${C_BOLD}pr-agent run $(first_of "$H_GAVEUP") --force${C_RESET} or fix by hand"
  elif [ -n "$H_BOTFAIL" ]; then
    hint="${C_RED}✗ $(hash_list "$H_BOTFAIL"): the review run failed ${RETRY_MAX}× in a row — pr-agent stopped pinging the bot.${C_RESET} Check the bot, then ${C_BOLD}pr-agent retry $(first_of "$H_BOTFAIL")${C_RESET} — or clear its state: ${C_BOLD}pr-agent reset $(first_of "$H_BOTFAIL")${C_RESET}"
  elif [ -n "$H_LIMIT" ]; then
    hint="${C_RED}⏸ $(hash_list "$H_LIMIT") hit the $MAX_ROUNDS-round limit — the review loop may not be converging.${C_RESET} Continue once: ${C_BOLD}pr-agent run $(first_of "$H_LIMIT")${C_RESET}, or ${C_BOLD}pr-agent attach $(first_of "$H_LIMIT")${C_RESET}"
  elif [ -n "$H_BLOCKED" ]; then
    if [ "$1" -eq 0 ]; then
      hint="${C_YELLOW}⚠ $(hash_list "$H_BLOCKED") blocked — the PR branch is checked out in the main checkout, so no worktree can be made.${C_RESET} Switch that branch, then run it by hand: ${C_BOLD}pr-agent run $(first_of "$H_BLOCKED")${C_RESET}"
    else
      hint="${C_YELLOW}⚠ $(hash_list "$H_BLOCKED") blocked — the PR branch is checked out in the main checkout, so no worktree can be made.${C_RESET} Switch that branch; it proceeds $NEXT_POLL"
    fi
  elif [ -n "$H_DIED" ]; then
    hint="${C_RED}✗ agent run on $(hash_list "$H_DIED") was interrupted.${C_RESET} It retries on the next poll — see ${C_BOLD}pr-agent logs $(first_of "$H_DIED")${C_RESET}"
  elif [ -n "$H_FAILED" ]; then
    hint="${C_RED}✗ last agent run on $(hash_list "$H_FAILED") failed.${C_RESET} It retries $NEXT_POLL — see ${C_BOLD}pr-agent logs $(first_of "$H_FAILED")${C_RESET}"
  elif [ -n "$H_WORKING" ]; then
    hint="${C_YELLOW}↻ agent is addressing feedback on $(hash_list "$H_WORKING").${C_RESET} Follow along: ${C_BOLD}pr-agent logs $(first_of "$H_WORKING") -f${C_RESET}  · steer: ${C_BOLD}pr-agent attach $(first_of "$H_WORKING")${C_RESET}"
  elif [ -n "$H_PENDING" ]; then
    hint="${C_CYAN}● $(hash_list "$H_PENDING") will be picked up $NEXT_POLL.${C_RESET} Or now: ${C_BOLD}pr-agent run $(first_of "$H_PENDING")${C_RESET}"
  elif [ -n "$H_PAUSED" ]; then
    hint="${C_YELLOW}⏸ $(hash_list "$H_PAUSED") paused.${C_RESET} Resume: ${C_BOLD}pr-agent resume $(first_of "$H_PAUSED")${C_RESET}"
  elif [ "$1" -eq 0 ]; then
    hint="${C_DIM}watcher is off, nothing pending.${C_RESET} Start watching: ${C_BOLD}pr-agent on${C_RESET}"
  else
    hint="${C_GREEN}✓ all caught up${C_RESET} — waiting for new review feedback"
  fi
  printf '%s\n' "$hint"
}

status_table() { # snapshot-file cols [term-rows [watch-every [live]]] -> builds the frame's
                  # fixed and scrollable parts into ST_* globals. Pure — renders only
                  # from the snapshot: no gh/Devin calls, no worktree probes, no
                  # config/map/seen writes, so repaints and resizes may rebuild it
                  # freely. ST_HEAD/ST_TAIL = the fixed frame lines (chrome above and
                  # below the table — header, activity, hint); ST_FOOT = the
                  # unterminated -w footer; ST_TBL = the full logical table (top rule
                  # block + every body row + bottom rule) composed at its own width:
                  # core columns at measured cell widths (never squeezed or dropped),
                  # TITLE at min(widest title, cols − gutter) when TITLE_W=0, the pin
                  # verbatim otherwise. The scroll geometry lands in ST_GUTTER,
                  # ST_LOGIW, ST_BODYLINES, ST_VREG (the record-region height — the
                  # rows left for body lines once fixed chrome is paid, activity
                  # shrinking first), ST_MAXVOFF/ST_MAXHOFF; the record anchors come
                  # back as ST_REC_N/ST_REC_B/ST_REC_C/ST_REC_F (+ ST_MORE* cap row).
                  # ST_MODE: table | empty | compact. All settings read the snapshot's
                  # cfg block, never the process env; the clock freezes to .now.
                  # `live` is the watch's refresh state — live|refreshing|stale|
                  # loading|retry — it only shapes the -w footer; plain callers
                  # leave it empty.
  local snap="$1" cols="$2" term_rows="${3:-}" every="${4:-}" live="${5:-}"
  snapshot_valid "$snap" || die "status snapshot incomplete — gather it again"

  # resolved settings + clock frozen to the snapshot so repeated paints stay identical
  local SNOW repo_n upd gh_err watch_lbl w_run w_pid w_launchd w_cyc w_last
  local loading p_ts m_ts
  local PERM_MODE INTERVAL CONCURRENCY MAX_ROUNDS MAX_FAILS RETRY_MAX \
        TABLE_ROWS ACTIVITY_LINES TITLE_W TITLE_LINES reacts extras
  # \x1f is a non-whitespace IFS — empty fields survive the read (tab would collapse them)
  IFS=$'\x1f' read -r SNOW repo_n upd gh_err watch_lbl w_run w_pid w_launchd w_cyc w_last INTERVAL \
                  loading p_ts m_ts \
    <<<"$(jq -r '[.now, .repo, .update, (.gh_error | tostring), .watch,
                 (.watcher.running | tostring), .watcher.pid, (.watcher.launchd | tostring),
                 (.watcher.cycle_active | tostring), (.watcher.last_cycle | tostring),
                 (.watcher.interval | tostring), ((.loading // false) | tostring),
                 ((.pending_ts // 0) | tostring), ((.models_ts // 0) | tostring)] | join("\u001f")' "$snap")"
  IFS=$'\x1f' read -r PERM_MODE extras CONCURRENCY MAX_ROUNDS MAX_FAILS RETRY_MAX reacts \
                 TABLE_ROWS ACTIVITY_LINES TITLE_W TITLE_LINES \
    <<<"$(jq -r '[.cfg.perm_mode, .cfg.extras, (.cfg.concurrency | tostring),
                  (.cfg.max_rounds | tostring), (.cfg.max_fails | tostring),
                  (.cfg.retry_max | tostring), .cfg.reacts, (.cfg.table_rows | tostring),
                  (.cfg.activity_lines | tostring), (.cfg.title_w | tostring),
                  (.cfg.title_lines | tostring)] | join("\u001f")' "$snap")"

  local running=0 badge poll next
  [ "$w_run" = "true" ] && running=1
  H_PENDING='' H_FAILED='' H_GAVEUP='' H_DIED='' H_WORKING='' H_PAUSED='' H_LIMIT='' H_BOTFAIL='' H_SYNCFAIL='' H_BLOCKED='' NEXT_POLL="on the next poll"
  if [ "$running" -eq 1 ]; then
    badge="${C_GREEN}${C_BOLD}● watching${C_RESET}${C_DIM} (pid $w_pid$([ "$w_launchd" = "true" ] && echo ", launchd" || true))${C_RESET}"
    if [ "$w_cyc" = "true" ]; then
      poll="${C_YELLOW}polling GitHub now${C_RESET}"; NEXT_POLL="in the current poll"
    elif [ "$w_last" -gt 0 ] 2>/dev/null; then
      next=$(( w_last + INTERVAL - SNOW ))
      if [ "$next" -le 0 ]; then poll="next poll any second"; NEXT_POLL="any second"
      else poll="next poll in ${C_BOLD}$(fmt_ago "$next")${C_RESET}"; NEXT_POLL="on the next poll (in $(fmt_ago "$next"))"; fi
    else
      poll="first poll starting"
    fi
  else
    badge="${C_RED}${C_BOLD}○ stopped${C_RESET}"
    if [ "$w_last" -gt 0 ] 2>/dev/null; then poll="last poll $(fmt_rel "$w_last")"; else poll="never polled"; fi
  fi

  local line1 line2 gherr_line='' foot_line='' act_hdr=''
  line1="${C_BOLD}${C_BLUE}pr-agent v${VERSION}${C_RESET}  ${badge}   ${C_BOLD}${repo_n}${C_RESET}${upd:+ ${C_YELLOW}· update v$upd${C_RESET}}"
  line2="${C_DIM}watching ${watch_lbl} · every $(fmt_dur "$INTERVAL") · mode ${PERM_MODE}${extras} · ${CONCURRENCY} parallel · max ${MAX_ROUNDS} rounds · reacts to ${reacts} · ${C_RESET}${poll}"
  [ "$gh_err" = "true" ] && gherr_line="${C_YELLOW}⚠ couldn't reach GitHub — showing cached data (check: gh auth status)${C_RESET}"

  if [ -n "$every" ]; then   # -w: the live footer doubles as the fixed controls
    # `updated` reports the snapshot's own clock (data time), not the paint's —
    # a stale or refreshing frame must not look freshly fetched. `live` comes
    # from the watch: refreshing while a worker is out, stale when the last
    # attempt failed or hit its bound, loading/retry before the first data.
    local ftime data_age p_age m_age fresh
    ftime="$(date -r "$SNOW" +%H:%M:%S 2>/dev/null || date +%H:%M:%S)"
    data_age=$(( $(date +%s) - SNOW )); [ "$data_age" -lt 0 ] && data_age=0
    case "$live" in
      loading)    foot_line="${C_DIM}… gathering status${C_RESET}${C_DIM} · refresh ${every}s${C_RESET}" ;;
      retry)      foot_line="${C_YELLOW}⚠ gather failed — retrying${C_RESET}" ;;
      refreshing) foot_line="${C_DIM}live · refresh ${every}s${C_RESET}" ;;
      stale)      foot_line="${C_YELLOW}⚠ refresh failed${C_RESET}" ;;
      *)          foot_line="${C_DIM}live · refresh ${every}s · updated ${ftime}${C_RESET}" ;;
    esac
    # the controls are the footer's fixed half — they land before the variable
    # state/cache notes so trunc drops a note, never the help, in exactly the
    # annotated states where the help matters most (annotated bases stay short
    # so base + controls + the state note still fit at 80 cols)
    foot_line+="${C_DIM} · ${C_BOLD}↑↓/jk ←→/hl PgUp/PgDn g/G 0/\$${C_RESET}${C_DIM} · ${C_BOLD}q${C_RESET}${C_DIM} quit${C_RESET}"
    case "$live" in
      refreshing) foot_line+="${C_DIM} · ${C_CYAN}↻ refreshing${C_RESET}" ;;
      stale)      foot_line+="${C_DIM} · data $(fmt_ago "$data_age") old${C_RESET}" ;;
    esac
    # freshness notes for the shared caches: past ~2 refresh cycles old means
    # the bounded refresh couldn't replace them and prior data is being shown.
    # A cycle is the slower of the watch interval and the caches' own 30s ttl —
    # under -w N the caches legitimately age to N between gathers, so a flat
    # 60s would flag a healthy -w 300 for most of every cycle.
    fresh=60
    [[ "$every" =~ ^[0-9]+$ ]] && [ "$every" -gt 30 ] 2>/dev/null && fresh=$(( 2 * every ))
    p_age=0; m_age=0
    [ "${p_ts:-0}" -gt 0 ] 2>/dev/null && p_age=$(( $(date +%s) - p_ts ))
    [ "${m_ts:-0}" -gt 0 ] 2>/dev/null && m_age=$(( $(date +%s) - m_ts ))
    case "$live" in
      loading|retry) ;;
      *) [ "$p_age" -gt "$fresh" ] 2>/dev/null && \
           foot_line+="${C_DIM} · counts $(fmt_ago "$p_age") old${C_RESET}"
         [ "$m_age" -gt "$fresh" ] 2>/dev/null && \
           foot_line+="${C_DIM} · model $(fmt_ago "$m_age") old${C_RESET}" ;;
    esac
  fi                           # line — kept short so it stays one physical line
  if [ "$ACTIVITY_LINES" -gt 0 ]; then
    act_hdr="${C_BOLD}recent activity${C_RESET}${C_DIM}  (full log: pr-agent logs · agent transcript: pr-agent logs N)${C_RESET}"
  fi

  # records arrive in status_prs order (most recent activity first); the two passes
  # below draw open first, done dimmed — each row's TSV is re-parsed per pass
  local -a lines=()
  local l
  while IFS= read -r l; do lines+=( "$l" ); done \
    < <(jq -r '.prs[] | [(.n // 0), (.state // ""), (.title // "" | gsub("[\u0000-\u001f\u007f-\u009f]"; " ")),
                        (.review // ""), ((.draft // false) | tostring),
                        ((.pending // 0) | tostring), ((.rounds // 0) | tostring),
                        ((.fail_count // 0) | tostring),
                        (.gave_up // ""), (.retry_gave_up // ""), (.worktree_blocked // ""),
                        (.sync_blocked // ""), (.sync_pending // ""),
                        (.skip // ""), (.agent // ""), ((.agent_started // 0) | tostring),
                        (.session_id // ""),
                        (.last_run // 0 | if . == 0 then "" else tostring end),
                        (.model // "")] | join("\u001f")' "$snap")

  # one pass in draw order (open first, done dimmed): caches each row's cells
  # and fills the H_* hint buckets so the hint sees every PR, visible or not
  local -a order=() ostate=() obase=() ort=() orc=() ost=() osc=() otit=() ornd=() omdl=() olrd=() osidd=()
  local num state title review draft pending rounds fc gu rgu wtb sb sp skip agent astarted sid lrun model
  local pass base rt rc
  if [ "${#lines[@]}" -gt 0 ]; then   # bash 3.2 set -u: "${arr[@]}" on an empty array is unbound
  for pass in open done; do
    for l in "${lines[@]}"; do
      IFS=$'\x1f' read -r num state title review draft pending rounds fc gu rgu wtb sb sp \
                      skip agent astarted sid lrun model <<<"$l"
      if [ "$pass" = open ]; then [ "$state" = OPEN ] || continue; base=''
      else [ "$state" != OPEN ] || continue; base="$C_DIM"; fi
      review_cell "$review" "$draft"; rt="$CELL_T" rc="$CELL_C"
      S_AGENT="$agent" S_STARTED="$astarted" S_WTB="$wtb" S_SB="$sb" S_SP="$sp" \
      S_SKIP="$skip" S_FC="$fc" S_RETRYUP="$rgu" S_GAVEUP="$gu" S_ROUNDS="$rounds"
      state_cell "$num" "$state" "$pending"
      order+=( "$num" ); ostate+=( "$state" ); obase+=( "$base" )
      ort+=( "$rt" ); orc+=( "$rc" ); ost+=( "$CELL_T" ); osc+=( "$CELL_C" )
      otit+=( "$(title_disp "$title")" )   # conventional-commit prefix dropped
      ornd+=( "$rounds" )
      if [ -n "$model" ]; then omdl+=( "$model" )
      elif [ -n "$sid" ]; then omdl+=( unknown )   # session mapped, no verified evidence
      else omdl+=( '—' ); fi                       # no session — the em-dash case
      olrd+=( "$(fmt_rel "$lrun")" ); osidd+=( "${sid:-—}" )   # empty session display value is —
    done
  done
  fi
  local hint_line; hint_line="$(render_hint "$running" || true)"

  if [ -n "$term_rows" ]; then
    # bounded output never leans on terminal soft-wrap — every chrome line is
    # hard-clipped to the viewport (activity events already size to cols)
    line1="$(trunc "$line1" "$cols")"; line2="$(trunc "$line2" "$cols")"
    hint_line="$(trunc "$hint_line" "$cols")"
    [ -n "$gherr_line" ] && gherr_line="$(trunc "$gherr_line" "$cols")"
    [ -n "$foot_line" ] && foot_line="$(trunc "$foot_line" "$cols")"
  fi

  # the frame is assembled from parts: ST_HEAD fixed chrome, ST_TBL the full
  # logical table (top rule block + every body line + bottom rule), ST_TAIL the
  # blank/activity/hint block; ST_FOOT carries the unterminated -w footer
  ST_MODE=table; ST_HEAD=() ST_TAIL=() ST_TBL=() ST_FOOT="$foot_line"
  ST_REC_N=() ST_REC_B=() ST_REC_C=() ST_REC_F=(); ST_MORE='' ST_MORE_F=0 ST_MORE_B=0
  ST_GUTTER=0 ST_LOGIW=0 ST_TITLE_W=0 ST_SPAN_W=0 ST_PROJECTED=0
  ST_COLS="$cols" ST_TABLE_ROWS="$TABLE_ROWS" ST_TITLE_LINES="$TITLE_LINES" ST_NRECS="${#order[@]}"
  ST_BODYLINES=0 ST_VREG=0 ST_MAXVOFF=0 ST_MAXHOFF=0
  local act_n="$ACTIVITY_LINES"

  if [ "$cols" -lt 30 ] || { [ -n "$term_rows" ] && [ "$term_rows" -lt 8 ]; }; then
    # compact safe state — a full grid can't stay bounded below ~30×8; chrome is
    # suppressed too (a wrapped hint alone would eat the budget)
    ST_MODE=compact; ST_FOOT=''
    ST_HEAD=( "$(trunc "$line1" "$cols")$C_RESET"
              "$(trunc "${C_YELLOW}terminal too small${C_RESET}${C_DIM} — need ≥30 cols × ≥8 rows${C_RESET}" "$cols")"
              "${C_DIM}${#order[@]} PR records tracked${C_RESET}" )
    return 0
  fi

  ST_HEAD=( "$line1" "$line2" )
  [ -n "$gherr_line" ] && ST_HEAD+=( "$gherr_line" )
  ST_HEAD+=( '' )

  if [ "${#lines[@]}" -eq 0 ]; then
    ST_MODE=empty   # defined no-anchor state: no records, no scroll geometry
    if [ "$loading" = "true" ]; then
      ST_HEAD+=( "$(trunc "${C_DIM}gathering status — the first snapshot is on its way…${C_RESET}" "$cols")" )
    else
      ST_HEAD+=( "$(trunc "${C_DIM}no PRs to show — no open non-draft PRs and no agent history yet${C_RESET}" "$cols")" )
    fi
  else
    # measure every cell once (headings included) — metadata columns get their true
    # content width so long agent states and model ids stay reachable off-screen
    # rather than silently truncated; lower-case tags carry per-record widths
    local meas tag wv
    local pr_w=4 rev_w=6 st_w=11 rnd_w=6 mdl_w=5 lrun_w=8 ses_w=7 title_max=5
    local -a cw_p=() cw_r=() cw_s=() cw_d=() cw_m=() cw_l=() cw_x=()
    meas="$( {
      printf 'P\tPR\nR\tREVIEW\nS\tAGENT STATE\nD\tROUNDS\nM\tMODEL\nL\tLAST RUN\nI\tSESSION\n'
      local mi
      for (( mi = 0; mi < ${#order[@]}; mi++ )); do   # cells count twice: once into the
        printf 'P\t#%s\np%s\t#%s\n' "${order[$mi]}" "$mi" "${order[$mi]}"   # column max,
        printf 'R\t%s\nr%s\t%s\n' "${ort[$mi]}" "$mi" "${ort[$mi]}"         # once per-cell
        printf 'S\t%s\ns%s\t%s\n' "${ost[$mi]}" "$mi" "${ost[$mi]}"
        printf 'D\t%s\nd%s\t%s\n' "${ornd[$mi]}" "$mi" "${ornd[$mi]}"
        printf 'M\t%s\nm%s\t%s\n' "${omdl[$mi]}" "$mi" "${omdl[$mi]}"
        printf 'L\t%s\nl%s\t%s\n' "${olrd[$mi]}" "$mi" "${olrd[$mi]}"
        printf 'I\t%s\nx%s\t%s\n' "${osidd[$mi]}" "$mi" "${osidd[$mi]}"
        printf 'T\t%s\n' "${otit[$mi]}"
      done
    } | cell_ops max )"
    while IFS=$'\t' read -r tag wv; do
      case "$tag" in
        P) pr_w=$wv ;; T) title_max=$wv ;; R) rev_w=$wv ;; S) st_w=$wv ;;
        D) rnd_w=$wv ;; M) mdl_w=$wv ;; L) lrun_w=$wv ;; I) ses_w=$wv ;;
        p*) cw_p[${tag#?}]=$wv ;; r*) cw_r[${tag#?}]=$wv ;; s*) cw_s[${tag#?}]=$wv ;;
        d*) cw_d[${tag#?}]=$wv ;; m*) cw_m[${tag#?}]=$wv ;; l*) cw_l[${tag#?}]=$wv ;;
        x*) cw_x[${tag#?}]=$wv ;;
      esac
    done <<<"$meas"

    # TITLE gets the largest useful width beside the frozen PR gutter: bounded by
    # real content and the viewport, never squeezed to fit the metadata columns —
    # those overflow into logical space (the projection clips them) instead
    local gutter=$(( pr_w + 4 ))                 # │␣PR␣│
    local usable_vp=$(( cols - gutter ))
    local title_w
    if [ "$TITLE_W" -gt 0 ]; then title_w=$TITLE_W; [ "$title_w" -lt 5 ] && title_w=5   # pin = logical width, floored at the TITLE heading
    else title_w=$title_max; [ "$title_w" -gt "$usable_vp" ] && title_w=$usable_vp; [ "$title_w" -lt 1 ] && title_w=1; fi

    COL_W=( "$pr_w" "$title_w" "$rev_w" "$st_w" "$rnd_w" "$mdl_w" )
    local -a hdr_args=( PR "$C_BOLD" 2 TITLE "$C_BOLD" 5 REVIEW "$C_BOLD" 6 "AGENT STATE" "$C_BOLD" 11 ROUNDS "$C_BOLD" 6 MODEL "$C_BOLD" 5 )
    local show_lastrun=0 show_session=0 i logi_w=0
    for i in "${COL_W[@]}"; do logi_w=$(( logi_w + i + 3 )); done; logi_w=$(( logi_w + 1 ))
    if [ $(( logi_w + lrun_w + 3 )) -le "$cols" ]; then   # optional columns only into
      show_lastrun=1; COL_W+=( "$lrun_w" ); logi_w=$(( logi_w + lrun_w + 3 ))   # genuine slack
      hdr_args+=( "LAST RUN" "$C_BOLD" 8 )
    fi
    if [ $(( logi_w + ses_w + 3 )) -le "$cols" ]; then
      show_session=1; COL_W+=( "$ses_w" ); logi_w=$(( logi_w + ses_w + 3 ))
      hdr_args+=( SESSION "$C_BOLD" 7 )
    fi
    local span_w=$(( logi_w - gutter - 3 ))   # merged TITLE..last content width (cap row)

    local shown hidden=0 hidden_open=0 cost k gherr_n=0 lnext bnext=0 drawn=0
    local title_lines="$TITLE_LINES"
    shown="${#order[@]}"
    # TABLE_ROWS counts records, not screen lines: 0 = every record renders
    # (scrolling reaches them all); a positive cap keeps the first N.
    # TITLE_LINES is a user/resolved cap — never shrunk to fit the screen.
    [ "$TABLE_ROWS" -gt 0 ] && [ "$TABLE_ROWS" -lt "$shown" ] && shown="$TABLE_ROWS"
    [ "$gh_err" = "true" ] && gherr_n=1
    lnext=$(( 2 + gherr_n + 1 + 3 + 1 ))   # first record's 1-based frame line: header(2) + gherr + blank + rules/header(3)

    local -a row=() crow=()
    ST_TBL+=( "$(draw_rule ┌ ┬ ┐)" )
    ST_TBL+=( "$(draw_row "${hdr_args[@]}")" )
    ST_TBL+=( "$(draw_rule ├ ┼ ┤)" )
    for (( i = 0; i < ${#order[@]}; i++ )); do
      num="${order[$i]}"
      if [ "$drawn" -lt "$shown" ]; then
        wrap "${otit[$i]}" "$title_w" "$title_lines"; cost=${#WRAP_LINES[@]}
        row=( "#$num" "$C_BOLD${obase[$i]}" "${cw_p[$i]}"
              "${WRAP_LINES[0]}" "${obase[$i]}" "${WRAP_W[0]}"
              "${ort[$i]}" "${orc[$i]}" "${cw_r[$i]}"
              "${ost[$i]}" "${osc[$i]}" "${cw_s[$i]}"
              "${ornd[$i]}" "${obase[$i]}" "${cw_d[$i]}"
              "${omdl[$i]}" "${obase[$i]}" "${cw_m[$i]}" )
        [ "$show_lastrun" -eq 1 ] && row+=( "${olrd[$i]}" "${obase[$i]}" "${cw_l[$i]}" )
        [ "$show_session" -eq 1 ] && row+=( "${osidd[$i]}" "$C_DIM" "${cw_x[$i]}" )
        ST_TBL+=( "$(draw_row "${row[@]}")" )
        for (( k = 1; k < cost; k++ )); do   # continuations: title text only, regular blank cells
          crow=( '' '' 0 "${WRAP_LINES[$k]}" "${obase[$i]}" "${WRAP_W[$k]}" '' '' 0 '' '' 0 '' '' 0 '' '' 0 )
          [ "$show_lastrun" -eq 1 ] && crow+=( '' '' 0 )
          [ "$show_session" -eq 1 ] && crow+=( '' '' 0 )
          ST_TBL+=( "$(draw_row "${crow[@]}")" )
        done
        ST_REC_N+=( "$num" ); ST_REC_B+=( "$bnext" ); ST_REC_C+=( "$cost" ); ST_REC_F+=( "$lnext" )
        lnext=$(( lnext + cost )); bnext=$(( bnext + cost ))
        drawn=$(( drawn + 1 ))
        continue
      fi
      [ "${ostate[$i]}" = OPEN ] && hidden_open=$(( hidden_open + 1 ))
      hidden=$(( hidden + 1 ))
    done
    if [ "$hidden" -gt 0 ]; then   # only reachable via an explicit TABLE_ROWS cap
      local more="… ${hidden} more"
      [ "$hidden_open" -gt 0 ] && more="$more ($hidden_open open)"
      ST_TBL+=( "$(draw_span "$more — TABLE_ROWS=$TABLE_ROWS" "$C_DIM" "$span_w" "$(cell_len "$more — TABLE_ROWS=$TABLE_ROWS")")" )
      ST_MORE="$hidden" ST_MORE_F="$lnext" ST_MORE_B="$bnext"
    fi
    ST_TBL+=( "$(draw_rule └ ┴ ┘)" )
    ST_BODYLINES=$(( ${#ST_TBL[@]} - 4 ))
    ST_GUTTER="$gutter" ST_LOGIW="$logi_w" ST_TITLE_W="$title_w" ST_SPAN_W="$span_w"
    [ -n "$every" ] && ST_PROJECTED=1
    ST_MAXHOFF=$(( logi_w - cols )); [ "$ST_MAXHOFF" -lt 0 ] && ST_MAXHOFF=0
  fi

  # vertical budget: the record region gets what remains once fixed chrome is
  # paid for — activity (header + events + its trailing blank) shrinks into the
  # leftovers before it could starve the body; no row budget keeps everything
  if [ -n "$term_rows" ]; then
    local fixed avail act_room
    fixed=$(( $(phys_lines "$line1" "$cols") + $(phys_lines "$line2" "$cols") + 2 + $(phys_lines "$hint_line" "$cols") ))   # +2: blank before table + blank before hint
    [ -n "$gherr_line" ] && fixed=$(( fixed + $(phys_lines "$gherr_line" "$cols") ))
    [ -n "$foot_line" ] && fixed=$(( fixed + 1 + $(phys_lines "$foot_line" "$cols") ))
    [ "$ST_MODE" = table ] && fixed=$(( fixed + 4 ))   # top rule block + bottom rule
    avail=$(( term_rows - 1 - fixed ))
    if [ "$ST_MODE" = table ]; then
      ST_VREG="$avail"; [ "$ST_VREG" -gt "$ST_BODYLINES" ] && ST_VREG="$ST_BODYLINES"; [ "$ST_VREG" -lt 1 ] && ST_VREG=1
      ST_MAXVOFF=$(( ST_BODYLINES - ST_VREG )); [ "$ST_MAXVOFF" -lt 0 ] && ST_MAXVOFF=0
      act_room=$(( avail - ST_VREG ))
    else act_room="$avail"; fi
    [ "$act_room" -lt 0 ] && act_room=0
    if [ "$ACTIVITY_LINES" -gt 0 ]; then
      act_n=$(( act_room - 2 )); [ "$act_n" -gt "$ACTIVITY_LINES" ] && act_n="$ACTIVITY_LINES"; [ "$act_n" -lt 0 ] && act_n=0
    fi
  else
    [ "$ST_MODE" = table ] && ST_VREG="$ST_BODYLINES"
  fi

  ST_TAIL+=( '' )
  if [ "$act_n" -gt 0 ]; then
    ST_TAIL+=( "$(trunc "$act_hdr" "$cols")" )
    local ev
    while IFS= read -r ev; do ST_TAIL+=( "$ev" ); done \
      < <(jq -r '.activity[]?' "$snap" | recent_events "$act_n" "$cols")
    ST_TAIL+=( '' )
  fi
  ST_TAIL+=( "$(trunc "$hint_line" "$cols")" )
}

status_view() { # cols every hoff voff -> one frame (stdout) composed from the ST_*
                # parts status_table left: fixed chrome verbatim; the table
                # projected through body window [voff, voff+ST_VREG) at cell
                # offset hoff between pinned top/bottom rules — plain mode
                # (empty every) prints the whole logical table. Both offsets
                # clamp into [0, ST_MAX*]; applied values land in ST_VOFF/ST_HOFF.
  local cols="$1" every="${2:-}" hoff="${3:-0}" voff="${4:-0}"
  ST_HOFF="${hoff:-0}"; ST_VOFF="${voff:-0}"
  [ "$ST_HOFF" -lt 0 ] 2>/dev/null && ST_HOFF=0
  [ "$ST_HOFF" -gt "$ST_MAXHOFF" ] && ST_HOFF="$ST_MAXHOFF"
  [ "$ST_VOFF" -lt 0 ] 2>/dev/null && ST_VOFF=0
  [ "$ST_VOFF" -gt "$ST_MAXVOFF" ] && ST_VOFF="$ST_MAXVOFF"
  [ "${#ST_HEAD[@]}" -gt 0 ] && printf '%s\n' "${ST_HEAD[@]}"
  if [ "$ST_MODE" = table ]; then
    if [ -n "$every" ]; then   # bounded viewport: rules stay pinned, the record
      local nb               # window slides between them, gutter frozen at hoff
      nb=$(( ${#ST_TBL[@]} - 1 ))
      { printf '%s\n' "${ST_TBL[@]:0:3}"
        printf '%s\n' "${ST_TBL[@]:$(( 3 + ST_VOFF )):$ST_VREG}"
        printf '%s\n' "${ST_TBL[$nb]}"
      } | cell_ops proj -v gutter="$ST_GUTTER" -v cols="$cols" -v off="$ST_HOFF"
    else
      printf '%s\n' "${ST_TBL[@]}"
    fi
  fi
  [ "${#ST_TAIL[@]}" -gt 0 ] && printf '%s\n' "${ST_TAIL[@]}"
  [ -n "$ST_FOOT" ] && printf '\n%s' "$ST_FOOT"
  return 0
}

status_meta() { # meta-out -> geometry + per-record anchors (jsonl) from the ST_*
                # state status_table/status_view left behind
  local out="$1" i
  { printf '%s\n' "{\"type\":\"geometry\",\"cols\":$ST_COLS,\"title_w\":$ST_TITLE_W,\"gutter\":$ST_GUTTER,\"logical_w\":$ST_LOGIW,\"hoff\":$ST_HOFF,\"voff\":$ST_VOFF,\"projected\":$ST_PROJECTED,\"span_w\":$ST_SPAN_W,\"title_lines\":$ST_TITLE_LINES,\"table_rows\":$ST_TABLE_ROWS,\"records\":$ST_NRECS,\"vreg\":$ST_VREG,\"body_lines\":$ST_BODYLINES,\"max_voff\":$ST_MAXVOFF,\"max_hoff\":$ST_MAXHOFF}"
    for (( i = 0; i < ${#ST_REC_N[@]}; i++ )); do
      printf '%s\n' "{\"n\":${ST_REC_N[$i]},\"line\":${ST_REC_F[$i]},\"bline\":${ST_REC_B[$i]},\"title_lines\":${ST_REC_C[$i]}}"
    done
    [ -n "$ST_MORE" ] && printf '%s\n' "{\"more\":$ST_MORE,\"line\":$ST_MORE_F,\"bline\":$ST_MORE_B}"
    return 0
  } >"$out" 2>/dev/null || true
}

status_layout() { # snapshot-file cols [term-rows [watch-every [meta-out [hoff [voff [live]]]]]] ->
                  # the status frame, rendered purely from the snapshot: build
                  # (status_table) then paint (status_view). watch-every non-empty
                  # bounds the viewport — pinned rules, frozen PR gutter, body
                  # window [voff, voff+vreg) at hoff — while plain status prints
                  # the whole logical table; meta-out gets the scroll anchors.
                  # live is the watch's refresh-state word for the footer.
  status_table "$1" "$2" "${3:-}" "${4:-}" "${8:-}"
  status_view "$2" "${4:-}" "${6:-0}" "${7:-0}"
  [ -z "${5:-}" ] || status_meta "$5"
  return 0
}

status_interactive() { # -> 0 when -w can drive the keyboard viewport: usable
                       # input + output TTYs and the terminal controls it needs
  [ -t 0 ] && [ -t 1 ] || return 1
  stty -g >/dev/null 2>&1 || return 1
  term_cols >/dev/null 2>&1 && term_lines >/dev/null 2>&1 || return 1
}

status_tty_restore() { # EXIT-trap terminal restore — reads globals only (function
                       # locals are already unwound when EXIT fires): cancel the
                       # in-flight gather worker subtree (WATCH_WORKER — the
                       # dashboard's own children only, never watcher/agent
                       # processes), the saved termios, cursor visibility, the
                       # alt screen, the watch snapshot + its private TMPDIR.
                       # Idempotent. Emit to /dev/tty, never stdout: nothing may
                       # leak control sequences into a redirected stdout.
  [ "${WATCH_TTY:-0}" = "1" ] || return 0
  WATCH_TTY=0
  trap '' INT TERM HUP 2>/dev/null || true   # cleanup runs to completion — a second
  [ -n "${WATCH_WORKER:-}" ] && { worker_kill "$WATCH_WORKER"; WATCH_WORKER=''; }  # signal can't re-enter
  [ -n "${WATCH_SNAP:-}" ] && rm -f "$WATCH_SNAP" "$WATCH_SNAP.new" "$WATCH_SNAP.done"; WATCH_SNAP=''
  [ -n "${WATCH_TMPD:-}" ] && rm -rf "$WATCH_TMPD"; WATCH_TMPD=''
  [ -n "${STTY_SAVE:-}" ] && stty "$STTY_SAVE" </dev/tty 2>/dev/null
  { tput cnorm 2>/dev/null; tput rmcup 2>/dev/null || printf '\033[?1049l'; } >/dev/tty 2>/dev/null || true
  return 0
}

keybuf_drain() { # -> appends one byte of pending input to KEYBUF, bounded at the
                 # 1s read -t deadline. bash 3.2's `read -n` retries VMIN=0's
                 # zero-byte returns forever, so read -t 1 is the only bounded
                 # read: pending bytes come back instantly, only a genuinely
                 # stalled stream (lone ESC, abandoned partial sequence) pays
                 # the second — never an actual hang.
  local more=''
  IFS= read -rsn1 -t 1 more 2>/dev/null || true
  KEYBUF+="$more"
}

status_key() { # -> KEY: up/down/left/right/pgup/pgdn/top/bot/hmin/hmax/quit/eof/
               # none. One keypress from KEYBUF or stdin (-icanon -echo, ISIG
               # kept): read -t 1 is the 1s poll tick — bash 3.2 gives rc 1 for
               # BOTH timeout and EOF, so a dead/closed stdin is detected by its
               # instant failures: several empty reads inside one wall second
               # mean EOF (real ticks take ~1s each; a WINCH interruption resets
               # the count). ESC opens a small CSI/SS3 decoder — a byte that
               # can't extend a known sequence is left in (or pushed back
               # into) KEYBUF and dispatched as its own key next call, so
               # ESC-then-q still quits.
  KEY=none
  local ch c p='' final=''
  if [ -n "$KEYBUF" ]; then ch="${KEYBUF:0:1}"; KEYBUF="${KEYBUF:1}"
  else
    local rc=0
    IFS= read -rsn1 -t 1 ch 2>/dev/null || rc=$?
    if [ "$rc" -ne 0 ]; then
      if [ "${WATCH_RESIZE:-0}" = "1" ]; then KEY_EOF_N=0
      elif [ "$SECONDS" = "${KEY_EOF_S:-x}" ]; then KEY_EOF_N=$(( ${KEY_EOF_N:-0} + 1 ))
      else KEY_EOF_S=$SECONDS; KEY_EOF_N=1; fi
      [ "${KEY_EOF_N:-0}" -gt 5 ] && KEY=eof
      return 0
    fi
  fi
  case "$ch" in
    k) KEY=up ;;    j) KEY=down ;;
    h) KEY=left ;;  l) KEY=right ;;
    g) KEY=top ;;   G) KEY=bot ;;
    0) KEY=hmin ;;  '$') KEY=hmax ;;
    q) KEY=quit ;;
    $'\e')
      keybuf_drain
      case "${KEYBUF:0:1}" in
        '[') KEYBUF="${KEYBUF:1}"
             while [ -z "$final" ]; do
               if [ -z "$KEYBUF" ]; then keybuf_drain; [ -z "$KEYBUF" ] && break; fi
               c="${KEYBUF:0:1}"; KEYBUF="${KEYBUF:1}"
               if [[ "$c" =~ ^[0-9\;?]$ ]]; then p="$p$c"; else final="$c"; fi
             done
             case "$final" in
               A) KEY=up ;;   B) KEY=down ;;
               C) KEY=right ;; D) KEY=left ;;
               H) KEY=top ;;  F) KEY=bot ;;
               '~') case "${p%%;*}" in
                      5) KEY=pgup ;; 6) KEY=pgdn ;;
                      1|7) KEY=top ;; 4|8) KEY=bot ;;
                    esac ;;
               ?) KEYBUF="$final$KEYBUF" ;;   # unknown final — requeue it to
             esac ;;                          # dispatch as its own key next call
        O) KEYBUF="${KEYBUF:1}"
           [ -z "$KEYBUF" ] && keybuf_drain
           c="${KEYBUF:0:1}"; [ -n "$c" ] && KEYBUF="${KEYBUF:1}"
           case "$c" in
             A) KEY=up ;;   B) KEY=down ;;
             C) KEY=right ;; D) KEY=left ;;
             H) KEY=top ;;  F) KEY=bot ;;
             ?) KEYBUF="$c$KEYBUF" ;;
           esac ;;
      esac ;;
  esac
  return 0
}

status_anchor() { # anchor-pr anchor-delta [old-height old-order prev-voff] ->
                  # resolved voff: re-anchors the viewport against the freshly
                  # built ST_REC_* table. Same PR — its new body line plus the
                  # intra-title delta: old-height > 0 scales the delta by
                  # new/old record height (the resize best-effort), 0 keeps it
                  # verbatim (the refresh rule). Evicted — the nearest surviving
                  # successor in the OLD order, then predecessor, then the first
                  # record that order didn't have. prev-voff 0 stays top-
                  # following; an empty build is the defined 0 state.
  local an="$1" ad="${2:-0}" aoc="${3:-0}" oldorder="${4:-}" pvoff="${5:-0}"
  local i n
  [ "$pvoff" -eq 0 ] 2>/dev/null && { echo 0; return; }
  [ "${#ST_REC_N[@]}" -eq 0 ] && { echo 0; return; }
  local all=" ${ST_REC_N[*]} "
  if [ -n "$an" ]; then
    for (( i = 0; i < ${#ST_REC_N[@]}; i++ )); do
      if [ "${ST_REC_N[$i]}" = "$an" ]; then
        n="$ad"
        [ "$aoc" -gt 0 ] 2>/dev/null && [ "$aoc" != "${ST_REC_C[$i]}" ] && \
          n=$(( ad * ${ST_REC_C[$i]} / aoc ))
        [ "$n" -lt 0 ] 2>/dev/null && n=0
        [ "$n" -ge "${ST_REC_C[$i]}" ] && n=$(( ${ST_REC_C[$i]} - 1 ))
        echo $(( ${ST_REC_B[$i]} + n )); return
      fi
    done
    # evicted — nearest surviving successor, then predecessor, in the old order
    local seen=0 nxt='' prv=''
    for n in $oldorder; do
      [ "$n" = "$an" ] && { seen=1; continue; }
      case "$all" in *" $n "*) ;; *) continue ;; esac
      if [ "$seen" -eq 1 ]; then nxt="$n"; break; else prv="$n"; fi
    done
    for n in "$nxt" "$prv"; do
      [ -z "$n" ] && continue
      for (( i = 0; i < ${#ST_REC_N[@]}; i++ )); do
        [ "${ST_REC_N[$i]}" = "$n" ] && { echo "${ST_REC_B[$i]}"; return; }
      done
    done
  fi
  # nothing else survived — the first record the old order didn't have
  for (( i = 0; i < ${#ST_REC_N[@]}; i++ )); do
    n="${ST_REC_N[$i]}"
    case " $oldorder " in *" $n "*) ;; *) echo "${ST_REC_B[$i]}"; return ;; esac
  done
  echo 0
}

anchor_update() { # -> ANCHOR_N/ANCHOR_D/ANCHOR_C covering ST_VOFF in the current
                  # build — the re-anchor identity for the next refresh/resize.
                  # ST_VOFF 0 keeps the top-following no-anchor state; a voff on
                  # the cap row anchors the last record's final line.
  ANCHOR_N=''; ANCHOR_D=0; ANCHOR_C=0
  [ "$ST_VOFF" -le 0 ] && return 0
  local i ai=-1
  for (( i = 0; i < ${#ST_REC_N[@]}; i++ )); do
    if [ "${ST_REC_B[$i]}" -le "$ST_VOFF" ]; then ai=$i; else break; fi
  done
  [ "$ai" -ge 0 ] || return 0
  ANCHOR_N="${ST_REC_N[$ai]}"
  ANCHOR_D=$(( ST_VOFF - ${ST_REC_B[$ai]} ))
  [ "$ANCHOR_D" -ge "${ST_REC_C[$ai]}" ] && ANCHOR_D=$(( ${ST_REC_C[$ai]} - 1 ))
  ANCHOR_C="${ST_REC_C[$ai]}"
}

key_nav() { # KEY -> applies one navigation key to the caller's voff/hoff (bash
            # dynamic scope); rc 0 = a navigation key, 1 = anything else.
            # Bounds come from ST_VREG/ST_MAXVOFF/ST_MAXHOFF — status_view
            # re-clamps at paint time, so out-of-range stops are harmless
  case "$1" in
    up)    voff=$(( voff - 1 )) ;;
    down)  voff=$(( voff + 1 )) ;;
    left)  hoff=$(( hoff - 1 )) ;;
    right) hoff=$(( hoff + 1 )) ;;
    pgup)  voff=$(( voff - (ST_VREG > 1 ? ST_VREG - 1 : 1) )) ;;
    pgdn)  voff=$(( voff + (ST_VREG > 1 ? ST_VREG - 1 : 1) )) ;;
    top)   voff=0 ;;
    bot)   voff=$ST_MAXVOFF ;;
    hmin)  hoff=0 ;;
    hmax)  hoff=$ST_MAXHOFF ;;
    *) return 1 ;;
  esac
}

status_watch() { # every -> the interactive two-axis status viewport (TTYs and
                 # terminal controls already verified). Refresh is asynchronous:
                 # status_gather runs in a single background worker that writes
                 # snap.new and publishes snap.done (the explicit transfer point);
                 # the parent loop only adopts a completed, valid snapshot — so a
                 # delayed, hung, or failing gather never blocks keys, resize,
                 # repaint, q, or a real SIGINT. The worker is bounded at
                 # PR_AGENT_GATHER_TIMEOUT seconds; expiry kills its subtree and
                 # the last good snapshot stays on screen marked stale. Before
                 # the first data lands the skeleton snapshot paints a loading
                 # frame. status_table rebuilds on adoption/resize; status_view
                 # repaints the cached build per keypress — navigation never
                 # fetches, probes, or writes state. Returns on q, EOF, or a
                 # signal; the EXIT trap kills the worker and restores the tty.
  local every="$1"
  local snap skel cols rows frame clipped clip_hint next_gather=0 watch_tmpd
  local voff=0 hoff=0 gather=1 rebuild=1 old_order='' aremode=refresh
  local last_cols='' last_rows='' every_i="${every%.*}"
  local w_pid='' w_deadline=0 w_new='' w_done='' w_rc=0 have_snap=0 last_fail=0
  local g_to live psnap
  STTY_SAVE="$(stty -g 2>/dev/null)" || return 1
  WATCH_TTY=1
  trap status_tty_restore EXIT
  # deferred signals: the trap only sets a flag — the input loop maps it onto
  # the ordinary quit path, so the kill/restore work never runs in signal
  # context (bash 3.2 re-entering wait/process-sub inside a trap segfaults)
  trap 'WATCH_SIG=1' INT TERM HUP
  trap 'WATCH_RESIZE=1' WINCH
  tput smcup 2>/dev/null || printf '\033[?1049h' # alt screen: repaints stay out of scrollback
  tput civis 2>/dev/null || true                # TERM=dumb has no civis — degrade, don't die under set -e
  stty -icanon -echo 2>/dev/null      # VMIN=1 VTIME=0; ISIG kept — ^C stays a signal
  printf '\033[2J'
  # private TMPDIR for the watch's lifetime: every mktemp downstream (the snap,
  # worker .new/.done transfer files, and gather-internal recs/act/refresh tmps)
  # lands inside, so the EXIT trap removes them all even when a signal lands
  # mid-gather
  watch_tmpd="$(mktemp -d)"; WATCH_TMPD="$watch_tmpd"; TMPDIR="$watch_tmpd"; export TMPDIR
  snap="$(mktemp)"; WATCH_SNAP="$snap"; KEYBUF=''
  w_new="$snap.new"; w_done="$snap.done"
  skel="$(mktemp)"; status_skeleton >"$skel" 2>/dev/null || : >"$skel"
  [[ "$every_i" =~ ^[0-9]+$ ]] || every_i=5   # garbage interval -> the -w default
  every_i=$((10#$every_i))                    # digits only, or 008 trips octal math
  [ "$every_i" -lt 1 ] && every_i=1
  g_to="${PR_AGENT_GATHER_TIMEOUT:-60}"       # worker bound — env-tunable, not a
  [[ "$g_to" =~ ^[0-9]+$ ]] || g_to=60; g_to=$((10#$g_to)); [ "$g_to" -lt 1 ] && g_to=60
  # safe ST_* defaults so status_view can paint an empty frame even when no
  # snapshot (or skeleton) has ever built (e.g. jq unusable — q must still work)
  ST_HEAD=() ST_TAIL=() ST_TBL=() ST_FOOT='' ST_MODE=empty ST_GUTTER=0
  ST_VREG=0 ST_MAXVOFF=0 ST_MAXHOFF=0 ST_VOFF=0 ST_HOFF=0
  while true; do
    # refresh deadline -> spawn the one allowed worker (snap.new + snap.done is
    # the transfer mechanism: nothing reads the new snapshot before .done lands)
    if [ "$gather" -eq 1 ] && [ -z "$w_pid" ]; then
      rm -f "$w_new" "$w_done"
      ( set +e
        status_gather 30 >"$w_new" 2>/dev/null
        echo "$?" >"$w_done.tmp"; mv -f "$w_done.tmp" "$w_done" 2>/dev/null || true
      ) </dev/null &
      w_pid=$!; WATCH_WORKER="$w_pid"
      w_deadline=$(( $(date +%s) + g_to ))
      next_gather=$(( $(date +%s) + every_i ))
      gather=0; rebuild=1                    # repaint now: footer flips to refreshing
    fi
    # adopt a completed snapshot, or bound out a worker that overran its deadline
    if [ -n "$w_pid" ] && [ -f "$w_done" ]; then
      w_rc="$(cat "$w_done" 2>/dev/null || echo 1)"; rm -f "$w_done"
      wait "$w_pid" 2>/dev/null || true; w_pid=''; WATCH_WORKER=''
      old_order="${ST_REC_N[*]-}"            # the order the user last saw — the
      if [ "$w_rc" = "0" ] && [ -s "$w_new" ] && snapshot_valid "$w_new"; then
        mv -f "$w_new" "$snap"               # eviction fallback walks it on refresh
        have_snap=1; last_fail=0
      else
        rm -f "$w_new"; last_fail="$(date +%s)"
      fi
      next_gather=$(( $(date +%s) + every_i )); rebuild=1; aremode=refresh
    elif [ -n "$w_pid" ] && [ "$(date +%s)" -ge "$w_deadline" ]; then
      worker_kill "$w_pid"; w_pid=''; WATCH_WORKER=''
      rm -f "$w_new" "$w_done"; last_fail="$(date +%s)"
      next_gather=$(( $(date +%s) + every_i )); rebuild=1
    fi
    cols="$(term_cols)"; rows="$(term_lines)"
    if [ "$WATCH_RESIZE" = "1" ]; then WATCH_RESIZE=0; rebuild=1; aremode=resize
    elif [ "$cols" != "$last_cols" ] || [ "$rows" != "$last_rows" ]; then
      [ -n "$last_cols" ] && { rebuild=1; aremode=resize; }   # WINCH missed — geometry moved
    fi
    last_cols="$cols"; last_rows="$rows"
    # the refresh-state word for the footer: skeleton until first data, then
    # live/refreshing/stale as workers land, run, and miss
    if [ "$have_snap" -eq 0 ]; then
      [ "$last_fail" -gt 0 ] && live=retry || live=loading
    elif [ -n "$w_pid" ]; then live=refreshing
    elif [ "$last_fail" -gt 0 ]; then live=stale
    else live=live; fi
    if [ "$rebuild" -eq 1 ]; then
      psnap=''
      [ "$have_snap" -eq 1 ] && psnap="$snap"
      [ -z "$psnap" ] && [ -s "$skel" ] && snapshot_valid "$skel" && psnap="$skel"
      if [ -n "$psnap" ]; then
        status_table "$psnap" "$cols" "$rows" "$every_i" "$live"
        voff="$(status_anchor "$ANCHOR_N" "$ANCHOR_D" "$([ "$aremode" = resize ] && echo "$ANCHOR_C" || echo 0)" "$old_order" "$voff")"
      fi
      rebuild=0
    fi
    # status_view runs in $() — its ST_HOFF/ST_VOFF clamps die in the subshell,
    # so the watch clamps the locals itself and republishes the applied values
    # (anchor_update and any later meta read ST_VOFF for the visible window)
    [ "$hoff" -lt 0 ] 2>/dev/null && hoff=0
    [ "$hoff" -gt "${ST_MAXHOFF:-0}" ] 2>/dev/null && hoff=${ST_MAXHOFF:-0}
    [ "$voff" -lt 0 ] 2>/dev/null && voff=0
    [ "$voff" -gt "${ST_MAXVOFF:-0}" ] 2>/dev/null && voff=${ST_MAXVOFF:-0}
    frame="$(status_view "$cols" "$every_i" "$hoff" "$voff")"
    ST_HOFF="$hoff"; ST_VOFF="$voff"; anchor_update
    clipped="$(printf '%s\n' "$frame" | cell_ops clip -v cols="$cols" -v rows="$rows")"
    if [[ "$clipped" == *$'\x02'* ]]; then
      clip_hint="make the terminal taller"
      [ "$TABLE_ROWS" -gt 0 ] && clip_hint="lower TABLE_ROWS or make the terminal taller"
      frame="${clipped%%$'\x02'*}"
      frame+="$(trunc "${C_DIM}… ${clipped##*$'\x02'} more lines — ${clip_hint}${C_RESET}" "$cols")"
    else frame="$clipped"; fi
    printf '\033[H%s\033[0m\033[J' "${frame//$'\n'/$'\033[K\n'}"
    while true; do                        # input phase: keys until a repaint,
      status_key                          # resize, worker completion/bound, or
      [ "${WATCH_SIG:-0}" = "1" ] && KEY=quit   # refresh deadline breaks the phase
      case "$KEY" in eof|quit)            # a caught signal quits like q — worker
        [ -n "$w_pid" ] && { worker_kill "$w_pid"; w_pid=''; WATCH_WORKER=''; }
        rm -f "$snap"; return 0 ;; esac   # killed + tty restored, never in a trap
      # apply the key's offset move first so an event break can't swallow it;
      # then worker events and the absolute refresh deadline break BEFORE a
      # plain nav repaint — a sustained key stream must not postpone them
      local nav=0
      key_nav "$KEY" && nav=1
      [ "${WATCH_RESIZE:-0}" = "1" ] && break
      [ -n "$w_pid" ] && [ -f "$w_done" ] && break        # adopt on the next pass
      [ -n "$w_pid" ] && [ "$(date +%s)" -ge "$w_deadline" ] && break
      # deadline breaks only when no worker is out — otherwise this check would
      # fire every pass while a slow gather runs, spinning the repaint loop
      [ -z "$w_pid" ] && [ "$(date +%s)" -ge "$next_gather" ] && { gather=1; break; }
      # nav key → repaint; queued repeats surface on the next iterations —
      # a pending byte makes read -n1 return instantly, so bursts process
      # at full speed without a poll primitive (bash 3.2 has none)
      [ "$nav" -eq 1 ] && break
    done
  done
}

render_status() { # ttl [term-rows [watch-every]] -> status screen: gather (side effects) → snapshot → pure layout
  if ! need_repo 2>/dev/null; then
    printf '%s\n' "${C_BOLD}${C_BLUE}pr-agent${C_RESET}  ${C_DIM}○ never started for this repo${C_RESET}" \
      "cd into a repo and run ${C_BOLD}pr-agent on${C_RESET}"
    return 0
  fi
  local snap rc=0
  snap="$(mktemp)"
  status_gather "$1" >"$snap" || rc=$?
  if [ "$rc" -eq 0 ]; then status_layout "$snap" "${COLS:-$(term_cols)}" "${2:-}" "${3:-}" || rc=$?; fi
  rm -f "$snap"
  return "$rc"
}

cmd_status() {
  setup_colors
  case "${1:-}" in
    -w|--watch)
      apply_status_defaults watch
      local every="${2:-5}"
      if status_interactive && need_repo 2>/dev/null; then
        status_watch "$every"
      else
        # one readable noninteractive snapshot — no cursor-control bytes, no key
        # waits. Covers redirected streams, missing controls, unwatched repos
        COLS="$(term_cols)"; render_status 30
      fi ;;
    *) COLS="$(term_cols)"; apply_status_defaults plain; render_status 0 ;;
  esac
}

usage() { sed -n '2,/^$/p' "$SELF" | sed -e '/^set /d' -e 's/^# \{0,1\}//'; exit "${1:-1}"; }

# --- dispatch ---------------------------------------------------------------------------

# OMZ-style release check: refresh the record in the background; the notice lands on a
# later run. Internal/machine-readable commands skip it; the watcher logs it instead.
maybe_update_check
case "${1:-}" in
  _loop)  if upd="$(pending_update_version)"; then
            log "pr-agent v$upd released upstream — 'pr-agent update' installs it"
          fi ;;
  _check|_tell|map|peek|config|status|st|version|update|help|-h|--help|--version|-v|_gather|_layout) ;;
  *)      if [ -t 1 ] && upd="$(pending_update_version)"; then
            printf '%s\n' "${C_DIM:-}→ pr-agent v$upd available — run 'pr-agent update'${C_RESET:-}"
          fi ;;
esac

case "${1:-}" in
  on)        shift; cmd_on "$@" ;;
  off)       shift; cmd_off "$@" ;;
  status|st) shift; cmd_status "$@" ;;
  logs)      shift; cmd_logs "$@" ;;
  add)
    shift; need_repo
    t="$(cat "$STATE_DIR/targets" 2>/dev/null || echo all)"
    [ "$t" != "all" ] || die "watching $(scope_label) — nothing to add (use 'pr-agent on N...' for an explicit list)"
    for n in "$@"; do need_real_pr "$n"; done
    echo "$t $*" | tr ' ' '\n' | { grep -E '^[0-9]+$' || true; } | sort -un | tr '\n' ' ' | sed 's/ $//' >"$STATE_DIR/targets"
    echo "targets: $(cat "$STATE_DIR/targets")" ;;
  rm)
    shift; need_repo
    t="$(cat "$STATE_DIR/targets" 2>/dev/null || echo all)"
    [ "$t" != "all" ] || die "watching $(scope_label) — use 'pr-agent pause N' to skip one"
    echo "$t" | tr ' ' '\n' | awk -v drop=" $* " 'NF && index(drop, " " $1 " ") == 0' | tr '\n' ' ' | sed 's/ $//' >"$STATE_DIR/targets"
    echo "targets: $(cat "$STATE_DIR/targets")" ;;
  run)       shift; need_repo; map_init; cmd_run "$@" ;;
  tell)      shift; need_repo; map_init; cmd_tell "$@" ;;
  _tell)     shift; _tell "$@" ;;
  _check)    shift; need_repo; map_init; refresh_prs 0; check_pr "$1" "" "" "${2:-watch}" ;;
  _ensure)   shift; need_repo; map_init; ensure_worktree "$@" ;;   # internal — test/smoke.sh drives these
  _blocked)  shift; need_repo; still_blocked "$@" ;;               # internal — rc 0 blocked / 1 free / 2 indeterminate
  _gather)   shift; need_repo; status_gather "${1:-0}" ;;          # internal — prints the status snapshot (JSON)
  _layout)   shift; [ -f "${1:-}" ] || die "usage: pr-agent _layout SNAPSHOT [COLS [ROWS [EVERY [META_OUT [HOFF [VOFF [LIVE]]]]]]]"
             setup_colors; status_layout "$1" "${2:-$(term_cols)}" "${3:-}" "${4:-}" "${5:-}" "${6:-0}" "${7:-0}" "${8:-}" ;;
  attach)    shift; need_repo; cmd_attach "$@" ;;
  peek)      shift; cmd_peek "$@" ;;
  mark-seen) shift; cmd_mark_seen "$@" ;;
  pause)     shift; need_real_pr "${1:-}"; map_set "$1" paused 1; log "PR #$1: paused" >/dev/null; echo "PR #$1: paused — no automatic runs until 'pr-agent resume $1'" ;;
  resume)    shift; need_real_pr "${1:-}"; map_del "$1" paused; map_del "$1" skip_logged; log "PR #$1: resumed" >/dev/null; echo "PR #$1: resumed" ;;
  retry)     shift; cmd_retry "$@" ;;
  reset)     shift; need_real_pr "${1:-}"
             map_del "$1" session_id; map_set "$1" fail_count 0; map_del "$1" gave_up
             map_del "$1" retry_count; map_del "$1" retry_gave_up; map_del "$1" retry_skip_logged; map_del "$1" retry_last_ping_ts
             map_del "$1" sync_pending; map_del "$1" sync_blocked; map_del "$1" sync_blocked_key
             map_del "$1" sync_done_key; map_del "$1" sync_fail_key; map_set "$1" sync_fails 0; map_del "$1" sync_unblock
             map_del "$1" worktree_blocked; map_del "$1" blocked_logged
             echo "PR #$1: session forgotten — the next round starts a fresh agent session" ;;
  reset-rounds) shift; need_real_pr "${1:-}"
             map_del "$1" rounds; map_del "$1" skip_logged
             echo "PR #$1: round counter reset — auto-runs resume at the next cycle" ;;
  gc)        shift; cmd_gc "$@" ;;
  sync)      shift; cmd_sync "$@" ;;
  config)    cmd_config ;;
  map)       map_init; jq . "$MAP_FILE" ;;
  version|--version|-v) echo "pr-agent $VERSION" ;;
  update)    shift; cmd_update "$@" ;;
  _loop)     need_repo; watch_loop ;;
  help|-h|--help) usage 0 ;;
  *)         usage ;;
esac
