               tput lines 2>/dev/null || echo 24; }

cell_ops() { # mode [-v k=v]… — one LC_ALL=C awk engine for display-cell ops on stdin lines.
             # Bytes are decoded as UTF-8 → codepoints, classified wcwidth-style
             # (combining/control 0, East-Asian wide/fullwidth + emoji 2, else 1);
             # ANSI escapes (\033[…letter) pass through uncounted. No runtime deps
             # beyond awk — bash ${#var} is char count, not display width.
             # modes: len → per-line cell width · max → per-tag max width of "tag\ttext"
             #   lines · ws → per-line space-separated per-char widths · cut → text
             #   clipped to w cells (a straddling wide char emits as a space) ·
             #   trunc → whole line if ≤w cells else w-1 cells + '…' · proj → frozen
             #   [0,gutter) prefix + horizontal window [gutter+off, gutter+off+cols-
             #   gutter): content emits into cols-1 and a clipped line's own last
             #   glyph (its border char) is pinned at the last cell, C_RESET-
             #   terminated · clip → emit lines while cumulative
             #   soft-wrap phys ≤ rows-1, then a \x02<remaining> sentinel line
  local mode="$1"; shift
  LC_ALL=C awk -v mode="$mode" -v w=0 -v gutter=0 -v cols=0 -v off=0 -v rows=0 -v needle='' "$@" '
    BEGIN { for (i = 1; i < 256; i++) B[sprintf("%c", i)] = i }
    function wof(cp) {   # codepoint -> display cells (0 combining/control, 2 wide, else 1)
      if (cp < 32 || cp == 127) return 0
      # NOTE: decimal only — BSD awk does not parse 0xNNN literals
      if ((cp >= 768   && cp <= 879)   || (cp >= 1155  && cp <= 1161)  ||
          (cp >= 1425  && cp <= 1469)  || cp == 1471 || (cp >= 1473 && cp <= 1477) ||
          cp == 1479 || (cp >= 1552  && cp <= 1562)  || (cp >= 1611 && cp <= 1631) ||
          cp == 1648 || (cp >= 1750  && cp <= 1788)  || (cp >= 1759 && cp <= 1768) ||
          (cp >= 1770  && cp <= 1773)  || (cp >= 6832  && cp <= 6911)  ||
          (cp >= 7616  && cp <= 7679)  || (cp >= 8400  && cp <= 8432)  ||
          cp == 8203 || cp == 8205 || (cp >= 65024 && cp <= 65039) ||
          (cp >= 65056 && cp <= 65071) || (cp >= 917760 && cp <= 917999)) return 0
      if ((cp >= 4352   && cp <= 4447)   || cp == 9001 || cp == 9002 ||
          (cp >= 11904  && cp <= 12350)  || (cp >= 12353  && cp <= 13311)  ||
          (cp >= 13312  && cp <= 19903)  || (cp >= 19968  && cp <= 40959)  ||
          (cp >= 40960  && cp <= 42191)  || (cp >= 43360  && cp <= 43391)  ||
          (cp >= 44032  && cp <= 55203)  || (cp >= 63744  && cp <= 64255)  ||
          (cp >= 65040  && cp <= 65049)  || (cp >= 65072  && cp <= 65131)  ||
          (cp >= 65280  && cp <= 65376)  || (cp >= 65504  && cp <= 65510)  ||
          (cp >= 94176  && cp <= 94180)  || (cp >= 94208  && cp <= 101119) ||
          (cp >= 110592 && cp <= 110930) || (cp >= 110960 && cp <= 111355) ||
          (cp >= 127488 && cp <= 127743) || (cp >= 127744 && cp <= 129791) ||
          (cp >= 131072 && cp <= 173791) || (cp >= 173824 && cp <= 191471) ||
          (cp >= 194560 && cp <= 195103) || (cp >= 196608 && cp <= 201551)) return 2
      return 1
    }
    function esc(s, i, j) {   # index after an ANSI sequence starting at byte i (\033[..letter)
      j = i + 1; n = length(s)
      if (substr(s, j, 1) == "[") { j++; while (j <= n && substr(s, j, 1) !~ /[A-Za-z]/) j++ }
      return j + 1
    }
    function dec(s, i, b) {   # byte offset -> globals CP (codepoint) + NB (byte length)
      b = B[substr(s, i, 1)]
      if (b < 128)      { CP = b; NB = 1 }
      else if (b < 224) { CP = (b - 192) * 64 + B[substr(s, i + 1, 1)] - 128; NB = 2 }
      else if (b < 240) { CP = (b - 224) * 4096 + (B[substr(s, i + 1, 1)] - 128) * 64 + B[substr(s, i + 2, 1)] - 128; NB = 3 }
      else              { CP = (b - 240) * 262144 + (B[substr(s, i + 1, 1)] - 128) * 4096 + (B[substr(s, i + 2, 1)] - 128) * 64 + B[substr(s, i + 3, 1)] - 128; NB = 4 }
    }
    {
      if (mode == "max") {                       # "tag<TAB>text" -> per-tag max cell width
        t = index($0, "\t"); tag = substr($0, 1, t - 1); txt = substr($0, t + 1)
        total = 0; n = length(txt); i = 1
        while (i <= n) {
          if (B[substr(txt, i, 1)] == 27) { i = esc(txt, i); continue }
          dec(txt, i); total += wof(CP); i += NB
        }
        if (!(tag in mx) || total > mx[tag]) mx[tag] = total
        next
      }
      if (mode == "trunc") {                     # whole line fits -> verbatim; else cut + …
        total = 0; n = length($0); i = 1
        while (i <= n) {
          if (B[substr($0, i, 1)] == 27) { i = esc($0, i); continue }
          dec($0, i); total += wof(CP); i += NB
        }
        if (total <= w) { print $0; next }
        w = w - 1                                # fall into cut at w-1, then add …
      }
      n = length($0); i = 1; total = 0; out = ""; wlist = ""; emitted = 0; p = 0; projfull = 0; tailg = ""
      while (i <= n) {
        b = B[substr($0, i, 1)]
        if (b == 27) { j = esc($0, i); if (mode != "len" && mode != "clip" && mode != "ws") out = out substr($0, i, j - i); i = j; continue }
        dec($0, i); cw = wof(CP); ch = substr($0, i, NB); i += NB
        if (mode == "len" || mode == "clip") { total += cw; continue }
        if (mode == "ws") { wlist = wlist (wlist == "" ? "" : " ") cw; continue }
        if (mode == "cut" || mode == "trunc") {
          if (cw > w - total) { if (total < w) out = out " "; break }   # straddling wide char -> pad the leftover cell only
          out = out ch; total += cw
          if (total >= w) break
          continue
        }
        # proj: frozen prefix [0,gutter) always emits; window cells [gutter+off,…).
        # Content emits into cols-1 — when the window cuts the line off, the last
        # cell carries its own trailing border glyph (│/┐/┤/┘) so the
        # projected box keeps its physical right edge
        if (mode == "proj") {
          if (p < gutter || p >= gutter + off) {
            if (!projfull && emitted + cw <= cols - 1) { out = out ch; emitted += cw }
            else if (!projfull) { if (emitted < cols - 1) { out = out " "; emitted += 1 } projfull = 1 }
          }
          if (cw > 0) tailg = ch      # last display glyph — the physical border char
        }
        if (mode == "pos" && ch == needle) plist = plist (plist == "" ? "" : " ") p
        p += cw
      }
      if (mode == "len") print total
      else if (mode == "ws") print wlist
      else if (mode == "pos") print plist
      else if (mode == "cut") print out
      else if (mode == "trunc") print out "…"
      else if (mode == "clip") { cum += (total > 0 ? int((total + cols - 1) / cols) : 1)
                                 if (!full && cum <= rows - 1) { print $0; kept = cum }
                                 else full = 1 }
      else if (mode == "proj") { if (projfull && tailg != "") out = out tailg
                                 print out sprintf("%c", 27) "[0m" }
    }
    END { if (mode == "max") for (t in mx) print t "\t" mx[t]
          if (mode == "len" && NR == 0) print 0
          if (mode == "clip" && full) printf "%c%d\n", 2, cum - kept }
  '
}

cell_len() { # text -> display cells (ANSI-transparent; wcwidth-style, not ${#var})
  printf '%s' "$1" | cell_ops len
}

trunc() { # text width -> text cut to width cells, ending in … when cut
  printf '%s' "$1" | cell_ops trunc -v w="$2"
}

padw() { # text colw curw -> content + spaces to colw cells (curw ≤ colw; clamps at 0)
  local n=$(( $2 - $3 )); [ "$n" -lt 0 ] && n=0
  printf '%s%*s' "$1" "$n" ''
}

pad() { # text width -> text truncated/right-padded to exactly width cells
  local s; s="$(trunc "$1" "$2")"
  printf '%s%*s' "$s" "$(( $2 - $(cell_len "$s") ))" ''
}

rep() { # char count -> char repeated count times
  local out='' i
  for (( i = 0; i < $2; i++ )); do out+="$1"; done
  printf '%s' "$out"
}

vis_len() { # text -> display cells (ANSI-transparent); counts like pad/wrap do
  printf '%s' "$1" | cell_ops len
}

phys_lines() { # text width -> physical lines the text occupies on the terminal (soft wrap; min 1)
  local n w="$2"
  [ "$w" -gt 0 ] 2>/dev/null || w=1
  n="$(vis_len "$1")"
  printf '%s' "$(( n > 0 ? (n + w - 1) / w : 1 ))"
}

wrap() { # text width max -> WRAP_LINES: greedy word wrap at one logical width (cells);
         # a word wider than the line hard-splits cell-wise (a straddling wide char
         # moves to the next line); over max folds the rest into a …-ended last line
         # (max 0 = no cap). WRAP_FULL = uncapped line count, WRAP_W = per-line cell
         # widths. width floors at 1 — ≤0 would loop forever
  local s w max line='' linew=0 word wordw i base ci=0 take tw rest; local -a out=() outw=() wcs=()
  local LC_ALL=en_US.UTF-8   # ${#}/${var:i:j} must count codepoints — wcs[] is indexed by them
  s="$(printf '%s' "$1" | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//')"
  w="$2"; max="${3:-0}"; [ "$w" -gt 0 ] || w=1
  if [ -n "$s" ]; then
    local wlist; wlist="$(printf '%s' "$s" | cell_ops ws)"
    wcs=( $wlist )   # digits only — word-split is the intended parse
  fi
  while [ -n "$s" ]; do
    word="${s%% *}"
    wordw=0; for (( i = 0; i < ${#word}; i++ )); do wordw=$(( wordw + ${wcs[ci+i]:-0} )); done
    base=$ci; ci=$(( ci + ${#word} + 1 ))   # +1: the separator char consumed below
    if [ "$word" = "$s" ]; then s=''; else s="${s#* }"; fi
    while [ "$wordw" -gt "$w" ]; do   # too wide: flush pending line, then chunk cell-wise
      if [ -n "$line" ]; then out+=( "$line" ); outw+=( "$linew" ); line=''; linew=0; fi
      take=0; tw=0
      while [ $(( base + take )) -lt $(( ci - 1 )) ] && [ $(( tw + ${wcs[base+take]:-0} )) -le "$w" ]; do
        tw=$(( tw + wcs[base+take] )); take=$(( take + 1 ))
      done
      [ "$take" -eq 0 ] && { take=1; tw=${wcs[base]:-1}; }   # always progress — a 2-cell
      out+=( "${word:0:$take}" ); outw+=( "$tw" )            # char at w=1 overflows but can't loop
      word="${word:$take}"; base=$(( base + take ))
      wordw=0; for (( i = 0; i < ${#word}; i++ )); do wordw=$(( wordw + ${wcs[base+i]:-0} )); done
    done
    if [ -z "$line" ]; then line="$word"; linew=$wordw
    elif [ $(( linew + 1 + wordw )) -le "$w" ]; then line+=" $word"; linew=$(( linew + 1 + wordw ))
    else out+=( "$line" ); outw+=( "$linew" ); line="$word"; linew=$wordw; fi
  done
  [ -n "$line" ] && { out+=( "$line" ); outw+=( "$linew" ); }
  [ "${#out[@]}" -eq 0 ] && { out+=( '' ); outw+=( 0 ); }
  WRAP_FULL=${#out[@]}
  if [ "$max" -gt 0 ] && [ "${#out[@]}" -gt "$max" ]; then
    rest="${out[$(( max - 1 ))]}"
    for (( i = max; i < ${#out[@]}; i++ )); do rest+=" ${out[$i]}"; done
    rest="$(trunc "$rest" "$w")"; [ "$(cell_len "$rest")" -lt "$w" ] && rest+="…"
    out=( "${out[@]:0:$(( max - 1 ))}" "$rest" )
    outw=( "${outw[@]:0:$(( max - 1 ))}" "$(cell_len "$rest")" )
  fi
  WRAP_LINES=( "${out[@]}" )
  WRAP_W=( "${outw[@]}" )
}

title_disp() { # raw title -> display title (conventional-commit prefix stripped, ? when empty)
  printf '%s' "${1:-?}" | sed -E 's/^[a-z]+(\([^)]*\))?!?: //'
}

fmt_rel() { # epoch -> "just now" / "4m ago" / "3h ago" / "2d ago" (empty -> —); relative to $SNOW when set
  [ -z "$1" ] && { echo "—"; return; }
  local s=$(( ${SNOW:-$(date +%s)} - $1 ))
  if [ "$s" -lt 60 ]; then echo "just now"
  elif [ "$s" -lt 3600 ]; then echo "$((s/60))m ago"
  elif [ "$s" -lt 86400 ]; then echo "$((s/3600))h ago"
  else echo "$((s/86400))d ago"; fi
}

fmt_dur() { # seconds -> "2m" for whole minutes, else fmt_ago style
  if [ "$1" -ge 60 ] && [ $(( $1 % 60 )) -eq 0 ]; then echo "$(( $1 / 60 ))m"; else fmt_ago "$1"; fi
}

hash_list() { echo "$1" | sed -E 's/([0-9]+)/#\1/g; s/^ +//; s/ +$//; s/ +/, /g'; }
first_of() { echo $1 | cut -d' ' -f1; }

# Cells are `␣content␣│` — one space reserved on both sides; a column of width w
# occupies w+3 cells in rules/rows and the width formula is Σ COL_W + 3n + 1.

draw_rule() { # left mid right -> horizontal border sized to COL_W
  local out="$1" i n=${#COL_W[@]}
  for (( i = 0; i < n; i++ )); do
    out+="$(rep ─ $(( COL_W[i] + 2 )))"
    if [ "$i" -lt $(( n - 1 )) ]; then out+="$2"; else out+="$3"; fi
  done
  printf '%s%s%s\n' "$C_DIM" "$out" "$C_RESET"
}

draw_row() { # text1 style1 curw1 text2 style2 curw2 ... -> bordered row; curw is the
             # text's measured cell width (caller guarantees it fits COL_W[i])
  local out="${C_DIM}│${C_RESET}" i=0
  while [ $# -gt 0 ]; do
    out+=" $2$(padw "$1" "${COL_W[i]}" "$3")$C_RESET ${C_DIM}│${C_RESET}"
    shift 3; i=$(( i + 1 ))
  done
  printf '%s\n' "$out"
}

draw_span() { # text style span curw -> one row: blank PR cell + a single cell spanning
              # TITLE..last at span cells (the "… N more" cap row)
  printf '%s\n' "${C_DIM}│${C_RESET} $(padw '' "${COL_W[0]}" 0) ${C_DIM}│${C_RESET} $2$(padw "$1" "$3" "$4")$C_RESET ${C_DIM}│${C_RESET}"
}

status_prs() { # -> PR numbers shown in status, most recent activity first: watch targets ∪ agent history
  local want map f; local -a files=()
  want="$( { targets | tr ' ' '\n'; jq -r '.prs | keys[]' "$MAP_FILE" 2>/dev/null || true; } \
           | { grep -E '^[0-9]+$' || true; } | sort -un )"
  [ -n "$want" ] || return 0
  for f in "$PRS_EXTRA" "$PRS_CACHE"; do [ -f "$f" ] && files+=( "$f" ); done
  map="$(cat "$MAP_FILE" 2>/dev/null)"; [ -n "$map" ] || map='{}'
  { [ "${#files[@]}" -gt 0 ] && cat "${files[@]}" || true; } | jq -rs \
    --arg want "$want" --argjson map "$map" '
    (map({key: (.number | tostring), value: .updated}) | from_entries) as $upd
    | ($map.prs // {}) as $m
    | [ $want | split("\n")[] | select(length > 0) | tonumber ]
    | map(. as $n | ($n | tostring) as $k
        | { n: $n,
            t: ([ $upd[$k], $m[$k].last_seen_ts,
                  ($m[$k].last_run_at | tonumber? | todate?) ]
                | map(select(. != null)) | max // "") })
    | sort_by(.t) | reverse | .[].n'
}

worker_tree() { # pid -> live descendants of pid, deepest first (pgrep -P walk).
                # Collect while the worker still parents them — once it dies the
                # children reparent to launchd and become invisible to -P.
  local c
  for c in $(pgrep -P "$1" 2>/dev/null || true); do
    worker_tree "$c"; echo "$c"
  done
  return 0
}

worker_kill() { # pid -> cancel a dashboard-owned worker subtree and reap the
                # worker: collect descendants first (the worker still anchors
                # them), TERM the lot, resweep for anything forked mid-kill,
                # then wait. Only pids collected while parented to the worker
                # are touched — never watcher/agent processes.
  local p="$1" kids i
  for i in 1 2; do
    kids="$(worker_tree "$p")"
    [ -n "$kids" ] && kill -TERM $kids 2>/dev/null || true
    kill -TERM "$p" 2>/dev/null || true
  done
  kids="$(worker_tree "$p")"
  [ -n "$kids" ] && kill -KILL $kids 2>/dev/null || true
  wait "$p" 2>/dev/null || true
  return 0
}

run_bounded() { # secs cmd... -> run cmd as a background child bounded at secs;
                # rc = the command's rc, 124 when the deadline TERM'd its
                # subtree. BSD-safe — sleep+kill+wait, no GNU timeout needed.
                # The killer's fds are detached: it must never inherit a
                # command-substitution capture pipe — a held-open pipe blocks
                # the caller's read, and its orphaned sleep would leak it for
                # the full bound.
  local secs="$1" pid rc=0 killer; shift
  "$@" & pid=$!
  ( sleep "$secs"; worker_kill "$pid" ) </dev/null >&- 2>&- &
  killer=$!
  wait "$pid" 2>/dev/null || rc=$?    # || — a TERM'd bound-out command returns
  worker_kill "$killer"   # reaps the sleeper too — a bare kill orphans it mid-sleep
                          # >128 and set -e must not abort the caller on it
  [ "$rc" -gt 128 ] && return 124
  return "$rc"
}

snapshot_valid() { # file -> 0 when the snapshot is complete enough to paint —
                   # the gate every stage transition uses so a partial snapshot
                   # is never published or laid out.
  jq -e '(.v == 1) and (.now | type == "number") and (.repo | type == "string")
         and (.watcher | type == "object") and (.cfg | type == "object")
         and (.prs | type == "array") and (.activity | type == "array")' \
    "$1" >/dev/null 2>&1
}

status_pending_count() { # pr -> unprocessed-feedback count as status reports it — never creates or
                         # rewrites seen/<pr> (the watcher owns those): when the marker is absent
                         # the legacy last_seen_ts cutoff is applied in memory, exactly the keys
                         # seed_seen would have written
  local pr="$1" all seen cutoff n=0
  all="$(mktemp)"
  if fetch_feedback "$pr" >"$all" 2>/dev/null; then
    seen="$STATE_DIR/seen/$pr"
    if [ ! -f "$seen" ]; then
      seen="$(mktemp)"
      cutoff="$(map_get "$pr" last_seen_ts)"
      if [ -n "$cutoff" ]; then jq -r --arg c "$cutoff" 'select(.ts <= $c) | .key' "$all" >"$seen"; fi
    fi
    n="$(filter_feedback "$pr" "$all" "$seen" | wc -l | tr -d ' ')"
    if [ "$seen" != "$STATE_DIR/seen/$pr" ]; then rm -f "$seen"; fi
  fi
  rm -f "$all"
  echo "${n:-0}"
}

refresh_status_pending() { # ttl -> recount unprocessed feedback per open PR unless younger than ttl.
                           # Each PR's three-endpoint fetch runs under run_bounded: a PR
                           # that can't finish inside PR_AGENT_PENDING_TIMEOUT seconds
                           # keeps its prior count line, so one stalled endpoint can't
                           # hold the whole phase hostage; the file still publishes
                           # atomically (tmp+mv) — a killed phase keeps the old counts.
                           # status_pending.ts stamps only a fully-recounted rebuild:
                           # a bound-out republishes a carried count behind a fresh
                           # mtime, so mtime can't measure data freshness — the stamp
                           # stays behind and the footer's age note can still fire.
  if [ -f "$STATUS_PENDING" ] && [ $(( $(date +%s) - $(stat -f %m "$STATUS_PENDING") )) -lt "$1" ]; then return 0; fi
  local tmp pr n bound full=1; tmp="$(mktemp)"
  bound="${PR_AGENT_PENDING_TIMEOUT:-15}"
  [[ "$bound" =~ ^[0-9]+$ ]] || bound=15; bound=$((10#$bound)); [ "$bound" -lt 1 ] && bound=15
  for pr in $(status_prs); do
    [ "$(pr_info "$pr" state)" = "CLOSED" ] || [ "$(pr_info "$pr" state)" = "MERGED" ] && continue
    if ! n="$(run_bounded "$bound" status_pending_count "$pr")"; then
      n="$(awk -v n="$pr" '$1 == n { print $2; exit }' "$STATUS_PENDING" 2>/dev/null)"   # prior count stands
      full=0
    fi
    echo "$pr ${n:-0}" >>"$tmp"
  done
  mv "$tmp" "$STATUS_PENDING"
  if [ "$full" -eq 1 ]; then date +%s >"$STATUS_PENDING_TS" 2>/dev/null || true; fi
}

sessions_db_path() { # -> the Devin CLI sessions index the MODEL column reads
  echo "${PR_AGENT_SESSIONS_DB:-${XDG_DATA_HOME:-$HOME/.local/share}/devin/cli/sessions.db}"
}

sessions_db_ok() { # -> 0 when the sessions index is usable: sqlite3 present, the
                   # file opens read-only, and sessions.model exists (the column
                   # ships in the CLI's initial schema — the SELECT is the schema
                   # check). Probed once per process; the verdict can't change
                   # mid-collect.
  case "$SESSIONS_DB_OK" in 0) return 0;; 1) return 1;; esac
  SESSIONS_DB_OK=1
  [ -f "$(sessions_db_path)" ] || return 1
  command -v sqlite3 >/dev/null 2>&1 || return 1
  sqlite3 -readonly "$(sessions_db_path)" 'SELECT model FROM sessions LIMIT 0' \
    >/dev/null 2>&1 && SESSIONS_DB_OK=0
  [ "$SESSIONS_DB_OK" = 0 ]
}

status_model_lookup() { # pr session_id -> observed model label ('' = unknown).
                        # PR_AGENT_MODEL_LOOKUP names an external probe command
                        # (test seam). The default source is the Devin CLI's own
                        # sessions index: sessions.model is the session's
                        # *selected* model or router ('adaptive' stays 'adaptive' —
                        # never a guessed concrete LLM), matched on the exact
                        # mapped session id AND its worktree (repo dir when none
                        # is recorded) so a foreign session can't cross-associate.
                        # refresh_status_models bounds the whole phase, so a hung
                        # or failed source keeps prior evidence and can't stall
                        # records.
  local probe="${PR_AGENT_MODEL_LOOKUP:-}"
  if [ -n "$probe" ]; then "$probe" "$1" "${2:-}" 2>/dev/null || true; return 0; fi
  local mdl='' ctx ctx_real
  if [ -n "${2:-}" ] && sessions_db_ok; then
    ctx="$(map_get "$1" worktree)"; [ -n "$ctx" ] || ctx="$(repo_dir)"
    ctx_real="$(cd "$ctx" 2>/dev/null && pwd -P || true)"; ctx_real="${ctx_real:-$ctx}"
    mdl="$(sqlite3 -readonly "$(sessions_db_path)" \
      "SELECT model FROM sessions WHERE id='${2//\'/''}' AND working_directory IN ('${ctx//\'/''}','${ctx_real//\'/''}') LIMIT 1" \
      2>/dev/null | head -1 | tr -d '[:cntrl:]' || true)"
  fi
  [ -n "$mdl" ] || mdl="$(map_get "$1" model)"   # db miss → map evidence
  printf '%s\n' "$mdl"
}

status_models_collect() { # -> "pr model" lines for every record carrying a session_id
  local num sid mdl
  for num in $(status_prs); do
    sid="$(map_get "$num" session_id)"
    [ -n "$sid" ] || continue
    mdl="$(status_model_lookup "$num" "$sid")"
    [ -n "$mdl" ] && echo "$num $mdl"
  done
  return 0    # an empty list is success — the last loop's [ -n ] isn't the result
}

refresh_status_models() { # ttl -> refresh the session-model cache unless younger than
                          # ttl (status_models: "pr model" lines, published tmp+mv like
                          # the other shared caches). The whole phase is bounded at
                          # PR_AGENT_MODEL_TIMEOUT seconds — a bound-out or failed
                          # phase keeps the prior file, so a slow model source can
                          # never hold back otherwise usable PR data.
  if [ -f "$STATUS_MODELS" ] && [ $(( $(date +%s) - $(stat -f %m "$STATUS_MODELS") )) -lt "$1" ]; then return 0; fi
  local tmp bound; tmp="$(mktemp)"
  bound="${PR_AGENT_MODEL_TIMEOUT:-10}"
  [[ "$bound" =~ ^[0-9]+$ ]] || bound=10; bound=$((10#$bound)); [ "$bound" -lt 1 ] && bound=10
  if run_bounded "$bound" status_models_collect >"$tmp"; then mv "$tmp" "$STATUS_MODELS"
  else rm -f "$tmp"; fi
}

refresh_blocked_flags() { # -> still_blocked re-probe per flagged PR so a freed branch un-stales the display when the watcher is off; rc 2 (indeterminate) keeps the flag
  local pr rc
  for pr in $(jq -r '.prs | to_entries[] | select(.value.worktree_blocked == "1") | .key' "$MAP_FILE" 2>/dev/null || true); do
    rc=0; still_blocked "$pr" || rc=$?
    if [ "$rc" -eq 1 ]; then map_del "$pr" worktree_blocked; map_del "$pr" blocked_logged; map_del "$pr" sig; fi
  done
}

last_run_epoch() { # pr -> epoch of the last finished agent run (map, falling back to the log)
  local v line; v="$(map_get "$1" last_run_at)"
  if [ -z "$v" ]; then
    line="$( { grep -E "^\[[0-9: -]+\] PR #$1: (round .*done|round .*finished|agent run failed)" "$LOG_FILE" 2>/dev/null || true; } | tail -1 | cut -c2-20)"
    [ -n "$line" ] && v="$(date -j -f '%Y-%m-%d %H:%M:%S' "$line" +%s 2>/dev/null || true)"
  fi
  echo "$v"
}

# gather -> snapshot -> layout/paint:
#   status_gather ttl — the ONLY side-effecting stage; prints a versioned JSON snapshot on
#     stdout so results cross subshell/worker boundaries explicitly instead of relying on
#     command-substitution globals surviving in the parent. Side effects, all enumerated:
#       refresh_prs / backfill_prs → prs.jsonl, prs_extra.jsonl (locked merge), gh_error
#       refresh_status_pending     → status_pending + status_pending.ts (counts via
#                                    status_pending_count — no seen-marker writes;
#                                    those belong to the watcher)
#       refresh_status_models      → status_models (bounded phase; prior file kept on
#                                    bound-out — model lookups can never stall records)
#       refresh_blocked_flags      → lock-protected worktree_blocked map_dels
#       map_init                   → creates map.json when absent
#     Everything else is a read: map.json, targets, seen/, running/, locks/, watch.log,
#     pid/cycle files. Layout and painting perform none of these.
#   status_layout snap cols [rows [every [meta-out [hoff [voff]]]]] — pure: renders the
#     ANSI frame from the snapshot alone — status_table builds the logical grid into
#     ST_* parts, status_view paints one frame at hoff/voff (empty every = the whole
#     table), status_meta writes the anchor jsonl — no gh/Devin calls, no worktree
#     probes, no config/map/seen writes, so repaints and resizes may repeat it freely.
#   render_status — thin orchestrator: gather to a temp file, then lay it out.

status_gather() { # ttl -> status snapshot (JSON v1) on stdout — see the inventory above
  map_init
  refresh_prs "$1" || true
  refresh_status_pending "$1"
  refresh_status_models "$1"
  refresh_blocked_flags

  local now running=0 pid='' launchd=0 cyc=0 last_cycle=0 t watch_lbl reacts extras=''
  local gh_err=0 upd num recs act info pending marker apid started agent astarted skip lrun
  now="$(date +%s)"
  if is_running; then running=1; pid="$(cat "$PID_FILE" 2>/dev/null)"; fi
  [ -f "$LAUNCHD_PLIST" ] && launchd=1
  [ -f "$STATE_DIR/cycle_active" ] && cyc=1
  [ -f "$STATE_DIR/last_cycle" ] && last_cycle="$(cat "$STATE_DIR/last_cycle")"
  t="$(cat "$STATE_DIR/targets" 2>/dev/null || echo all)"
  if [ "$t" = "all" ] || [ -z "$t" ]; then watch_lbl="$(scope_label)"; else watch_lbl="$(hash_list "$t")"; fi
  if [ -n "$AUTHOR_FILTER" ]; then reacts="$AUTHOR_FILTER"; else reacts="humans"; [ -n "$BOTS" ] && reacts+=" + $BOTS"; fi
  [ "$SANDBOX" = "1" ] && extras+=" · sandbox"
  [ "$CI_TRIGGER" = "1" ] && extras+=" · CI"
  [ "$CONFLICT_TRIGGER" = "1" ] && extras+=" · conflicts"
  [ "$MAIN_SYNC" = "1" ] && extras+=" · main-sync"
  [ -f "$STATE_DIR/gh_error" ] && gh_err=1
  upd="$(pending_update_version || true)"

  recs="$(mktemp)"; act="$(mktemp)"
  local pts=0 mts=0 model
  if [ -f "$STATUS_PENDING" ]; then
    pts="$(cat "$STATUS_PENDING_TS" 2>/dev/null || true)"   # last full recount —
    [[ "$pts" =~ ^[0-9]+$ ]] || pts="$(stat -f %m "$STATUS_PENDING" 2>/dev/null || echo 0)"   # mtime: pre-stamp cache
  fi
  [ -f "$STATUS_MODELS" ] && mts="$(stat -f %m "$STATUS_MODELS" 2>/dev/null || echo 0)"
  for num in $(status_prs); do
    info="$(pr_info "$num")"; [ -n "$info" ] || info='{}'
    pending="$(awk -v n="$num" '$1 == n { print $2 }' "$STATUS_PENDING" 2>/dev/null || true)"
    model="$(sed -n "s/^$num //p" "$STATUS_MODELS" 2>/dev/null | head -1 || true)"
    [ -n "$model" ] || model="$(map_get "$num" model)"   # cache miss → map evidence
    agent='' astarted=0
    marker="$STATE_DIR/running/$num"
    if [ -f "$marker" ]; then
      read -r apid started _ <"$marker"
      if kill -0 "$apid" 2>/dev/null; then agent=working; astarted="${started:-0}"
      else agent=interrupted; fi
    elif [ -d "$STATE_DIR/locks/$num" ]; then agent=reading; fi
    skip="$(skip_reason "$num")"
    lrun="$(last_run_epoch "$num")"
    jq -nc --argjson n "$num" --argjson info "$info" --arg pending "${pending:-0}" \
      --arg rounds "$(map_num "$num" rounds)" --arg fail_count "$(map_num "$num" fail_count)" \
      --arg gave_up "$(map_get "$num" gave_up)" --arg retry_gave_up "$(map_get "$num" retry_gave_up)" \
      --arg worktree_blocked "$(map_get "$num" worktree_blocked)" \
      --arg sync_blocked "$(map_get "$num" sync_blocked)" --arg sync_pending "$(map_get "$num" sync_pending)" \
      --arg skip "$skip" --arg agent "$agent" --arg agent_started "$astarted" \
      --arg session_id "$(map_get "$num" session_id)" --arg last_run "$lrun" \
      --arg model "$model" \
      '{n:$n,
        state: (if ($info.state // "") == "" then "OPEN" else $info.state end),
        title: ($info.title // ""), review: ($info.review // ""), draft: ($info.draft // false),
        updated: ($info.updated // ""), pending: ($pending | tonumber? // 0),
        rounds: ($rounds | tonumber? // 0), fail_count: ($fail_count | tonumber? // 0),
        gave_up: $gave_up, retry_gave_up: $retry_gave_up, worktree_blocked: $worktree_blocked,
        sync_blocked: $sync_blocked, sync_pending: $sync_pending, skip: $skip,
        agent: $agent, agent_started: ($agent_started | tonumber? // 0),
        session_id: $session_id, last_run: ($last_run | tonumber? // 0), model: $model}' >>"$recs"
  done
  recent_event_groups >"$act"
  jq -n --argjson now "$now" --arg repo "$(repo)" --arg update "$upd" \
    --arg running "$running" --arg pid "$pid" --arg launchd "$launchd" \
    --arg cycle_active "$cyc" --arg last_cycle "$last_cycle" --arg gh_err "$gh_err" \
    --arg watch "$watch_lbl" --arg interval "$INTERVAL" --arg perm_mode "$PERM_MODE" \
    --arg extras "$extras" --arg concurrency "$CONCURRENCY" \
    --arg max_rounds "$MAX_ROUNDS" --arg max_fails "$MAX_FAILS" --arg retry_max "$RETRY_MAX" \
    --arg reacts "$reacts" --arg table_rows "$TABLE_ROWS" --arg activity_lines "$ACTIVITY_LINES" \
    --arg title_w "$TITLE_W" --arg title_lines "$TITLE_LINES" \
    --argjson pending_ts "${pts:-0}" --argjson models_ts "${mts:-0}" \
    --slurpfile prs "$recs" --rawfile activity "$act" \
    '{v: 1, now: $now, repo: $repo, update: $update, gh_error: ($gh_err == "1"),
      pending_ts: $pending_ts, models_ts: $models_ts,
      watcher: {running: ($running == "1"), pid: $pid, launchd: ($launchd == "1"),
                cycle_active: ($cycle_active == "1"),
                last_cycle: ($last_cycle | tonumber? // 0), interval: ($interval | tonumber? // 120)},
      watch: $watch,
      cfg: {perm_mode: $perm_mode, extras: $extras, concurrency: ($concurrency | tonumber? // 2),
            max_rounds: ($max_rounds | tonumber? // 10), max_fails: ($max_fails | tonumber? // 3),
            retry_max: ($retry_max | tonumber? // 3), reacts: $reacts,
            table_rows: ($table_rows | tonumber? // 0), activity_lines: ($activity_lines | tonumber? // 6),
            title_w: ($title_w | tonumber? // 0), title_lines: ($title_lines | tonumber? // 3)},
      prs: $prs,
      activity: ($activity | split("\n") | map(select(length > 0)))}'
  rm -f "$recs" "$act"
}

