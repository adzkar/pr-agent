#!/usr/bin/env bash
# pr-agent — watch GitHub PRs for new review feedback and address it with a
# persistent Devin CLI session per PR.
#
# Unlike a spawn-per-event watcher, each PR gets its own long-lived Devin
# session stored in a map (pr -> session_id + worktree). New feedback resumes
# that session (`devin -r`) so the agent keeps context across review rounds.
#
# Usage:
#   pr-agent on [--launchd] [all | N...]  Start watching (default: your open non-draft PRs —
#                                         @all = everyone; --launchd survives reboot/crash)
#   pr-agent off [--now]            Stop the watcher (--now also kills running agents)
#   pr-agent status [-w [SECS]]     Dashboard (-w: live refresh, default 5s).
#                                   -w keys: ↑↓/jk and ←→/hl scroll, PgUp/PgDn,
#                                   g/G top/bottom, 0/$ left/right edges; q, ^C,
#                                   or end-of-input exits. Without a tty it
#                                   prints one plain snapshot — no controls.
#   pr-agent logs [N] [-f]          Event log, or PR N's latest agent transcript (-f follow)
#   pr-agent add | rm N...          Add/remove PR numbers from an explicit watch list
#   pr-agent run N [--force]        Process PR N now in the foreground (--force: redo last round)
#   pr-agent tell N "message"       Send your own instruction to PR N's session (background)
#   pr-agent attach N               Open PR N's session interactively in its worktree
#   pr-agent peek N                 Show unprocessed feedback for PR N (no action)
#   pr-agent mark-seen N            Mark current feedback as handled (no action)
#   pr-agent pause | resume N       Stop/restart automatic runs for one PR
#   pr-agent retry N [--dry-run]    Ping the review bot if its latest review run failed
#   pr-agent reset N                Forget PR N's session (next round starts fresh)
#   pr-agent reset-rounds N         Reset PR N's round counter (lifts the MAX_ROUNDS limit)
#   pr-agent gc [--yes]             Clean up worktrees/branches/state of merged & closed PRs
#                                   and stale state for numbers that aren't PRs
#   pr-agent sync [--apply [N]]     Report open PRs whose branch is behind their base;
#                                   --apply merges the base into them via their agent
#                                   sessions. Optional N: only PRs whose 'do not review'
#                                   banner depends on merged PR N.
#   pr-agent config                 Show effective settings
#   pr-agent map                    Show the raw PR → session/worktree map
#   pr-agent version                Print the installed version
#   pr-agent update [--check] [--force] [X.Y.Z]  Self-update this script from a GitHub
#                                                release (latest, or given; --force
#                                                reinstalls / allows a repo copy)
#
# A PR comment by you that starts with "/agent" is treated as feedback.
#
# Env (saved per repo by `pr-agent on`, env always wins):
#   PR_AGENT_INTERVAL     Poll seconds (default 120)
#   PR_AGENT_MODE         devin --permission-mode (default dangerous)
#   PR_AGENT_SANDBOX      1 = pass --sandbox to devin (default 0)
#   PR_AGENT_AUTHOR       Comma list; only react to these logins (default: anyone but you)
#   PR_AGENT_BOTS         Comma list of [bot] logins to react to (default: none);
#                         other bots are ignored unless listed in PR_AGENT_AUTHOR
#   PR_AGENT_PR_AUTHOR    Comma list of PR authors to watch in "all" mode
#                         (@me = your login, @all = everyone; default @me)
#   PR_AGENT_TRIGGER      Prefix that turns your own comment into feedback (default /agent)
#   PR_AGENT_MAX_FAILS    Consecutive failed runs per round before giving up (default 3)
#   PR_AGENT_MAX_ROUNDS   Stop auto-runs on a PR after this many rounds (default 10, 0 = off)
#   PR_AGENT_STOP_ON_APPROVE  1 = stop auto-runs once the PR is approved (default 1)
#   PR_AGENT_CONCURRENCY  Parallel agent runs across PRs (default 2)
#   PR_AGENT_CI           1 = treat failing CI checks as feedback (default 0)
#   PR_AGENT_CONFLICTS    1 = treat merge conflicts as feedback (default 0)
#   PR_AGENT_NOTIFY       1 = macOS notifications (default 1)
#   PR_AGENT_RETRY        1 = ping the review bot when it reports a failed review run
#                         (default 1; handled by the script — no agent session needed)
#   PR_AGENT_RETRY_MAX    Consecutive retry pings per PR before giving up (default 3)
#   PR_AGENT_RETRY_RE     jq regex on bot comment bodies that marks a failed run
#                         (default ^Review failed:)
#   PR_AGENT_RETRY_MSG    Ping comment template; {reviewer} becomes the bot's handle
#   PR_AGENT_SKIP_RE      Regex; feedback bodies matching it are ignored
#                         (default: HTML "in-progress" markers, e.g. a review bot's
#                          placeholder)
#   PR_AGENT_BOT_STATUS_RE  jq regex marking a bot's "working on it" chatter —
#                         applied only to top-level comments from [bot]/BOTS authors
#                         (reviews and line comments always pass, so bot findings
#                         can't be filtered). Case-insensitive and unanchored; the
#                         default omits "in progress" — too common in findings
#                         prose — but a comment using a shipped phrase mid-sentence
#                         is still filtered. Tighten via env, or have bots mark
#                         chatter with the SKIP_RE HTML marker
#                         (default: \b(underway|already running|queued)\b)
#   PR_AGENT_SETUP        Command run inside a newly created worktree instead of the
#                         built-in setup (env files + node_modules/bun)
#   PR_AGENT_MAIN_SYNC    1 = each poll also auto-syncs open PRs whose branch falls behind
#                         the default base — includes drafts & approved PRs that the
#                         review watcher skips. After a verified sync push, dep-gated
#                         drafts ('do not review before #N' banner, all N merged) are
#                         marked ready and unbannered. (default 0)
#   PR_AGENT_TABLE_ROWS   PR records in the status table (default 0 = every
#                         record renders; a positive N caps the list — whatever
#                         doesn't fit falls to the frame clip)
#   PR_AGENT_ACTIVITY_LINES  Lines in the status "recent activity" section
#                         (default 6, 0 = hide — frees rows for the table)
#   PR_AGENT_TITLE_W      Title column width in the status table (default 0 =
#                         auto — largest useful width from title content and the
#                         viewport beside the PR column; >0 pins a logical width
#                         (min 5), which may exceed the viewport — metadata
#                         columns scroll off-screen rather than squeeze the title)
#   PR_AGENT_TITLE_LINES  Max lines a TITLE cell wraps over in the status table
#                         (1 = truncate to one line, 0 = no cap; default 3 for
#                         plain status, 0 for status -w). Never shrunk to fit
#                         the screen — only env/saved values change it
#   PR_AGENT_UPDATE_CHECK 1 = check for newer releases in the background; the notice
#                             lands on a later run (default 1, 0 = fully off)
#   PR_AGENT_UPDATE_CHECK_EVERY  Seconds between release checks (default 86400)
#   PR_AGENT_REPO         owner/name to act on when not inside the repo
#   PR_AGENT_STATE_DIR    State root (default ~/.local/state/pr-agent)
#   DEVIN_BIN             Devin CLI binary (default devin)
#   PR_AGENT_SESSIONS_DB  Devin sessions index the status MODEL column reads
#                         (default $XDG_DATA_HOME/devin/cli/sessions.db) —
#                         `adaptive` stays `adaptive`, `unknown` = mapped session
#                         with no readable evidence, `—` = no session mapped;
#                         evidence is a bounded refresh, last-observed on lapse
#
# Examples:
#   # one-off:
#   PR_AGENT_TABLE_ROWS=10 pr-agent status -w
#   # persist per-repo (watcher must be off: pr-agent off first):
#   PR_AGENT_TABLE_ROWS=10 pr-agent on

set -euo pipefail

VERSION="0.3.1"   # release identity — bumped by ./release, shown by 'pr-agent version'
UPDATE_REPO="adzkar/pr-agent"   # upstream home of this script — where 'update' pulls releases from
STATE_ROOT="${PR_AGENT_STATE_DIR:-$HOME/.local/state/pr-agent}"
DEVIN_BIN="${DEVIN_BIN:-devin}"
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
mkdir -p "$STATE_ROOT/repos"

die() { echo "pr-agent: $*" >&2; exit 1; }

# --- per-repo state -------------------------------------------------------------
# State lives in $STATE_ROOT/repos/<owner>__<name>. Commands run inside a repo act
# on that repo; elsewhere they act on the repo last started with `pr-agent on`.

slug_of() { echo "$1" | sed 's#/#__#'; }

git_repo_name() { # -> owner/name from the current dir's origin remote (no network)
  local url; url="$(git remote get-url origin 2>/dev/null)" || return 1
  echo "$url" | sed -nE 's#^.*github\.com[:/]([^/]+/[^/]+)$#\1#p' | sed 's/\.git$//' | grep . 
}

migrate_legacy_state() { # move the pre-per-repo flat layout into repos/<slug>
  [ -f "$STATE_ROOT/map.json" ] && [ -f "$STATE_ROOT/repo" ] || return 0
  local slug dest f; slug="$(slug_of "$(cat "$STATE_ROOT/repo")")"; dest="$STATE_ROOT/repos/$slug"
  mkdir -p "$dest"
  for f in map.json repo repo_dir me targets watch.log last_cycle config status_cache status_error locks running; do
    [ -e "$STATE_ROOT/$f" ] && mv "$STATE_ROOT/$f" "$dest/" 2>/dev/null || true
  done
  rm -f "$STATE_ROOT/pid" "$STATE_ROOT/cycle_active"
  [ -f "$STATE_ROOT/current" ] || echo "$slug" >"$STATE_ROOT/current"
}
migrate_legacy_state

resolve_repo_slug() {
  local name
  if [ -n "${PR_AGENT_REPO:-}" ]; then slug_of "$PR_AGENT_REPO"; return; fi
  if name="$(git_repo_name 2>/dev/null)"; then slug_of "$name"; return; fi
  cat "$STATE_ROOT/current" 2>/dev/null || echo "_none"
}

REPO_SLUG="$(resolve_repo_slug)"
STATE_DIR="$STATE_ROOT/repos/$REPO_SLUG"
PID_FILE="$STATE_DIR/pid"
MAP_FILE="$STATE_DIR/map.json"
LOG_FILE="$STATE_DIR/watch.log"
PRS_CACHE="$STATE_DIR/prs.jsonl"
PRS_EXTRA="$STATE_DIR/prs_extra.jsonl"
PRS_LOCK="$STATE_DIR/prs.lock"
mkdir -p "$STATE_DIR"/{locks,running,seen,feedback,logs}

# --- settings: env > saved per-repo config > default; provenance tracked -------

SETTING_NOTES=''   # "NAME:src" entries for rejected invalid numeric values — reported by config, source files untouched

SETTINGS="INTERVAL PERM_MODE SANDBOX AUTHOR_FILTER PR_AUTHOR_FILTER BOTS TRIGGER MAX_FAILS MAX_ROUNDS STOP_ON_APPROVE CONCURRENCY CI_TRIGGER CONFLICT_TRIGGER NOTIFY RETRY RETRY_MAX RETRY_RE RETRY_MSG SKIP_RE BOT_STATUS_RE SETUP_CMD MAIN_SYNC TABLE_ROWS ACTIVITY_LINES TITLE_W TITLE_LINES UPDATE_CHECK UPDATE_CHECK_EVERY"

DISPLAY_SETTINGS="TABLE_ROWS ACTIVITY_LINES TITLE_W TITLE_LINES"   # keys whose provenance persists via CFG_SRC_* markers — the only keys a marker may demote

cfg_src() { # NAME -> CFG_SRC_NAME for display keys; a CFG_SRC marker on any other key is inert
  local v='' s="CFG_SRC_$1"
  case " ${DISPLAY_SETTINGS:-} " in *" $1 "*) v="${!s:-}" ;; esac
  printf '%s' "$v"
}

resolve_str() { # NAME ENVNAME default -> RES + RES_SRC (env > saved CFG_NAME > default; first non-empty wins). A CFG_SRC_NAME=default marker demotes a saved value to default (display keys only).
  # ENVNAME is the documented PR_AGENT_* name, passed in full: six settings' env names differ
  # from PR_AGENT_<NAME> (PERM_MODE→PR_AGENT_MODE et al.) so the name must not be derived.
  local n="$1" e="$2" def="$3" c="CFG_$1" ev cv
  ev="${!e:-}"; cv="${!c:-}"
  if [ -n "$ev" ]; then RES="$ev"; RES_SRC=env
  elif [ -n "$cv" ]; then
    if [ "$(cfg_src "$n")" = default ]; then RES="$def"; RES_SRC=default
    else RES="$cv"; RES_SRC=saved; fi
  else RES="$def"; RES_SRC=default; fi
}

resolve_num() { # NAME ENVNAME default -> RES + RES_SRC like resolve_str, but the first *valid digits* layer wins; rejected values join SETTING_NOTES; CFG_SRC_NAME=default demotes like resolve_str (display keys only)
  local n="$1" e="$2" def="$3" c="CFG_$1" v src
  RES=''; RES_SRC=''
  for src in env saved; do
    if [ "$src" = env ]; then v="${!e:-}"; else v="${!c:-}"; fi
    [ -z "$v" ] && continue
    if [[ "$v" =~ ^[0-9]+$ ]]; then
      RES="$v"; RES_SRC="$src"
      [ "$src" = saved ] && [ "$(cfg_src "$n")" = default ] && { RES="$def"; RES_SRC=default; }
      break
    fi
    SETTING_NOTES+=" $n:$src"
  done
  [ -n "$RES_SRC" ] || { RES="$def"; RES_SRC=default; }
}

setting_src() { # NAME -> provenance label env|saved|mode-default|default (default when unset, e.g. older scripts)
  eval "printf '%s' \"\${SRC_$1:-default}\""
}

apply_status_defaults() { # mode (watch|plain) -> mode defaults for keys with no env/saved provenance; marks them mode-default
  if [ "$(setting_src TITLE_LINES)" = default ]; then
    if [ "$1" = watch ]; then TITLE_LINES=0; else TITLE_LINES=3; fi
    SRC_TITLE_LINES=mode-default
  fi
}

load_settings() { # -> populate settings + SRC_<name> provenance; sources $STATE_DIR/config read-only
  if [ -f "$STATE_DIR/config" ]; then . "$STATE_DIR/config"; fi
  resolve_str  INTERVAL PR_AGENT_INTERVAL 120;              INTERVAL=$RES;        SRC_INTERVAL=$RES_SRC
  resolve_str  PERM_MODE PR_AGENT_MODE dangerous;           PERM_MODE=$RES;       SRC_PERM_MODE=$RES_SRC
  resolve_str  SANDBOX PR_AGENT_SANDBOX 0;                  SANDBOX=$RES;         SRC_SANDBOX=$RES_SRC
  resolve_str  AUTHOR_FILTER PR_AGENT_AUTHOR '';            AUTHOR_FILTER=$RES;   SRC_AUTHOR_FILTER=$RES_SRC
  resolve_str  PR_AUTHOR_FILTER PR_AGENT_PR_AUTHOR @me;     PR_AUTHOR_FILTER=$RES; SRC_PR_AUTHOR_FILTER=$RES_SRC
  resolve_str  BOTS PR_AGENT_BOTS '';                       BOTS=$RES;            SRC_BOTS=$RES_SRC
  resolve_str  TRIGGER PR_AGENT_TRIGGER /agent;             TRIGGER=$RES;         SRC_TRIGGER=$RES_SRC
  resolve_str  MAX_FAILS PR_AGENT_MAX_FAILS 3;              MAX_FAILS=$RES;       SRC_MAX_FAILS=$RES_SRC
  resolve_str  MAX_ROUNDS PR_AGENT_MAX_ROUNDS 10;           MAX_ROUNDS=$RES;      SRC_MAX_ROUNDS=$RES_SRC
  resolve_str  STOP_ON_APPROVE PR_AGENT_STOP_ON_APPROVE 1;  STOP_ON_APPROVE=$RES; SRC_STOP_ON_APPROVE=$RES_SRC
  resolve_str  CONCURRENCY PR_AGENT_CONCURRENCY 2;          CONCURRENCY=$RES;     SRC_CONCURRENCY=$RES_SRC
  resolve_str  CI_TRIGGER PR_AGENT_CI 0;                    CI_TRIGGER=$RES;      SRC_CI_TRIGGER=$RES_SRC
  resolve_str  CONFLICT_TRIGGER PR_AGENT_CONFLICTS 0;       CONFLICT_TRIGGER=$RES; SRC_CONFLICT_TRIGGER=$RES_SRC
  resolve_str  NOTIFY PR_AGENT_NOTIFY 1;                    NOTIFY=$RES;          SRC_NOTIFY=$RES_SRC
  resolve_str  SKIP_RE PR_AGENT_SKIP_RE 'in-progress -->';  SKIP_RE=$RES;         SRC_SKIP_RE=$RES_SRC
  resolve_str  BOT_STATUS_RE PR_AGENT_BOT_STATUS_RE '\b(underway|already running|queued)\b'; BOT_STATUS_RE=$RES; SRC_BOT_STATUS_RE=$RES_SRC
  resolve_str  SETUP_CMD PR_AGENT_SETUP '';                 SETUP_CMD=$RES;       SRC_SETUP_CMD=$RES_SRC
  resolve_str  MAIN_SYNC PR_AGENT_MAIN_SYNC 0;              MAIN_SYNC=$RES;       SRC_MAIN_SYNC=$RES_SRC
  resolve_str  RETRY PR_AGENT_RETRY 1;                      RETRY=$RES;           SRC_RETRY=$RES_SRC
  resolve_str  RETRY_MAX PR_AGENT_RETRY_MAX 3;              RETRY_MAX=$RES;       SRC_RETRY_MAX=$RES_SRC
  resolve_str  RETRY_RE PR_AGENT_RETRY_RE '^Review failed:'; RETRY_RE=$RES;       SRC_RETRY_RE=$RES_SRC
  resolve_str  RETRY_MSG PR_AGENT_RETRY_MSG '';             RETRY_MSG=$RES;       SRC_RETRY_MSG=$RES_SRC
  [ -n "$RETRY_MSG" ] || RETRY_MSG='@{reviewer} the review run failed — please retry.'   # {reviewer} -> bot handle
  resolve_num  TABLE_ROWS PR_AGENT_TABLE_ROWS 0;            TABLE_ROWS=$RES;      SRC_TABLE_ROWS=$RES_SRC
  resolve_num  ACTIVITY_LINES PR_AGENT_ACTIVITY_LINES 6;    ACTIVITY_LINES=$RES;  SRC_ACTIVITY_LINES=$RES_SRC
  resolve_num  TITLE_W PR_AGENT_TITLE_W 0;                  TITLE_W=$RES;         SRC_TITLE_W=$RES_SRC
  resolve_num  TITLE_LINES PR_AGENT_TITLE_LINES 3;          TITLE_LINES=$RES;     SRC_TITLE_LINES=$RES_SRC
  resolve_str  UPDATE_CHECK PR_AGENT_UPDATE_CHECK 1;        UPDATE_CHECK=$RES;    SRC_UPDATE_CHECK=$RES_SRC
  resolve_num  UPDATE_CHECK_EVERY PR_AGENT_UPDATE_CHECK_EVERY 86400; UPDATE_CHECK_EVERY=$RES; SRC_UPDATE_CHECK_EVERY=$RES_SRC
}

load_settings
FULL_CHECK_EVERY=10   # cycles; forces a full feedback fetch even if nothing looks changed

SETTINGS="INTERVAL PERM_MODE SANDBOX AUTHOR_FILTER PR_AUTHOR_FILTER BOTS TRIGGER MAX_FAILS MAX_ROUNDS STOP_ON_APPROVE CONCURRENCY CI_TRIGGER CONFLICT_TRIGGER NOTIFY RETRY RETRY_MAX RETRY_RE RETRY_MSG SKIP_RE BOT_STATUS_RE SETUP_CMD MAIN_SYNC TABLE_ROWS ACTIVITY_LINES TITLE_W TITLE_LINES UPDATE_CHECK UPDATE_CHECK_EVERY"

DISPLAY_SETTINGS="TABLE_ROWS ACTIVITY_LINES TITLE_W TITLE_LINES"   # keys whose provenance persists via CFG_SRC_* markers — the only keys a marker may demote

save_config() { # -> snapshot user-chosen settings to $STATE_DIR/config (v2): only env|saved provenance is written — resolver defaults stay unpinned so they can vary (mode-defaults, upgraded defaults); foreign lines preserved
  local tmp k re
  re='^CFG_(SRC_[A-Z0-9_]*'
  for k in $SETTINGS; do re+="|$k"; done
  re+=')='
  tmp="$(mktemp)"
  if [ -f "$STATE_DIR/config" ]; then
    { grep -vE "$re" "$STATE_DIR/config" | grep -vE '^# pr-agent config v?[0-9]* *$' || true; } >"$tmp"
  fi
  {
    echo '# pr-agent config v2'
    for k in $SETTINGS; do
      case "$(setting_src "$k")" in env|saved) printf 'CFG_%s=%q\n' "$k" "${!k}" ;; esac
    done
  } >>"$tmp"
  mv -f "$tmp" "$STATE_DIR/config"
}

log() {
  local msg="[$(date '+%Y-%m-%d %H:%M:%S')] $*"
  echo "$msg" >>"$LOG_FILE"
  echo "$msg"
}

notify() { # subtitle message -> macOS notification (best effort)
  [ "$NOTIFY" = "1" ] && command -v osascript >/dev/null || return 0
  local sub="${1//\"/\'}" msg="${2//\"/\'}"
  osascript -e "display notification \"$msg\" with title \"pr-agent\" subtitle \"$sub\"" >/dev/null 2>&1 &
}

# --- repo context -------------------------------------------------------------------

repo()      { cat "$STATE_DIR/repo" 2>/dev/null; }
repo_dir()  { cat "$STATE_DIR/repo_dir" 2>/dev/null; }
me()        { cat "$STATE_DIR/me" 2>/dev/null; }

need_repo() {
  repo >/dev/null || die "no repo recorded — run 'pr-agent on' from inside the repo first"
}

detect_repo() {
  local dir name
  dir="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not inside a git repo"
  dir="$(dirname "$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir)")"   # main checkout, even from a worktree
  name="$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null)" \
    || die "cannot resolve GitHub repo (gh auth ok?)"
  echo "$name" >"$STATE_DIR/repo"
  echo "$dir" >"$STATE_DIR/repo_dir"
  gh api user -q .login >"$STATE_DIR/me"
  gh repo view "$name" --json defaultBranchRef -q .defaultBranchRef.name >"$STATE_DIR/base" 2>/dev/null || true
  echo "$REPO_SLUG" >"$STATE_ROOT/current"
}

# --- map (JSON, jq-managed, lock-protected for concurrent runs) -----------------------

map_init() { [ -f "$MAP_FILE" ] || echo '{"prs":{}}' >"$MAP_FILE"; }

with_lock() { # lockdir cmd... -> run cmd while holding a mkdir lock (stale locks broken after ~10s)
  local l="$1" i=0 rc=0; shift
  until mkdir "$l" 2>/dev/null; do
    sleep 0.1; i=$(( i + 1 ))
    if [ "$i" -gt 100 ]; then rmdir "$l" 2>/dev/null || true; i=0; fi
  done
  "$@" || rc=$?
  rmdir "$l" 2>/dev/null || true
  return "$rc"
}

with_map_lock() { # cmd... -> run cmd while holding the map lock
  with_lock "$STATE_DIR/map.lock" "$@"
}

map_get() { # pr key -> value or empty
  map_init
  jq -r --arg pr "$1" --arg k "$2" '.prs[$pr][$k] // empty' "$MAP_FILE"
}

_map_jq() { # jq-filter args... -> apply to the map atomically
  local f="$1" tmp; shift; tmp="$(mktemp)"
  jq "$@" "$f" "$MAP_FILE" >"$tmp" && mv "$tmp" "$MAP_FILE"
}
map_set() { map_init; with_map_lock _map_jq '.prs[$pr][$k] = $v' --arg pr "$1" --arg k "$2" --arg v "$3"; }
map_del() { map_init; with_map_lock _map_jq 'del(.prs[$pr][$k])' --arg pr "$1" --arg k "$2"; }
map_rm()  { map_init; with_map_lock _map_jq 'del(.prs[$pr])' --arg pr "$1"; }
map_num() { local v; v="$(map_get "$1" "$2")"; echo "${v:-0}"; }

# --- PR list (one gh call per cycle, shared with status) --------------------------------
# prs.jsonl: one compact object per PR: number title state draft review updated head base
#            mergeable ci (pass|fail|pending|none) ci_failed [{name,url}]
#            review = reviewDecision; when empty (base has no required reviewers —
#            GitHub only computes it for protected branches) falls back to each
#            non-author reviewer's latest opinionated state (APPROVED /
#            CHANGES_REQUESTED — COMMENTED can't erase a verdict, DISMISSED
#            drops out): CHANGES_REQUESTED > APPROVED > none
# prs_extra.jsonl: same shape, for map/target PRs that aged out of the list's --limit
#            window — backfilled once each by backfill_prs so status keeps title/state.
#            Read by pr_info only; targets/pr_sig must NOT see it (stale state).

PR_JSON_FIELDS='number,title,state,isDraft,reviewDecision,reviews,updatedAt,headRefName,headRefOid,baseRefName,mergeable,statusCheckRollup,body,isCrossRepository,author'
PR_JQ='([.statusCheckRollup[]? | {name: (.name // .context), url: (.detailsUrl // .targetUrl // ""),
           bad: ((.conclusion // .state // "") | test("FAILURE|TIMED_OUT|CANCELLED|ACTION_REQUIRED|ERROR")),
           wait: ((.status // .state // "") | test("IN_PROGRESS|QUEUED|PENDING|EXPECTED|WAITING"))}]) as $c
       | (.author.login // "") as $al
       | ([.reviews[]? | select(.author.login != $al)
           | select(.state == "APPROVED" or .state == "CHANGES_REQUESTED")]
          | group_by(.author.login) | map(max_by(.submittedAt // "") | .state)) as $lr
       | {number, title, state, draft: .isDraft,
          review: (if (.reviewDecision // "") != "" then .reviewDecision
                   elif any($lr[]; . == "CHANGES_REQUESTED") then "CHANGES_REQUESTED"
                   elif any($lr[]; . == "APPROVED") then "APPROVED"
                   else "" end),
          updated: .updatedAt,
          branch: .headRefName, head: .headRefOid, base: .baseRefName, mergeable,
          body, cross: .isCrossRepository, author: (.author.login // ""),
          ci: (if ($c|length) == 0 then "none" elif any($c[]; .wait) then "pending"
               elif any($c[]; .bad) then "fail" else "pass" end),
          ci_failed: [$c[] | select(.bad) | {name, url}]} | tojson'

# jq fragment for "all"-mode author scoping (needs --arg pa $PR_AUTHOR_FILTER --arg me $(me)):
# true when the object's .author is in the comma list (case-insensitive) — "@me" maps to your
# login; "@all" or a blank filter means any author, missing .author (or unresolvable @me)
# never matches.
PR_AUTHOR_JQ='($pa | split(",") | map(gsub("^ +| +$"; "") | ascii_downcase
              | if . == "@me" then ($me | ascii_downcase) else . end)
              | map(select(length > 0))) as $A
             | ($pa | gsub(" "; "") | length) == 0 or ($A | index("@all")) != null
               or ((.author // "") | ascii_downcase as $a | any($A[]; . == $a))'

refresh_prs() { # ttl -> refresh prs.jsonl unless younger than ttl seconds; 1 on GitHub failure
  local ttl="$1" tmp
  if [ -f "$PRS_CACHE" ] && [ $(( $(date +%s) - $(stat -f %m "$PRS_CACHE") )) -lt "$ttl" ]; then return 0; fi
  tmp="$(mktemp)"
  if ! gh pr list --repo "$(repo)" --state all --limit 100 \
      --json "$PR_JSON_FIELDS" --jq ".[] | $PR_JQ" >"$tmp" 2>/dev/null; then
    rm -f "$tmp"; touch "$STATE_DIR/gh_error"; return 1
  fi
  rm -f "$STATE_DIR/gh_error"
  mv "$tmp" "$PRS_CACHE"
  backfill_prs
}

prs_extra_merge() { # additions-file -> append into prs_extra.jsonl via a locked, atomic rewrite
                    # (several dashboards/watchers may share the cache — never leave a partial file)
  local add="$1" tmp; tmp="$(mktemp)"
  if [ -f "$PRS_EXTRA" ]; then cat "$PRS_EXTRA" >"$tmp"; fi
  cat "$add" >>"$tmp"
  mv "$tmp" "$PRS_EXTRA"
}

backfill_prs() { # -> one gh pr view per tracked PR missing from both prs caches (once each ever)
  local known cand
  known="$( { jq -r '.number' "$PRS_CACHE" 2>/dev/null || true
              [ -f "$PRS_EXTRA" ] && jq -r '.number' "$PRS_EXTRA" 2>/dev/null || true; } | sort -u )"
  cand="$( { jq -r '.prs | keys[]' "$MAP_FILE" 2>/dev/null || true
             [ -f "$STATE_DIR/targets" ] && tr ' ' '\n' <"$STATE_DIR/targets" || true; } \
           | { grep -E '^[0-9]+$' || true; } | sort -u )"
  [ -n "$cand" ] || return 0
  local n tmp; tmp="$(mktemp)"
  for n in $(comm -23 <(printf '%s\n' "$cand") <(printf '%s\n' "$known")); do
    gh pr view "$n" --repo "$(repo)" --json "$PR_JSON_FIELDS" --jq "$PR_JQ" >>"$tmp" 2>/dev/null || true
  done
  [ -s "$tmp" ] && with_lock "$PRS_LOCK" prs_extra_merge "$tmp"
  rm -f "$tmp"
}

pr_info() { # pr [field] -> the PR's cached object (or one field of it); PRS_EXTRA covers aged-out PRs
  local -a files=()
  [ -f "$PRS_CACHE" ] && files+=( "$PRS_CACHE" )
  [ -f "$PRS_EXTRA" ] && files+=( "$PRS_EXTRA" )
  [ "${#files[@]}" -gt 0 ] || return 0
  jq -r --argjson n "$1" --arg f "${2:-}" \
    'select(.number == $n) | if $f == "" then tojson else (.[$f] // "" | tostring) end' \
    "${files[@]}" | head -1
}

targets() { # -> PR numbers to watch (from prs.jsonl)
  local t; t="$(cat "$STATE_DIR/targets" 2>/dev/null || true)"
  if [ "$t" = "all" ] || [ -z "$t" ]; then
    jq -r --arg pa "$PR_AUTHOR_FILTER" --arg me "$(me)" \
      'select(.state == "OPEN" and (.draft | not) and ('"$PR_AUTHOR_JQ"')) | .number' \
      "$PRS_CACHE" 2>/dev/null | tr '\n' ' '
  else
    echo "$t"
  fi
}

scope_label() { # -> display label for the "all"-mode watch scope ("@all"/blank = "all open PRs")
  local e
  for e in ${PR_AUTHOR_FILTER//,/ }; do
    [ "$(echo "$e" | tr '[:upper:]' '[:lower:]')" = "@all" ] && { echo "all open PRs"; return; }
  done
  if [ -n "${PR_AUTHOR_FILTER// /}" ]; then echo "open PRs by $PR_AUTHOR_FILTER"; else echo "all open PRs"; fi
}

# --- feedback collection ------------------------------------------------------------------
# Items are JSON lines: {key, ts, kind, author, body, url, ...}. `key` changes when an item
# is edited, so an edited review/comment (e.g. a placeholder turned into a real review) is
# picked up again. Handled keys are stored in seen/<pr>.

fetch_feedback() { # pr -> all feedback items as jsonl; non-zero if GitHub can't be reached
  local pr="$1" r; r="$(repo)"
  gh api --paginate "repos/$r/pulls/$pr/reviews" --jq '.[]
      | select((.state == "CHANGES_REQUESTED" or .state == "COMMENTED") and ((.body // "") | length > 0))
      | {key: "r:\(.id):\(.body | length)", ts: .submitted_at, kind: "review", state, id,
         author: .user.login, body, url: .html_url} | tojson' || return 1
  gh api --paginate "repos/$r/pulls/$pr/comments" --jq '.[]
      | {key: "c:\(.id):\(.updated_at)", ts: .created_at, kind: "line", id, author: .user.login, body,
         url: .html_url, path, line: (.line // .original_line), reply_to: .in_reply_to_id, hunk: .diff_hunk} | tojson' || return 1
  gh api --paginate "repos/$r/issues/$pr/comments" --jq '.[]
      | {key: "i:\(.id):\(.updated_at)", ts: .created_at, updated: .updated_at, kind: "comment", id,
         author: .user.login, body, url: .html_url} | tojson' || return 1
  synthetic_feedback "$pr"
}

synthetic_feedback() { # pr -> CI-failure / merge-conflict items (opt-in) from the PR list cache
  local info; info="$(pr_info "$1")"; [ -n "$info" ] || return 0
  echo "$info" | jq -c --arg ci "$CI_TRIGGER" --arg cf "$CONFLICT_TRIGGER" --arg now "$(date -u +%FT%TZ)" '
    (if $ci == "1" and .ci == "fail" then
      {key: "ci:\(.head)", ts: $now, kind: "ci", author: "pr-agent", synthetic: true, url: "",
       body: ("Failing checks on \(.head[0:8]):\n" + ([.ci_failed[] | "- \(.name) \(.url)"] | join("\n")))}
     else empty end),
    (if $cf == "1" and .mergeable == "CONFLICTING" then
      {key: "conflict:\(.head):\(.base)", ts: $now, kind: "conflict", author: "pr-agent", synthetic: true, url: "",
       body: "This branch has merge conflicts with `\(.base)`. Merge `origin/\(.base)` into the branch, resolve, verify, push."}
     else empty end)'
}

seed_seen() { # pr all_file -> create seen/<pr> on first sight, honouring the legacy timestamp cutoff
  local seen="$STATE_DIR/seen/$1" cutoff
  [ -f "$seen" ] && return 0
  cutoff="$(map_get "$1" last_seen_ts)"
  if [ -n "$cutoff" ]; then
    jq -r --arg c "$cutoff" 'select(.ts <= $c) | .key' "$2" >"$seen"
  else
    : >"$seen"
  fi
}

filter_feedback() { # pr all_file [seen_file] -> new, actionable items (jsonl, oldest first);
                    # default seen file: seen/<pr>
  local seen="${3:-$STATE_DIR/seen/$1}"; [ -f "$seen" ] || seen=/dev/null
  jq -c -s --arg me "$(me)" --arg only "$AUTHOR_FILTER" --arg bots "$BOTS" --arg skip "$SKIP_RE" \
      --arg retry_re "$RETRY_RE" --arg status_re "$BOT_STATUS_RE" --arg trig "$TRIGGER" --rawfile seen "$seen" '
    ($seen | split("\n") | map(select(length > 0) | {(.): true}) | add // {}) as $S
    | ($only | split(",") | map(gsub("^ +| +$"; "") | ascii_downcase) | map(select(length > 0))) as $O
    | ($bots | split(",") | map(gsub("^ +| +$"; "") | ascii_downcase) | map(select(length > 0))) as $B
    | map(select(
        ((.author // "") | ascii_downcase) as $a
        | ($S[.key] | not)
        and ($skip == "" or ((.body // "") | test($skip) | not))
        and ($retry_re == "" or ((($B | map(. == $a) | any)
                                 and ((.body // "") | test($retry_re))) | not))
        and ($status_re == "" or (.kind != "comment")
                                 or ((($a | endswith("[bot]")) or ($B | map(. == $a) | any)) | not)
                                 or ((.body // "") | test($status_re; "i") | not))
        and (.synthetic == true
             or ($a != "" and $a == ($me | ascii_downcase)
                 and $trig != "" and ((.body // "") | ltrimstr(" ") | startswith($trig)))
             or (($a == "" or $a != ($me | ascii_downcase))
                 and (if ($O | length) > 0 then ($O | map(. == $a) | any)
                      elif ($a | endswith("[bot]")) then ($B | map(. == $a) | any)
                      else true end)))))
    | sort_by(.ts) | .[]' "$2"
}

pending_feedback() { # pr -> new items (jsonl); non-zero if GitHub can't be reached
  local all; all="$(mktemp)"
  if ! fetch_feedback "$1" >"$all"; then rm -f "$all"; return 1; fi
  seed_seen "$1" "$all"
  filter_feedback "$1" "$all"
  rm -f "$all"
}

# --- failed review runs ---------------------------------------------------------
# A review bot (any login in BOTS) typically posts a placeholder comment on
# request and edits it into e.g. "Review failed: Devin review run failed." when
# its run crashes — a <!-- bot-in-progress --> marker stays in the body, so
# SKIP_RE keeps it away from the agent. Instead of waking an agent for it, the
# script pings the bot to retry. retry_cutoff (first start of this version)
# protects the existing backlog: only failures newer than the cutoff are
# auto-pinged; older ones need 'pr-agent retry N'.

retry_cutoff() { # -> ISO timestamp stored in $STATE_DIR/retry_cutoff (created once)
  local f="$STATE_DIR/retry_cutoff"
  [ -f "$f" ] || date -u +%FT%TZ >"$f"
  cat "$f"
}

review_failure_plan() { # pr all_file -> {key,url,updated,reviewer,stale[],reason} for the latest bot failure notice, or nothing
  local seen="$STATE_DIR/seen/$1"; [ -f "$seen" ] || seen=/dev/null
  jq -c -s --arg me "$(me)" --arg bots "$BOTS" --arg re "$RETRY_RE" --rawfile seen "$seen" '
    ($seen | split("\n") | map(select(length > 0) | {(.): true}) | add // {}) as $S
    | ($bots | split(",") | map(gsub("^ +| +$"; "") | ascii_downcase) | map(select(length > 0))) as $B
    | . as $all
    | [ $all[] | select(.kind == "comment" and (((.author // "") | ascii_downcase) as $a | $B | map(. == $a) | any)
                        and ((.body // "") | test($re))) ] as $F
    | if ($F | length) == 0 then empty else
        ($F | max_by(.updated // .ts)) as $L
        | ($L.updated // $L.ts) as $t
        | ($L.author | sub("\\[bot\\]$"; "")) as $who
        | { key: $L.key, url: $L.url, updated: $t, reviewer: $who,
            stale: [ $F[] | select(.key != $L.key and ($S[.key] | not)) | .key ],
            reason: (
              if $S[$L.key] then "seen"
              elif any($all[]; (((.author // "") | ascii_downcase) == (($L.author // "") | ascii_downcase))
                       and .key != $L.key and .ts > $t
                       and (.kind != "comment" or ((.body // "") | test($re) | not))) then "bot-active"
              elif any($all[]; (((.author // "") | ascii_downcase) as $a | $a != "" and $a == ($me | ascii_downcase))
                       and .kind == "comment" and .ts > $t
                       and ((.body // "") | contains("@" + $who))) then "already-pinged"
              else "" end) }
      end' "$2"
}

retry_reset_if_reviewed() { # pr all_file -> clear retry state when the bot produced a real review since the last ping
  [ "$(map_num "$1" retry_count)" -gt 0 ] || return 0
  local last; last="$(map_get "$1" retry_last_ping_ts)"; last="${last:-0000-00-00T00:00:00Z}"
  if jq -e -s --arg bots "$BOTS" --arg last "$last" '
       ($bots | split(",") | map(gsub("^ +| +$"; "") | ascii_downcase) | map(select(length > 0))) as $B
       | any(.[]; (((.author // "") | ascii_downcase) as $a | $B | map(. == $a) | any)
             and (.kind == "review" or .kind == "line") and .ts > $last)' "$2" >/dev/null; then
    map_set "$1" retry_count 0; map_del "$1" retry_gave_up
    log "PR #$1: bot reviewed again — retry counter reset"
  fi
}

handle_review_failure() { # pr all_file mode(watch|manual|dry) has_other(0|1) -> ping the bot when its latest review run failed
  [ "$RETRY" = "1" ] || return 0
  local pr="$1" all="$2" mode="$3" has_other="$4" plan
  plan="$(review_failure_plan "$pr" "$all")" || return 0
  [ -n "$plan" ] || return 0
  local key url updated reviewer stale reason n ts msg
  key="$(jq -r .key <<<"$plan")"; url="$(jq -r .url <<<"$plan")"
  updated="$(jq -r .updated <<<"$plan")"; reviewer="$(jq -r .reviewer <<<"$plan")"
  stale="$(jq -r '.stale[]' <<<"$plan")"; reason="$(jq -r .reason <<<"$plan")"

  if [ "$mode" != "dry" ]; then
    local k; for k in $stale; do echo "$k" >>"$STATE_DIR/seen/$pr"; done   # older failures made obsolete by the latest
  fi
  case "$reason" in
    seen)
      if [ "$mode" != "manual" ]; then
        [ "$mode" = "dry" ] && echo "PR #$pr: latest review-run failure already handled (seen)"
        return 0
      fi ;;   # an explicit 'pr-agent retry N' re-pings a failure that was already handled
    bot-active|already-pinged)
      if [ "$mode" = "dry" ]; then
        echo "PR #$pr: latest review-run failure already handled ($reason)"
      else
        echo "$key" >>"$STATE_DIR/seen/$pr"
        log "PR #$pr: review-run failure already handled ($reason)"
      fi
      return 0 ;;
  esac
  if [ "$has_other" = "1" ]; then
    # real feedback is going to the agent this round; its step-6 re-review comment pings the bot anyway
    if [ "$mode" = "dry" ]; then
      echo "PR #$pr: review run failed ($url) — retry would be folded into the pending agent round"
    else
      echo "$key" >>"$STATE_DIR/seen/$pr"
      log "PR #$pr: review run failed — retry folded into this agent round"
    fi
    return 0
  fi
  n="$(map_num "$pr" retry_count)"
  if [ "$mode" = "watch" ] && [ "$updated" '<' "$(retry_cutoff)" ]; then
    # pre-existing failure (backlog): watcher stays out of it; key NOT marked seen
    if [ "$(map_get "$pr" retry_skip_logged)" != "$key" ]; then
      map_set "$pr" retry_skip_logged "$key"
      log "PR #$pr: pre-existing review-run failure ignored — run 'pr-agent retry $pr' to ping"
    fi
    return 0
  fi
  if [ "$mode" = "watch" ] && [ "$n" -ge "$RETRY_MAX" ]; then
    echo "$key" >>"$STATE_DIR/seen/$pr"
    map_set "$pr" retry_gave_up 1
    log "PR #$pr: review run failed $RETRY_MAX times in a row — stopped pinging @$reviewer, needs you"
    notify "PR #$pr" "Review run failed ${RETRY_MAX}x in a row — needs you"
    return 0
  fi
  msg="${RETRY_MSG//\{reviewer\}/$reviewer}"
  if [ "$mode" = "dry" ]; then
    echo "PR #$pr: would ping @$reviewer ($msg) — failure $url, count $n/$RETRY_MAX"
    return 0
  fi
  if ts="$(gh api -X POST "repos/$(repo)/issues/$pr/comments" -f body="$msg" --jq .created_at 2>>"$LOG_FILE")"; then
    echo "$key" >>"$STATE_DIR/seen/$pr"
    map_set "$pr" retry_count $(( n + 1 )); map_set "$pr" retry_last_ping_ts "$ts"; map_del "$pr" retry_skip_logged
    log "PR #$pr: review run failed — pinged @$reviewer to retry ($(( n + 1 ))/$RETRY_MAX)"
    notify "PR #$pr" "Review run failed — pinged @$reviewer to retry"
  else
    log "PR #$pr: couldn't post the review-retry ping — will retry next poll"   # key NOT marked seen
  fi
}

# --- formatting ---------------------------------------------------------------------

format_feedback() { # jsonl on stdin -> markdown for the agent prompt
  jq -r -s --arg me "$(me)" '.[] |
    "---\n" +
    (if .kind == "line" then
       "### Line comment on `\(.path):\(.line // "?")` by @\(.author) — comment id \(.reply_to // .id)\(if .reply_to then " (reply in that thread)" else "" end)\n\(.url)\n\n"
       + (if .hunk then "```diff\n" + (.hunk | split("\n") | .[-12:] | join("\n")) + "\n```\n\n" else "" end)
     elif .kind == "review"   then "### Review (\(.state)) by @\(.author)\n\(.url)\n\n"
     elif .kind == "ci"       then "### Failing CI checks\n\n"
     elif .kind == "conflict" then "### Merge conflict\n\n"
     elif .author != null and (.author | ascii_downcase) == ($me | ascii_downcase)
           then "### Instruction from the PR owner (@\(.author))\n\(.url)\n\n"
     else "### PR comment by @\(.author)\n\(.url)\n\n" end)
    + (.body // "") + "\n"'
}

# --- worktree -----------------------------------------------------------------------

setup_worktree() { # src wt -> copy gitignored env/config files and dependencies into a new worktree
  local src="$1" wt="$2" f rel ws same=1 husky=''
  if [ -n "$SETUP_CMD" ]; then (cd "$wt" && SRC="$src" bash -c "$SETUP_CMD") || true; return 0; fi
  find "$src" -name node_modules -prune -o -name vendor -prune -o -name .git -prune -o \
       -type f \( -name '.env' -o -name '.env.*' -o -name 'config.local.json' \) -print 2>/dev/null \
    | { grep -vE '\.(example|sample|template)$' || true; } | while IFS= read -r f; do
        rel="${f#"$src"/}"
        [ -e "$wt/$rel" ] && continue
        mkdir -p "$wt/$(dirname "$rel")"; cp "$f" "$wt/$rel"
      done
  [ -f "$wt/package.json" ] || return 0
  local wss; wss=". $(jq -r '.workspaces // [] | if type == "object" then .packages else . end | .[] | select(test("[*]") | not)' "$wt/package.json" 2>/dev/null | tr '\n' ' ')"
  [ -d "$src/node_modules" ] || same=0
  for f in bun.lock package.json; do cmp -s "$src/$f" "$wt/$f" || same=0; done
  for ws in $wss; do cmp -s "$src/$ws/package.json" "$wt/$ws/package.json" || same=0; done
  if [ "$same" -eq 1 ]; then
    for ws in $wss; do
      if [ -d "$src/$ws/node_modules" ] && [ ! -e "$wt/$ws/node_modules" ]; then cp -R "$src/$ws/node_modules" "$wt/$ws/"; fi
    done
  elif command -v bun >/dev/null; then
    (cd "$wt" && bun install --frozen-lockfile) || true
  fi
  for ws in $wss; do
    if jq -e '.scripts.prepare // "" | test("husky")' "$wt/$ws/package.json" >/dev/null 2>&1; then husky="$ws"; break; fi
  done
  if [ -n "$husky" ] && command -v bun >/dev/null; then (cd "$wt/$husky" && bun run prepare) || true; fi
}

worktree_holding() { # rd branch -> worktree path(s) where branch is checked out, one per line (skips prunable stale registrations)
  git -C "$1" worktree list --porcelain \
    | awk -v b="refs/heads/$2" '
        /^worktree /{if (hit && !prun) print w; w=substr($0, 10); hit=0; prun=0}
        /^branch /{if ($2 == b) hit=1}
        /^prunable /{prun=1}
        END{if (hit && !prun) print w}'
}

ensure_worktree() { # pr branch -> prints worktree abs path (never the main checkout); rc 4 = branch checked out in the main checkout (deterministic block, not a transient failure)
  local pr="$1" branch="$2" rd rd_real wt existing; rd="$(repo_dir)"
  [ -n "$branch" ] || { echo "PR #$pr: unknown head branch" >&2; return 1; }
  [ -n "$rd" ] || { echo "PR #$pr: no repo_dir recorded" >&2; return 1; }   # grep -qxF on an empty $rd would false-positive the block check below
  # worktree paths come back canonicalized — compare against the real path too,
  # or a symlinked repo_dir slips through and the agent would run in the main checkout
  rd_real="$(cd "$rd" 2>/dev/null && pwd -P || true)"; rd_real="${rd_real:-$rd}"
  existing="$(map_get "$pr" worktree)"
  if [ -n "$existing" ] && [ -d "$existing" ] && [ "$existing" != "$rd" ] && [ "$existing" != "$rd_real" ]; then echo "$existing"; return 0; fi

  wt="$(worktree_holding "$rd" "$branch")"
  if printf '%s\n' "$wt" | grep -qxF "$rd" || printf '%s\n' "$wt" | grep -qxF "$rd_real"; then
    echo "PR #$pr: branch $branch is checked out in the main checkout — refusing to run there; switch it to another branch" >&2
    return 4
  fi
  wt="$(printf '%s\n' "$wt" | head -1)"   # a branch lives in at most one worktree — take the first live entry
  if [ -n "$wt" ] && [ -d "$wt" ]; then echo "$wt"; return 0; fi

  wt="$(dirname "$rd")/$(basename "$rd")-pr-$pr"
  if [ ! -d "$wt" ]; then
    git -C "$rd" worktree prune 2>/dev/null || true   # drop stale registrations or a leftover "checked out" blocks the add below
    git -C "$rd" fetch origin "$branch" >&2 2>/dev/null || git -C "$rd" fetch origin "pull/$pr/head:pr-$pr" >&2
    if git -C "$rd" show-ref --verify --quiet "refs/heads/$branch"; then
      git -C "$rd" worktree add "$wt" "$branch" >&2
    elif git -C "$rd" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
      git -C "$rd" worktree add --track -b "$branch" "$wt" "origin/$branch" >&2
    else
      git -C "$rd" worktree add "$wt" "pr-$pr" >&2
    fi
    setup_worktree "$rd" "$wt" >&2
  fi
  [ -d "$wt" ] && echo "$wt"
}

still_blocked() { # pr -> 0 still blocked; 1 confirmed free; 2 indeterminate (callers: keep flag + sig, skip — a forced round would burn fail_count)
  local rd rd_real wt branch
  rd="$(repo_dir)"; branch="$(pr_info "$1" branch)"
  [ -n "$rd" ] && [ -n "$branch" ] || return 2
  git -C "$rd" rev-parse --git-dir >/dev/null 2>&1 || return 2   # moved/deleted repo or broken .git — a probe here would lie
  # a renamed branch name can freeze in prs_extra — don't trust a probe on a ref that isn't there
  git -C "$rd" show-ref --verify --quiet "refs/heads/$branch" \
    || git -C "$rd" show-ref --verify --quiet "refs/remotes/origin/$branch" || return 1
  rd_real="$(cd "$rd" 2>/dev/null && pwd -P || true)"; rd_real="${rd_real:-$rd}"
  wt="$(worktree_holding "$rd" "$branch")" || return 2   # worktree list failed on a live repo — can't determine
  printf '%s\n' "$wt" | grep -qxF "$rd" || printf '%s\n' "$wt" | grep -qxF "$rd_real"
}

sync_worktree() { # wt branch -> fast-forward to origin if the tree is clean (best effort)
  [ -z "$(git -C "$1" status --porcelain 2>/dev/null)" ] || return 0
  git -C "$1" fetch -q origin "$2" 2>/dev/null && git -C "$1" merge -q --ff-only "origin/$2" 2>/dev/null || true
}

# --- main-sync (post-merge catch-up) ----------------------------------------------------
# A PR is "behind" when origin/<base> is not an ancestor of its head. The script detects
# this and hands the merge to the PR's agent session (same session as review rounds);
# unbanner + ready for dep-gated drafts is done by the script AFTER the push is verified,
# tracked via the sync_unblock state machine so partial failures are resumable.

default_base() { # -> the repo's default branch name (cached by detect_repo)
  local b; b="$(cat "$STATE_DIR/base" 2>/dev/null)"
  if [ -z "$b" ]; then
    b="$(gh repo view "$(repo)" --json defaultBranchRef -q .defaultBranchRef.name 2>/dev/null)"
    [ -n "$b" ] && echo "$b" >"$STATE_DIR/base"
  fi
  echo "${b:-main}"
}

fetch_base() { # base -> refresh origin/<base>; 1 on fetch failure
  git -C "$(repo_dir)" fetch -q origin "$1" 2>/dev/null
}

base_sha() { # base -> current remote-tracking sha
  git -C "$(repo_dir)" rev-parse --verify -q "origin/$1" 2>/dev/null
}

branch_head() { # pr -> remote head sha (from the prs cache, live gh fallback)
  local h; h="$(pr_info "$1" head)"
  [ -n "$h" ] || h="$(gh pr view "$1" --repo "$(repo)" --json headRefOid -q .headRefOid 2>/dev/null)"
  echo "$h"
}

pr_behind_base() { # pr basesha -> 0 when the PR head exists and doesn't contain basesha
  local pr="$1" head branch
  head="$(branch_head "$pr")"; [ -n "$head" ] || return 1
  if ! git -C "$(repo_dir)" cat-file -e "$head" 2>/dev/null; then
    branch="$(pr_info "$pr" branch)"
    [ -n "$branch" ] && git -C "$(repo_dir)" fetch -q origin "$branch" 2>/dev/null || true
    git -C "$(repo_dir)" cat-file -e "$head" 2>/dev/null || return 1
  fi
  ! git -C "$(repo_dir)" merge-base --is-ancestor "$2" "$head" 2>/dev/null
}

sync_key() { echo "sync:$1:$2"; }   # head:base — a new base or head re-triggers sync

dep_banner_numbers() { # body -> dep PR numbers named on 'do not review before' lines
  printf '%s\n' "$1" | grep -iE 'do[[:space:]]+not[[:space:]]+review[[:space:]]+before' \
    | grep -oE '#[0-9]+' | tr -d '#' | sort -un | xargs 2>/dev/null || true
}

depf_match() { # pr depN -> 0 when the PR's dep banner lists depN
  local deps; deps="$(dep_banner_numbers "$(pr_info "$1" body)")"
  [ -n "$deps" ] && printf ' %s ' "$deps" | grep -q " $2 "
}

unblock_pending() { # pr -> 0 when it's a draft whose banner deps are ALL merged (live check)
  local deps d st
  [ "$(pr_info "$1" draft)" = "true" ] || return 1
  deps="$(dep_banner_numbers "$(pr_info "$1" body)")"; [ -n "$deps" ] || return 1
  for d in $deps; do
    st="$(gh pr view "$d" --repo "$(repo)" --json state -q .state 2>/dev/null)"
    [ "$st" = "MERGED" ] || return 1
  done
  return 0
}

verify_synced() { # pr basesha -> 0 when the REMOTE branch now contains basesha
  local branch; branch="$(pr_info "$1" branch)"; [ -n "$branch" ] || return 1
  git -C "$(repo_dir)" fetch -q origin "$branch" 2>/dev/null || return 1
  git -C "$(repo_dir)" merge-base --is-ancestor "$2" "origin/$branch" 2>/dev/null
}

apply_unblock() { # pr -> ready a dep-gated draft + strip its banner; resumable via sync_unblock
  local st; st="$(map_get "$1" sync_unblock)"
  [ -n "$st" ] && [ "$st" != "done" ] || return 0
  local info; info="$(gh pr view "$1" --repo "$(repo)" --json state,isDraft,body 2>>"$LOG_FILE")" || return 1
  [ "$(jq -r .state <<<"$info")" = "OPEN" ] || { map_del "$1" sync_unblock; return 0; }
  if [ "$st" = "pending" ]; then
    local deps d dst allm=1
    deps="$(dep_banner_numbers "$(jq -r .body <<<"$info")")"
    if [ -z "$deps" ]; then map_del "$1" sync_unblock; return 0; fi   # banner gone — nothing to do
    for d in $deps; do
      dst="$(gh pr view "$d" --repo "$(repo)" --json state -q .state 2>/dev/null)"
      [ "$dst" = "MERGED" ] || allm=0
    done
    [ "$allm" = "1" ] || { map_del "$1" sync_unblock; return 0; }      # dep un-merged/reopened — drop intent
    if [ "$(jq -r .isDraft <<<"$info")" != "true" ]; then
      map_set "$1" sync_unblock ready                                 # already non-draft — go straight to strip
    elif gh pr ready "$1" --repo "$(repo)" >>"$LOG_FILE" 2>&1; then
      map_set "$1" sync_unblock ready
      log "PR #$1: dependencies merged — marked ready for review"
      notify "PR #$1" "Dependencies merged — marked ready for review"
    else
      log "PR #$1: 'gh pr ready' failed — will retry next poll"; return 1
    fi
  fi
  if [ "$(map_get "$1" sync_unblock)" = "ready" ]; then
    local nb bf; bf="$(mktemp)"
    nb="$(jq -r .body <<<"$info" | grep -vEi 'do[[:space:]]+not[[:space:]]+review[[:space:]]+before' | sed -e '/./,$!d')"
    if [ "$nb" = "$(jq -r .body <<<"$info")" ]; then
      map_set "$1" sync_unblock done; rm -f "$bf"; return 0          # banner already gone
    fi
    printf '%s\n' "$nb" >"$bf"
    if gh pr edit "$1" --repo "$(repo)" --body-file "$bf" >>"$LOG_FILE" 2>&1; then
      map_set "$1" sync_unblock done; log "PR #$1: removed the do-not-review banner"
    else
      log "PR #$1: couldn't strip the banner — will retry next poll"   # stays 'ready', retried later
    fi
    rm -f "$bf"
  fi
}

scan_sync_candidates() { # -> open same-repo PRs targeting the default base, within watch scope
  local t p b; t="$(cat "$STATE_DIR/targets" 2>/dev/null || true)"; b="$(default_base)"
  if [ "$t" = "all" ] || [ -z "$t" ]; then
    jq -r --arg b "$b" --arg pa "$PR_AUTHOR_FILTER" --arg me "$(me)" \
      'select(.state=="OPEN" and .base==$b and (.cross // false | not) and ('"$PR_AUTHOR_JQ"')) | .number' \
      "$PRS_CACHE" 2>/dev/null
  else
    for p in $t; do
      [ "$(pr_info "$p" state)" = "OPEN" ] && [ "$(pr_info "$p" base)" = "$b" ] \
        && [ "$(pr_info "$p" cross)" != "true" ] && echo "$p"
    done
  fi
}

build_sync_prompt() { # pr branch head basesha base -> prompt for the PR's agent session
  local pr="$1" branch="$2" head="$3" bsha="$4" base="$5"
  cat <<EOF
Sync task for PR #$pr ($(repo), branch \`$branch\`, base \`$base\`). You are in the PR's worktree; earlier context is preserved.

\`origin/$base\` moved ahead of this branch — it is missing commits up to $bsha. Bring the branch up to date:

1. Run \`git status\` and \`git fetch origin\` first — abort and explain if the worktree is dirty or on a different branch.
2. Merge with \`git merge origin/$base\` (a merge commit — do NOT rebase).
3. Conflict policy:
   - Translation files (*/assets/lang/*.json): union-merge — keep keys from both sides; for the same key keep the better translation; the result must be valid JSON with no duplicate keys.
   - Generated files (e.g. routeTree.gen.ts): resolve the source conflicts first, then regenerate (backoffice: \`bun run generate:routes\`) — never hand-edit generated output.
   - If the merge touched \`shared-ts/\` and you verify a consumer package, build shared-ts first (\`cd shared-ts && bun run build\`) so consumers typecheck against the new dist.
   - Other files: keep both sides' changes where they coexist; if the right resolution needs a product decision, stop and explain instead of guessing.
4. Verify per the affected subproject's AGENTS.md (e.g. backoffice: \`bun run lint\` and \`bun run build\`). Do NOT push if verification fails — report what failed and leave the state in the worktree.
5. Before pushing, \`git fetch origin\` again: if \`origin/$base\` advanced past $bsha, merge it again and re-verify; if the remote branch moved past $head, stop and report instead of overwriting. Push with \`git push\` — never force-push.

Do not edit the PR body, do not change draft/ready state, and do not request reviewers — the watcher handles unblocking after it verifies your push.
EOF
}

check_sync() { # pr basesha base mode(watch|manual) -> merge the base into the PR branch via its agent session
  local pr="$1" bsha="$2" base="$3" mode="${4:-watch}" lock="$STATE_DIR/locks/$1"
  local head branch key pf rc=0 fails
  if ! mkdir "$lock" 2>/dev/null; then
    [ "$mode" = "manual" ] && echo "PR #$pr: busy — an agent run is in progress, try when it finishes"
    return 0
  fi
  head="$(branch_head "$pr")"; branch="$(pr_info "$pr" branch)"; key="$(sync_key "$head" "$bsha")"
  if [ -z "$head" ] || [ -z "$branch" ]; then
    log "PR #$pr: sync skipped — can't resolve head branch/sha"; rmdir "$lock" 2>/dev/null || true; return 0
  fi
  if [ "$mode" != "manual" ] && [ "$key" = "$(map_get "$pr" sync_blocked_key)" ]; then
    rmdir "$lock" 2>/dev/null || true; return 0    # this head:base state already failed MAX_FAILS times
  fi
  if [ "$key" = "$(map_get "$pr" sync_done_key)" ]; then
    map_del "$pr" sync_pending; rmdir "$lock" 2>/dev/null || true; return 0
  fi
  if [ "$key" != "$(map_get "$pr" sync_fail_key)" ]; then map_set "$pr" sync_fail_key "$key"; map_set "$pr" sync_fails 0; fi
  if unblock_pending "$pr"; then map_set "$pr" sync_unblock pending; else map_del "$pr" sync_unblock; fi
  pf="$(mktemp)"; build_sync_prompt "$pr" "$branch" "$head" "$bsha" "$base" >"$pf"
  log "PR #$pr: branch behind origin/$base — sync agent started"
  run_agent "$pr" "$pf" || rc=$?
  rm -f "$pf"
  if [ "$rc" -eq 0 ] && verify_synced "$pr" "$bsha"; then
    map_set "$pr" sync_done_key "$key"; map_set "$pr" sync_fails 0
    map_del "$pr" sync_pending; map_del "$pr" sync_blocked_key; map_del "$pr" sync_blocked
    map_set "$pr" sync_runs $(( $(map_num "$pr" sync_runs) + 1 )); map_set "$pr" last_run_at "$(date +%s)"
    log "PR #$pr: synced with origin/$base ✓"; notify "PR #$pr" "Synced with $base"
    apply_unblock "$pr" || true
  elif [ "$rc" -eq 4 ]; then
    # deterministic local block, not a sync failure — don't burn sync_fails or
    # escalate; sync_pending stays set so the merge retries once the branch frees
    [ "$mode" = "manual" ] && echo "PR #$pr: worktree blocked — the branch is checked out in the main checkout; switch it to another branch and retry"
    if [ -z "$(map_get "$pr" blocked_logged)" ]; then
      map_set "$pr" blocked_logged 1
      log "PR #$pr: sync deferred — worktree blocked (branch checked out in the main checkout)"
      notify "PR #$pr" "Worktree blocked — switch the main checkout off this PR's branch"
    fi
  elif [ "$rc" -eq 2 ] || [ "$rc" -eq 3 ]; then
    log "PR #$pr: sync deferred — session busy or stopped"   # sync_pending stays set; retried next poll
  else
    fails=$(( $(map_num "$pr" sync_fails) + 1 )); map_set "$pr" sync_fails "$fails"
    map_set "$pr" last_run_at "$(date +%s)"
    if [ "$fails" -ge "$MAX_FAILS" ]; then
      map_set "$pr" sync_blocked_key "$key"; map_set "$pr" sync_blocked 1; map_del "$pr" sync_pending
      log "PR #$pr: main sync failed $MAX_FAILS times — giving up on this head/base state"
      notify "PR #$pr" "Main sync failed ${MAX_FAILS}x — needs you"
      gh pr comment "$pr" --repo "$(repo)" \
        --body "Couldn't sync this branch with \`$base\` after $MAX_FAILS attempts — needs manual attention." \
        >>"$LOG_FILE" 2>&1 || true
    else
      log "PR #$pr: sync run didn't land the merge (attempt $fails/$MAX_FAILS) — will retry"
    fi
  fi
  rm -f "$STATE_DIR/running/$pr"; rmdir "$lock" 2>/dev/null || true
}

sync_scan() { # mode(report|apply|watch) [dep-filter-pr] -> detect PRs behind base and act
  local mode="$1" depf="${2:-}" rd pr head branch key bsha base shown=0 extra act t what
  rd="$(repo_dir)"; [ -n "$rd" ] || { log "sync: no repo_dir — run 'pr-agent on' from the repo first"; return 1; }
  base="$(default_base)"
  fetch_base "$base" || { [ "$mode" != "watch" ] && echo "sync: can't fetch origin/$base" >&2; return 1; }
  bsha="$(base_sha "$base")"; [ -n "$bsha" ] || return 1
  for pr in $(scan_sync_candidates); do
    if [ "$(map_get "$pr" paused)" = "1" ]; then map_del "$pr" sync_pending; continue; fi
    [ -n "$depf" ] && { depf_match "$pr" "$depf" || continue; }
    head="$(branch_head "$pr")"; branch="$(pr_info "$pr" branch)"; key="$(sync_key "$head" "$bsha")"
    if pr_behind_base "$pr" "$bsha"; then
      case "$mode" in
        report)
          shown=$(( shown + 1 )); extra=''
          [ "$(pr_info "$pr" mergeable)" = "CONFLICTING" ] && extra="conflicting"
          [ "$(pr_info "$pr" draft)" = "true" ] && extra="${extra:+$extra, }draft"
          [ "$(pr_info "$pr" review)" = "APPROVED" ] && extra="${extra:+$extra, }approved"
          if [ "$key" = "$(map_get "$pr" sync_blocked_key)" ]; then act="blocked after $MAX_FAILS failed syncs — --apply retries"
          elif [ "$key" = "$(map_get "$pr" sync_done_key)" ]; then act="already synced this state"
          else act="merge origin/$base + verify + push"; fi
          if [ "$key" != "$(map_get "$pr" sync_done_key)" ] && unblock_pending "$pr"; then
            act="$act → mark ready + remove dep banner"
          fi
          printf '#%-5s %-40s %-24s %s\n' "$pr" "${branch:-?}" "${extra:-—}" "$act" ;;
        watch)
          # blocked worktree → check_sync only defers rc 4; skip the prompt/fork churn until it frees
          [ "$(map_get "$pr" worktree_blocked)" = "1" ] && continue
          if [ "$key" != "$(map_get "$pr" sync_done_key)" ] && [ "$key" != "$(map_get "$pr" sync_blocked_key)" ]; then
            map_set "$pr" sync_pending 1
            while [ "$(jobs -rp | wc -l | tr -d ' ')" -ge "$CONCURRENCY" ]; do sleep 2; done
            ( check_sync "$pr" "$bsha" "$base" watch ) &
          fi ;;
        apply)
          if [ "$key" = "$(map_get "$pr" sync_done_key)" ]; then echo "PR #$pr: already synced with this base — skipping"; continue; fi
          echo "── PR #$pr ($branch) — syncing with origin/$base"
          check_sync "$pr" "$bsha" "$base" manual ;;
      esac
    else
      if [ "$mode" != "report" ]; then
        map_del "$pr" sync_pending
        # not behind, but a draft banner may still be unblocked (or a partial unblock resumed)
        if [ -z "$(map_get "$pr" sync_unblock)" ] && unblock_pending "$pr"; then map_set "$pr" sync_unblock pending; fi
        case "$(map_get "$pr" sync_unblock)" in pending|ready) apply_unblock "$pr" || true ;; esac
      elif unblock_pending "$pr"; then
        shown=$(( shown + 1 ))
        printf '#%-5s %-40s %-24s %s\n' "$pr" "${branch:-?}" "current" "deps merged — would mark ready + remove banner"
      fi
    fi
  done
  if [ "$mode" = "report" ] && [ "$shown" -eq 0 ]; then
    t="$(cat "$STATE_DIR/targets" 2>/dev/null || true)"
    if [ "$t" = "all" ] || [ -z "$t" ]; then what="$(scope_label)"; else what="watched PRs"; fi
    echo "$what are current with origin/$base — nothing to sync"
  fi
}

# --- agent -----------------------------------------------------------------------------

build_prompt() { # pr branch feedback_jsonl -> full prompt text
  local pr="$1" branch="$2" base; base="$(pr_info "$pr" base)"
  cat <<EOF
New feedback on PR #$pr ($(repo), branch \`$branch\`, base \`${base:-main}\`). You are working in the PR's worktree; your context from earlier rounds is preserved (this is round $(( $(map_num "$pr" rounds) + 1 ))).

$(format_feedback <"$3")
---

Instructions:
1. Run \`git status\` and \`git fetch origin\` first — the tree may have changed since your last turn. Re-read any file before editing it; do not rely on remembered contents.
2. Address every finding (HIGH/MEDIUM/LOW). Do not dismiss a finding without attempting a fix. Instructions from the PR owner take priority.
3. For failing CI: inspect with \`gh pr checks $pr\` and \`gh run view <run-id> --log-failed\`. For merge conflicts: merge \`origin/${base:-main}\`, resolve, re-verify.
4. Run the project's verification (see AGENTS.md), commit per topic, and push.
5. For each line comment, reply in its thread with a one-line summary of the fix:
   \`gh api repos/$(repo)/pulls/$pr/comments/<comment id>/replies -f body='...'\`
6. Post one PR comment listing each finding with what was done, confirm verification, and ask the reviewer to re-review.
EOF
}

devin_flags() { # -> common devin CLI flags
  printf '%s\n' --permission-mode "$PERM_MODE"
  if [ "$SANDBOX" = "1" ]; then printf '%s\n' --sandbox; fi
}

session_ids() { # cwd -> known session ids in that directory
  (cd "$1" && "$DEVIN_BIN" list --format json 2>/dev/null) | jq -r '.[].id' 2>/dev/null || true
}

new_session_id() { # cwd before_ids_file start_epoch -> id of the session created by our run
  local ids mapped
  mapped="$(jq -r '[.prs[].session_id // empty] | .[]' "$MAP_FILE")"
  ids="$( (cd "$1" && "$DEVIN_BIN" list --format json 2>/dev/null) \
    | jq -r --argjson since "$3" --rawfile before "$2" --arg mapped "$mapped" '
        ($before | split("\n")) as $b | ($mapped | split("\n")) as $m
        | map(select(.last_activity_at >= $since and ((.id as $i | $b | index([$i])) | not)
                     and ((.id as $i | $m | index([$i])) | not)))
        | sort_by(.last_activity_at) | last | .id // empty' 2>/dev/null || true)"
  echo "$ids"
}

run_agent() { # pr prompt_file -> 0 ok, 1 fail, 2 session busy elsewhere, 3 stopped by user, 4 worktree blocked
  local pr="$1" pf="$2" wt branch session out apid rc=0 flags before ids_before
  branch="$(pr_info "$pr" branch)"
  [ -n "$branch" ] || branch="$(gh pr view "$pr" --repo "$(repo)" --json headRefName -q .headRefName 2>/dev/null || true)"
  local ewrc=0
  wt="$(ensure_worktree "$pr" "$branch" 2>>"$LOG_FILE")" || ewrc=$?
  if [ "$ewrc" -eq 4 ]; then map_set "$pr" worktree_blocked 1; return 4; fi
  map_del "$pr" worktree_blocked; map_del "$pr" blocked_logged   # last prep wasn't blocked — no stale flag masking real failures
  if [ -z "$wt" ]; then
    log "PR #$pr: couldn't prepare a worktree (see log)"; return 1
  fi
  map_set "$pr" worktree "$wt"; map_set "$pr" branch "$branch"
  sync_worktree "$wt" "$branch"

  mkdir -p "$STATE_DIR/logs/$pr"
  out="$STATE_DIR/logs/$pr/$(date +%Y%m%d-%H%M%S).log"
  ln -sf "$out" "$STATE_DIR/logs/$pr/latest.log"
  ls -t "$STATE_DIR/logs/$pr"/2*.log 2>/dev/null | tail -n +21 | xargs rm -f 2>/dev/null || true
  flags="$(devin_flags)"
  session="$(map_get "$pr" session_id)"

  if [ -n "$session" ]; then
    log "PR #$pr: resuming session $session in $(basename "$wt")"
    # shellcheck disable=SC2086
    (cd "$wt" && exec "$DEVIN_BIN" $flags -r "$session" -p "$(cat "$pf")") >"$out" 2>&1 &
    apid=$!
    local t0; t0="$(date +%s)"
    echo "$apid $t0 resume" >"$STATE_DIR/running/$pr"
    wait "$apid" || rc=1
    [ -f "$STATE_DIR/running/$pr" ] || { log "PR #$pr: agent run stopped by user"; return 3; }
    [ "$rc" -eq 0 ] && return 0
    rc=0
    if grep -q "already open in another process" "$out"; then
      log "PR #$pr: session $session is open in another process — will retry next poll"
      return 2
    fi
    if [ $(( $(date +%s) - t0 )) -ge 30 ]; then
      log "PR #$pr: resumed session $session failed mid-run (keeping it for the retry)"; return 1
    fi
    log "PR #$pr: couldn't resume $session; starting a fresh session"
  fi

  log "PR #$pr: starting new session in $(basename "$wt")"
  before="$(date +%s)"; ids_before="$(mktemp)"; session_ids "$wt" >"$ids_before"
  # shellcheck disable=SC2086
  (cd "$wt" && exec "$DEVIN_BIN" $flags -p "$(cat "$pf")") >>"$out" 2>&1 &
  apid=$!
  echo "$apid $(date +%s) new" >"$STATE_DIR/running/$pr"
  wait "$apid" || rc=1
  if [ ! -f "$STATE_DIR/running/$pr" ]; then log "PR #$pr: agent run stopped by user"; rc=3; fi
  sleep 1
  local sid; sid="$(new_session_id "$wt" "$ids_before" "$before")"; rm -f "$ids_before"
  if [ -n "$sid" ]; then
    map_set "$pr" session_id "$sid"; log "PR #$pr: linked to session $sid"
  else
    log "PR #$pr: WARNING could not identify the new session (next round starts fresh)"
  fi
  return "$rc"
}

# --- per-PR check -----------------------------------------------------------------------

check_pr() { # pr [sig] [force] [mode] -> processes new feedback for one PR (mode watch|manual; failure pings run regardless)
  local pr="$1" sig="${2:-}" force="${3:-}" mode="${4:-watch}" lock="$STATE_DIR/locks/$1"
  mkdir "$lock" 2>/dev/null || return 0   # another run in flight
  local new pf all rc=0 count newest
  new="$(mktemp)" pf="$(mktemp)" all="$(mktemp)"

  if ! fetch_feedback "$pr" >"$all"; then
    log "PR #$pr: couldn't fetch feedback from GitHub — will retry"
    rm -f "$all" "$new" "$pf"; rmdir "$lock" 2>/dev/null || true; return 0
  fi
  seed_seen "$pr" "$all"
  retry_reset_if_reviewed "$pr" "$all"
  filter_feedback "$pr" "$all" >"$new"
  [ -n "$sig" ] && map_set "$pr" sig "$sig"
  if [ ! -s "$new" ] && [ -n "$force" ] && [ -s "$STATE_DIR/feedback/$pr.jsonl" ]; then
    cp "$STATE_DIR/feedback/$pr.jsonl" "$new"; log "PR #$pr: re-running last round (--force)"
  fi
  handle_review_failure "$pr" "$all" "$mode" "$([ -s "$new" ] && echo 1 || echo 0)" || true
  rm -f "$all"
  if [ ! -s "$new" ]; then rm -f "$new" "$pf"; rmdir "$lock" 2>/dev/null || true; return 0; fi

  count="$(wc -l <"$new" | tr -d ' ')"
  newest="$(jq -r -s 'map(.ts) | max' "$new")"
  log "PR #$pr: $count new item(s) from $(jq -r -s 'map(.author) | unique | join(", ")' "$new") — agent started"
  cp "$new" "$STATE_DIR/feedback/$pr.jsonl"
  build_prompt "$pr" "$(pr_info "$pr" branch)" "$new" >"$pf"

  run_agent "$pr" "$pf" || rc=$?
  if [ "$rc" -eq 4 ]; then
    [ "$mode" = "manual" ] && echo "PR #$pr: worktree blocked — the branch is checked out in the main checkout; switch it to another branch and retry"
    log "PR #$pr: worktree blocked — feedback stays pending until the branch frees up in the main checkout"
    if [ -z "$(map_get "$pr" blocked_logged)" ]; then
      map_set "$pr" blocked_logged 1   # deterministic block: skip + one notice, no fail_count/escalation
      notify "PR #$pr" "Worktree blocked — switch the main checkout off this PR's branch"
    fi
  elif [ "$rc" -eq 2 ] || [ "$rc" -eq 3 ]; then
    log "PR #$pr: feedback stays pending"
  elif [ "$rc" -eq 0 ]; then
    jq -r '.key' "$new" >>"$STATE_DIR/seen/$pr"
    local rounds=$(( $(map_num "$pr" rounds) + 1 ))
    map_set "$pr" rounds "$rounds"; map_set "$pr" fail_count 0; map_del "$pr" gave_up
    map_set "$pr" last_seen_ts "$newest"
    map_set "$pr" last_head_sha "$(git -C "$(map_get "$pr" worktree)" rev-parse HEAD 2>/dev/null || echo '?')"
    log "PR #$pr: round $rounds finished ✓"
    notify "PR #$pr" "Round $rounds finished — $count item(s) addressed"
  else
    local fc=$(( $(map_num "$pr" fail_count) + 1 ))
    map_set "$pr" fail_count "$fc"
    log "PR #$pr: agent run failed (attempt $fc/$MAX_FAILS)"
    if [ "$fc" -ge "$MAX_FAILS" ]; then
      jq -r '.key' "$new" >>"$STATE_DIR/seen/$pr"   # stop retrying this round
      map_set "$pr" fail_count 0; map_set "$pr" gave_up 1
      gh pr comment "$pr" --repo "$(repo)" \
        --body "Automated run failed $MAX_FAILS times for this feedback round — needs manual attention." \
        >>"$LOG_FILE" 2>&1 || true
      log "PR #$pr: gave up on this round after $MAX_FAILS failures; escalated on the PR"
      notify "PR #$pr" "Gave up after $MAX_FAILS failed runs — needs you"
    fi
  fi

  if [ "$rc" -le 1 ]; then map_set "$pr" last_run_at "$(date +%s)"; fi
  rm -f "$new" "$pf" "$STATE_DIR/running/$pr"; rmdir "$lock" 2>/dev/null || true
}

skip_reason() { # pr -> why the watcher won't auto-run this PR (empty = eligible)
  local pr="$1" state review
  state="$(pr_info "$pr" state)"; review="$(pr_info "$pr" review)"
  if [ -n "$state" ] && [ "$state" != "OPEN" ]; then echo "$state" | tr 'A-Z' 'a-z'; return; fi
  if [ "$(map_get "$pr" paused)" = "1" ]; then echo "paused"; return; fi
  if [ "$MAX_ROUNDS" -gt 0 ] && [ "$(map_num "$pr" rounds)" -ge "$MAX_ROUNDS" ]; then echo "round limit"; return; fi
  if [ "$STOP_ON_APPROVE" = "1" ] && [ "$review" = "APPROVED" ]; then echo "approved"; return; fi
  return 0
}

# --- watcher ---------------------------------------------------------------------------

pid_is_watcher() { # pid -> 0 when pid is a live `pr-agent _loop` process
  kill -0 "$1" 2>/dev/null && ps -p "$1" -o command= 2>/dev/null | grep -q "_loop"
}

is_running() {
  [ -f "$PID_FILE" ] || return 1
  local pid; pid="$(cat "$PID_FILE")"
  pid_is_watcher "$pid"
}

pr_sig() { # pr -> change signature (updatedAt + head + CI + mergeability)
  jq -r --argjson n "$1" 'select(.number == $n) | "\(.updated)|\(.head)|\(.ci)|\(.mergeable)"' "$PRS_CACHE" | head -1
}

watch_loop() {
  cd "$(repo_dir)" 2>/dev/null || cd /   # a deleted launch dir spams getcwd errors on every job
  rm -rf "$STATE_DIR"/locks/*/ "$STATE_DIR"/running/* 2>/dev/null || true   # drop markers orphaned by a previous dead loop
  retry_cutoff >/dev/null   # set once on first start of this version; pre-existing failures stay manual-only
  echo $$ >"$PID_FILE"
  trap 'rm -f "$PID_FILE" "$STATE_DIR/cycle_active"; exit 0' TERM INT
  log "watcher started (repo=$(repo), every ${INTERVAL}s, mode=$PERM_MODE, concurrency=$CONCURRENCY)"
  local cycle=0 pr reason sig gh_down=0 rc
  while true; do
    cd "$(repo_dir)" 2>/dev/null || cd /   # keep cwd valid — repo_dir itself may be deleted mid-run
    touch "$STATE_DIR/cycle_active"
    if refresh_prs 0; then
      [ "$gh_down" -eq 1 ] && log "GitHub reachable again"; gh_down=0
      for pr in $(targets); do
        if [ "$(map_get "$pr" worktree_blocked)" = "1" ]; then
          # freeing the branch is a local act pr_sig can't see — re-probe every poll
          # (still_blocked is local-only), skipped PRs included so the flag can't go
          # stale under a pause/limit. rc 2 = indeterminate (repo unreadable): keep
          # the flag and skip — forcing a round would only burn fail_count. Only a
          # confirmed-free probe clears flag + sig so this poll's check runs.
          rc=0; still_blocked "$pr" || rc=$?
          [ "$rc" -eq 1 ] || continue
          map_del "$pr" worktree_blocked; map_del "$pr" blocked_logged; map_del "$pr" sig
        fi
        reason="$(skip_reason "$pr")"
        if [ -n "$reason" ]; then
          if [ "$(map_get "$pr" skip_logged)" != "$reason" ]; then
            map_set "$pr" skip_logged "$reason"
            case "$reason" in
              "round limit") log "PR #$pr: reached $MAX_ROUNDS rounds — auto-runs stopped (pr-agent run $pr to continue)"
                             notify "PR #$pr" "Hit the $MAX_ROUNDS-round limit — needs you" ;;
              approved)      log "PR #$pr: approved — auto-runs stopped"; notify "PR #$pr" "Approved 🎉" ;;
              *)             log "PR #$pr: $reason — skipping" ;;
            esac
          fi
          continue
        fi
        [ -n "$(map_get "$pr" skip_logged)" ] && map_del "$pr" skip_logged
        sig="$(pr_sig "$pr")"
        if [ -n "$sig" ] && [ "$sig" = "$(map_get "$pr" sig)" ] && [ "$(map_num "$pr" fail_count)" -eq 0 ] \
           && [ $(( cycle % FULL_CHECK_EVERY )) -ne 0 ]; then
          continue   # nothing changed on GitHub since the last check
        fi
        while [ "$(jobs -rp | wc -l | tr -d ' ')" -ge "$CONCURRENCY" ]; do sleep 2; done
        ( check_pr "$pr" "$sig" || true ) &
      done
      if [ "$MAIN_SYNC" = "1" ]; then sync_scan watch || true; fi
    elif [ "$gh_down" -eq 0 ]; then
      gh_down=1; log "WARNING can't reach GitHub (gh auth status?) — retrying every ${INTERVAL}s"
    fi
    rm -f "$STATE_DIR/cycle_active"
    date +%s >"$STATE_DIR/last_cycle"
    cycle=$(( cycle + 1 ))
    sleep "$INTERVAL" & wait $! || true
  done
}

LAUNCHD_LABEL="dev.pr-agent.$REPO_SLUG"
LAUNCHD_PLIST="$HOME/Library/LaunchAgents/$LAUNCHD_LABEL.plist"

install_launchd() {
  mkdir -p "$(dirname "$LAUNCHD_PLIST")"
  cat >"$LAUNCHD_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LAUNCHD_LABEL</string>
  <key>ProgramArguments</key><array><string>$SELF</string><string>_loop</string></array>
  <key>WorkingDirectory</key><string>$(repo_dir)</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>$PATH</string>
    <key>HOME</key><string>$HOME</string>
    <key>PR_AGENT_REPO</key><string>$(repo)</string>
    <key>PR_AGENT_STATE_DIR</key><string>$STATE_ROOT</string>
    <key>DEVIN_BIN</key><string>$DEVIN_BIN</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/dev/null</string>
  <key>StandardErrorPath</key><string>$LOG_FILE</string>
</dict>
</plist>
EOF
  plutil -lint "$LAUNCHD_PLIST" >/dev/null || die "generated plist is invalid: $LAUNCHD_PLIST"
  launchctl bootout "gui/$(id -u)/$LAUNCHD_LABEL" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$LAUNCHD_PLIST"
}

cmd_on() {
  local use_launchd=0
  if [ "${1:-}" = "--launchd" ]; then use_launchd=1; shift; fi
  is_running && die "already running (pid $(cat "$PID_FILE")) — 'pr-agent off' first"
  detect_repo
  map_init
  if [ $# -eq 0 ] || [ "$1" = "all" ]; then
    echo "all" >"$STATE_DIR/targets"
  else
    local n; for n in "$@"; do need_real_pr "$n"; done   # validate before anything lands in targets
    echo "$*" >"$STATE_DIR/targets"
  fi
  save_config
  local what; what="$(cat "$STATE_DIR/targets")"
  if [ "$what" = "all" ]; then what="$(scope_label)"; else what="$(hash_list "$what")"; fi
  if [ "$use_launchd" -eq 1 ]; then
    install_launchd
    echo "watching $what on $(repo) via launchd ($LAUNCHD_LABEL, every $(fmt_dur "$INTERVAL")) — pr-agent status to follow"
  else
    # stdout goes to /dev/null — log() writes the file itself; stray stderr still lands in the log
    nohup "$SELF" _loop >/dev/null 2>>"$LOG_FILE" &
    echo $! >"$PID_FILE"
    echo "watching $what on $(repo) (pid $!, every $(fmt_dur "$INTERVAL")) — pr-agent status to follow"
  fi
}

kill_agents() { # -> terminate running agent processes for this repo
  local m apid
  for m in "$STATE_DIR"/running/*; do
    [ -f "$m" ] || continue
    read -r apid _ <"$m"
    rm -f "$m"   # first: run_agent reads a missing marker as "stopped by user"
    pkill -TERM -P "$apid" 2>/dev/null || true; kill "$apid" 2>/dev/null || true
    echo "killed agent for PR #$(basename "$m") (pid $apid)"
  done
}

cmd_off() {
  local stopped=0
  if [ -f "$LAUNCHD_PLIST" ]; then
    launchctl bootout "gui/$(id -u)/$LAUNCHD_LABEL" 2>/dev/null || true
    rm -f "$LAUNCHD_PLIST"; stopped=1; echo "removed launchd job $LAUNCHD_LABEL"
  fi
  if is_running; then
    local pid; pid="$(cat "$PID_FILE")"; kill "$pid" 2>/dev/null || true
    rm -f "$PID_FILE"; stopped=1; echo "stopped watcher (pid $pid)"
  fi
  if [ "${1:-}" = "--now" ]; then
    [ -n "$(ls "$STATE_DIR/running" 2>/dev/null)" ] && stopped=1
    kill_agents
  elif [ -n "$(ls "$STATE_DIR/running" 2>/dev/null)" ]; then
    echo "note: agents still running for $(ls "$STATE_DIR/running" | sed 's/^/#/' | tr '\n' ' ')— they'll finish their round ('pr-agent off --now' to kill)"
  fi
  [ "$stopped" -eq 1 ] || die "not running"
}

# --- manual per-PR commands ------------------------------------------------------------

need_pr() { [[ "${1:-}" =~ ^[0-9]+$ ]] || die "expected a PR number"; }

gh_err_not_pr() { # gh pr view stderr -> rc 0 iff it means the number is not a pull request (vs repo-level/transport errors)
  case "$1" in *"Could not resolve to a PullRequest"*) return 0 ;; *) return 1 ;; esac
}

need_real_pr() { # N -> need_pr + dies unless the number resolves to a pull request (one gh call — manual commands only)
  need_pr "${1:-}"; need_repo
  local err
  if err="$(gh pr view "$1" --repo "$(repo)" --json number 2>&1 >/dev/null)"; then return 0; fi
  gh_err_not_pr "$err" && die "#$1 is not a pull request on $(repo) — that number may be an issue"
  die "couldn't verify PR #$1 on $(repo): ${err:-gh failed}"
}

cmd_run() { # N [--force]
  need_real_pr "${1:-}"; local force=''
  [ "${2:-}" = "--force" ] && force=1
  refresh_prs 0 || die "can't reach GitHub"
  [ -d "$STATE_DIR/locks/$1" ] && die "PR #$1 is already being processed"
  check_pr "$1" "" "$force" manual
  if [ -e "$STATE_DIR/logs/$1/latest.log" ] && [ "$(map_get "$1" last_run_at)" -ge $(( $(date +%s) - 5 )) ] 2>/dev/null; then
    echo; echo "── agent output ──"; cat "$STATE_DIR/logs/$1/latest.log"
  fi
}

cmd_tell() { # N message... -> send an owner instruction to the PR's session in the background
  need_real_pr "${1:-}"; local pr="$1"; shift
  [ $# -gt 0 ] || die "usage: pr-agent tell N \"message\""
  [ -d "$STATE_DIR/locks/$pr" ] && die "agent is busy on PR #$pr — try again when it finishes"
  refresh_prs 60 || true
  local pf="$STATE_DIR/feedback/$pr.tell.md"
  cat >"$pf" <<EOF
Instruction from the PR owner for PR #$pr ($(repo), branch \`$(pr_info "$pr" branch)\`). You are in the PR's worktree; earlier context is preserved.

$*

Run \`git status\` and \`git fetch origin\` first and re-read files before editing. If you change code: verify per AGENTS.md, commit per topic, push, and summarise what you did in a PR comment.
EOF
  nohup "$SELF" _tell "$pr" "$pf" >/dev/null 2>>"$LOG_FILE" &
  echo "sent to PR #$pr's agent (pid $!) — follow with: pr-agent logs $pr -f"
  if [ "$(map_get "$pr" worktree_blocked)" = "1" ]; then
    echo "note: the worktree is marked blocked — if the branch is still in the main checkout the instruction won't be delivered (watch.log will say so)"
  fi
}

_tell() { # N prompt_file (internal, background)
  local pr="$1" lock="$STATE_DIR/locks/$1" rc=0
  mkdir "$lock" 2>/dev/null || { log "PR #$pr: tell skipped — agent busy"; return 0; }
  log "PR #$pr: owner instruction sent to agent"
  run_agent "$pr" "$2" || rc=$?
  if [ "$rc" -eq 0 ]; then log "PR #$pr: instruction handled ✓"; notify "PR #$pr" "Your instruction was handled"
  elif [ "$rc" -eq 1 ]; then log "PR #$pr: instruction run failed (see pr-agent logs $pr)"
  elif [ "$rc" -eq 4 ]; then log "PR #$pr: instruction not delivered — worktree blocked (branch checked out in the main checkout)"; fi
  map_set "$pr" last_run_at "$(date +%s)"
  rm -f "$STATE_DIR/running/$pr"; rmdir "$lock" 2>/dev/null || true
}

cmd_attach() { # N -> interactive session in the PR's worktree
  need_real_pr "${1:-}"
  local wt sid; wt="$(map_get "$1" worktree)"; sid="$(map_get "$1" session_id)"
  [ -n "$wt" ] && [ -d "$wt" ] || die "PR #$1 has no worktree yet — 'pr-agent run $1' first"
  [ -d "$STATE_DIR/locks/$1" ] && echo "warning: an automated run is in progress on #$1 — the session may be busy" >&2
  cd "$wt"
  # shellcheck disable=SC2046
  if [ -n "$sid" ]; then exec "$DEVIN_BIN" $(devin_flags) -r "$sid"; fi
  echo "PR #$1 has no session yet — opening a new one in $wt" >&2
  exec "$DEVIN_BIN" $(devin_flags)
}

cmd_retry() { # N [--dry-run] -> ping the review bot if its latest review run failed (ignores the backlog cutoff)
  need_real_pr "${1:-}"; map_init
  local pr="$1" mode=manual lock="$STATE_DIR/locks/$1" all rc=0
  [ "${2:-}" = "--dry-run" ] && mode=dry
  mkdir "$lock" 2>/dev/null || die "PR #$pr is already being processed — try again when it finishes"
  all="$(mktemp)"
  if ! fetch_feedback "$pr" >"$all"; then rm -f "$all"; rmdir "$lock" 2>/dev/null || true; die "can't reach GitHub"; fi
  if [ "$mode" != "dry" ]; then seed_seen "$pr" "$all"; retry_reset_if_reviewed "$pr" "$all"; fi
  handle_review_failure "$pr" "$all" "$mode" 0 || rc=$?
  if [ "$rc" -ne 0 ]; then echo "PR #$pr: retry check failed (see watch.log)" >&2
  elif [ -z "$(review_failure_plan "$pr" "$all")" ]; then echo "PR #$pr: no failed review run found (nothing newer than the last failure by the review bot)"
  fi
  rm -f "$all"; rmdir "$lock" 2>/dev/null || true
}

cmd_peek() {
  need_real_pr "${1:-}"; refresh_prs 60 || true
  local items plan reason
  items="$(pending_feedback "$1")" || die "can't reach GitHub"
  if [ -n "$RETRY" ] && [ "$RETRY" = "1" ]; then
    local allf; allf="$(mktemp)"
    if fetch_feedback "$1" >"$allf" && plan="$(review_failure_plan "$1" "$allf")" && [ -n "$plan" ]; then
      reason="$(jq -r .reason <<<"$plan")"
      case "$reason" in
        "") if [ -f "$STATE_DIR/retry_cutoff" ] && [ "$(jq -r .updated <<<"$plan")" '<' "$(cat "$STATE_DIR/retry_cutoff")" ]; then
              echo "review-run failure $(jq -r .updated <<<"$plan") ($(jq -r .url <<<"$plan")) — pre-cutoff, watcher won't ping; 'pr-agent retry $1'"
            else
              echo "review-run failure $(jq -r .updated <<<"$plan") ($(jq -r .url <<<"$plan")) — ping needed (watcher picks it up, or 'pr-agent retry $1')"
            fi ;;
        *)  echo "review-run failure $(jq -r .updated <<<"$plan") — already handled ($reason)" ;;
      esac
    fi
    rm -f "$allf"
  fi
  [ -n "$items" ] || { echo "PR #$1: no unprocessed feedback"; return 0; }
  echo "$items" | jq -r '"\(.ts)  \(.kind)\(if .path then " \(.path):\(.line)" else "" end)  @\(.author)\n    \((.body // "") | split("\n") | map(select(length > 0)) | .[0] // "" | .[0:140])\n    \(.url)"'
}

cmd_mark_seen() {
  need_real_pr "${1:-}"; refresh_prs 60 || true
  local all n; all="$(mktemp)"
  fetch_feedback "$1" >"$all" || die "can't reach GitHub"
  jq -r '.key' "$all" >"$STATE_DIR/seen/$1"; n="$(wc -l <"$all" | tr -d ' ')"; rm -f "$all"
  map_del "$1" gave_up; map_del "$1" retry_gave_up; map_set "$1" fail_count 0
  echo "PR #$1: marked $n item(s) as handled — won't trigger a run"
}

forget_pr() { # pr -> drop all local state for one PR (map key, seen, feedback, transcripts)
  map_rm "$1"; rm -rf "$STATE_DIR/seen/$1" "$STATE_DIR/feedback/$1".* "$STATE_DIR/logs/$1"
}

cmd_gc() { # [--yes] -> remove worktrees/branches/state for merged & closed PRs and stale non-PR keys
  need_repo; refresh_prs 0 || die "can't reach GitHub"
  local yes='' pr state wt branch rd planned=0; rd="$(repo_dir)"
  [ "${1:-}" = "--yes" ] && yes=1
  for pr in $(jq -r '.prs | keys[]' "$MAP_FILE"); do
    state="$(pr_info "$pr" state)"
    if [ -z "$state" ]; then   # no cached object: keep real PRs the caches missed, forget keys that never were PRs
      local verr
      if verr="$(gh pr view "$pr" --repo "$(repo)" --json number 2>&1 >/dev/null)"; then continue; fi
      gh_err_not_pr "$verr" || { echo "#$pr: couldn't verify — skipping"; continue; }
      planned=1
      echo "#$pr (not a pull request):"
      echo "  forget session/state"
      if [ -n "$yes" ]; then
        rmdir "$STATE_DIR/locks/$pr" 2>/dev/null || true   # orphaned — no live run can hold a lock on a non-PR number
        forget_pr "$pr"
      fi
      continue
    fi
    [ "$state" = "MERGED" ] || [ "$state" = "CLOSED" ] || continue
    [ -d "$STATE_DIR/locks/$pr" ] && { echo "#$pr: busy, skipping"; continue; }
    wt="$(map_get "$pr" worktree)"; branch="$(map_get "$pr" branch)"; planned=1
    echo "#$pr ($state):"
    if [ -n "$wt" ] && [ -d "$wt" ] && [ "$wt" != "$rd" ]; then
      echo "  remove worktree $wt"
      if [ -n "$yes" ] && ! git -C "$rd" worktree remove "$wt"; then
        echo "  ! worktree has uncommitted changes — left in place (inspect: git -C $wt status)"; continue
      fi
    fi
    if [ "$state" = "MERGED" ] && [ -n "$branch" ] && git -C "$rd" show-ref --verify --quiet "refs/heads/$branch"; then
      echo "  delete local branch $branch"
      [ -n "$yes" ] && { git -C "$rd" branch -D "$branch" >/dev/null || echo "  ! couldn't delete $branch"; }
    fi
    echo "  forget session/state"
    if [ -n "$yes" ]; then forget_pr "$pr"; fi
  done
  if [ -n "$yes" ] && [ -f "$PRS_EXTRA" ]; then
    local keep tmp2
    keep="$( { jq -r '.prs | keys[]' "$MAP_FILE" 2>/dev/null || true
               [ -f "$STATE_DIR/targets" ] && tr ' ' '\n' <"$STATE_DIR/targets" || true; } \
             | { grep -E '^[0-9]+$' || true; } | sort -un | jq -Rn '[inputs | tonumber]')"
    tmp2="$(mktemp)"
    jq -c --argjson keep "$keep" 'select(.number as $n | $keep | index($n))' "$PRS_EXTRA" >"$tmp2" \
      && mv "$tmp2" "$PRS_EXTRA" || rm -f "$tmp2"
  fi
  [ -n "$yes" ] && git -C "$rd" worktree prune
  if [ "$planned" -eq 0 ]; then echo "nothing to clean up"
  elif [ -z "$yes" ]; then echo; echo "dry run — re-run with 'pr-agent gc --yes' to apply"; fi
}

cmd_sync() { # [--apply [merged-dep-pr]] — report-only by default
  need_repo; map_init; refresh_prs 0 || die "can't reach GitHub"
  local apply='' depf='' st
  if [ "${1:-}" = "--apply" ]; then apply=1; shift; fi
  depf="${1:-}"
  if [ -n "$depf" ]; then
    need_pr "$depf"
    st="$(gh pr view "$depf" --repo "$(repo)" --json state -q .state 2>/dev/null)"
    [ "$st" = "MERGED" ] || die "PR #$depf is not merged (state: ${st:-unknown}) — pass a merged PR number"
  fi
  if [ -n "$apply" ]; then
    sync_scan apply "$depf"
    echo; echo "done — transcripts: pr-agent logs N"
  else
    sync_scan report "$depf"
    echo; echo "dry run — 'pr-agent sync --apply${depf:+ $depf}' to run it"
  fi
}

cmd_config() {
  local k trunc_note rows_note
  echo "repo:  $(repo 2>/dev/null || echo '—')   state: $STATE_DIR"
  for k in $SETTINGS; do printf '  %-17s %s (%s)\n' "$k" "${!k}" "$(setting_src "$k")"; done
  if [ "$(setting_src TITLE_LINES)" = default ]; then
    trunc_note="titles truncate after $TITLE_LINES line(s) for plain status, uncapped in status -w (mode default)"
  elif [ "$TITLE_LINES" -gt 0 ]; then trunc_note="titles truncate after $TITLE_LINES line(s)"
  else trunc_note="titles uncapped"; fi
  if [ "$TABLE_ROWS" -gt 0 ]; then rows_note="first $TABLE_ROWS PR records (status -w overflow falls to the frame clip)"
  else rows_note="all PR records (status -w keeps every record; overflow falls to the frame clip)"; fi
  echo "display: $trunc_note · $rows_note"
  [ -n "$SETTING_NOTES" ] && printf '  ignored invalid input:%s\n' "$SETTING_NOTES"
  echo "(saved by 'pr-agent on'; override with PR_AGENT_* env vars)"
}

cmd_logs() { # [N] [-f]
  need_repo
  if [[ "${1:-}" =~ ^[0-9]+$ ]]; then
    local f="$STATE_DIR/logs/$1/latest.log"
    [ -e "$f" ] || die "no agent transcript for PR #$1 yet"
    echo "── $(readlink "$f") ──"
    if [ "${2:-}" = "-f" ]; then tail -n 50 -f "$f"; else cat "$f"; fi
  elif [ "${1:-}" = "-f" ]; then tail -f "$LOG_FILE"
  else tail -n 30 "$LOG_FILE"; fi
}

# --- self-update ---------------------------------------------------------------------
# 'pr-agent update' pulls the pr-agent + pr-agent.sha256 assets published by ./release
# and swaps them over $SELF atomically — a running watcher keeps its old inode until
# restarted, so the swap is safe mid-run.

ver_gt() { # a b -> 0 when a is a higher semver than b (bare X.Y.Z; BSD sort has no -V)
  local a1 a2 a3 b1 b2 b3
  IFS=. read -r a1 a2 a3 <<<"$1"; IFS=. read -r b1 b2 b3 <<<"$2"
  a1=${a1:-0}; a2=${a2:-0}; a3=${a3:-0}; b1=${b1:-0}; b2=${b2:-0}; b3=${b3:-0}
  [ "$a1" -ne "$b1" ] && { [ "$a1" -gt "$b1" ]; return; }
  [ "$a2" -ne "$b2" ] && { [ "$a2" -gt "$b2" ]; return; }
  [ "$a3" -gt "$b3" ]
}

latest_release_tag() { # -> tag of the newest upstream release; empty when none published, non-zero on gh failure
  gh release list --repo "$UPDATE_REPO" --limit 1 --json tagName -q '.[0].tagName' \
    --exclude-drafts --exclude-pre-releases 2>/dev/null
}

cmd_update() { # [--check] [--force] [X.Y.Z] -> download a release and install it over this script
  local check=0 force=0 want="" a
  for a in "$@"; do
    case "$a" in
      --check) check=1 ;;
      --force) force=1 ;;
      -*) die "unknown flag '$a'" ;;
      *) [ -z "$want" ] || die "too many arguments"; want="${a#v}" ;;
    esac
  done
  command -v gh >/dev/null || die "update needs gh (https://cli.github.com)"

  local tag
  if [ -n "$want" ]; then
    [[ "$want" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "bad version '$want' — want X.Y.Z"
    if ! gh release view "v$want" --repo "$UPDATE_REPO" >/dev/null 2>&1; then
      gh release list --repo "$UPDATE_REPO" --limit 1 >/dev/null 2>&1 \
        || die "can't reach releases for $UPDATE_REPO (gh auth ok?)"
      die "no release v$want"
    fi
    tag="v$want"
  else
    tag="$(latest_release_tag)" || die "can't reach releases for $UPDATE_REPO (gh auth ok?)"
    [ -n "$tag" ] || die "no releases published yet"
    [[ "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "unexpected release tag '$tag' — want vX.Y.Z"
  fi
  local latest="${tag#v}"

  if [ "$check" = "1" ]; then
    local what="latest"; [ -n "$want" ] && what="target"
    echo "installed $VERSION · $what $tag"
    if [ "$latest" = "$VERSION" ]; then echo "up to date"
    elif ver_gt "$latest" "$VERSION"; then
      echo "update available — run 'pr-agent update${want:+ $want}'"
    else echo "newer than $what (dev build?)"; fi
    return 0
  fi

  if [ "$latest" = "$VERSION" ] && [ "$force" = "0" ]; then
    echo "already on $VERSION — nothing to do (--force to reinstall)"; return 0
  fi

  local dir self l; self="$SELF"
  while [ -L "$self" ]; do   # installed via symlink: swap the real target, keep the link
    l="$(readlink "$self")"; case "$l" in /*) self="$l" ;; *) self="$(dirname "$self")/$l" ;; esac
  done
  dir="$(dirname "$self")"
  if [ "$force" = "0" ] && git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    die "$self is inside a git worktree — refusing to overwrite it (--force to override)"
  fi
  [ -w "$dir" ] || die "$dir not writable — retry with: sudo pr-agent update $tag"

  UPDATE_TMP="$(mktemp -d)"; UPDATE_STAGED="$dir/.pr-agent.new.$$"   # globals: EXIT traps can't see locals under set -u
  trap 'rm -rf "$UPDATE_TMP"; rm -f "$UPDATE_STAGED"' EXIT
  gh release download "$tag" --repo "$UPDATE_REPO" --dir "$UPDATE_TMP" --clobber \
      -p pr-agent -p pr-agent.sha256 >/dev/null 2>&1 \
    || die "couldn't download $tag assets"
  (cd "$UPDATE_TMP" && shasum -a 256 -c pr-agent.sha256 >/dev/null 2>&1) \
    || die "$tag checksum verification failed — not installing"

  install -m 755 "$UPDATE_TMP/pr-agent" "$UPDATE_STAGED" 2>/dev/null \
    || die "couldn't stage the new script in $dir"
  mv -f "$UPDATE_STAGED" "$self" 2>/dev/null || die "couldn't install over $self"
  rm -rf "$UPDATE_TMP"; trap - EXIT

  if ver_gt "$latest" "$VERSION"; then echo "updated $VERSION → $latest at $self"
  else echo "installed $tag at $self (was $VERSION)"; fi
  local pf pid
  for pf in "$STATE_ROOT"/repos/*/pid; do
    [ -f "$pf" ] || continue
    pid="$(cat "$pf" 2>/dev/null || true)"
    if [ -n "$pid" ] && pid_is_watcher "$pid"; then
      echo "note: a watcher still runs $VERSION — restart it: pr-agent off, then your original 'pr-agent on' args (a bare 'on' resets the watch list to all and drops --launchd)"
      break
    fi
  done
  return 0
}

# OMZ-style update check: every invocation refreshes $STATE_ROOT/latest_release in a
# detached, throttled background job; the NEXT invocation (or status badge) notices.
# State is global, not per-repo — $STATE_ROOT/update_check.ts (epoch) + latest_release.

maybe_update_check() { # -> spawn a background release check at most every UPDATE_CHECK_EVERY secs
  [ "$UPDATE_CHECK" = "1" ] || return 0
  local stamp="$STATE_ROOT/update_check.ts" now last
  now="$(date +%s)"
  last="$(cat "$stamp" 2>/dev/null || echo 0)"; [[ "$last" =~ ^[0-9]+$ ]] || last=0
  [ "$last" -gt "$now" ] && last=0   # a future stamp is corrupt, not "recently checked"
  [ $(( now - last )) -lt "$UPDATE_CHECK_EVERY" ] && return 0
  echo "$now" 2>/dev/null >"$stamp" || return 0   # stamp first — no gh stampede; an unwritable stamp can't throttle, so bail
  ( latest="$(latest_release_tag)" && [ -n "$latest" ] \
      && printf '%s' "$latest" >"$STATE_ROOT/.latest_release.$$" \
      && mv -f "$STATE_ROOT/.latest_release.$$" "$STATE_ROOT/latest_release" ) >/dev/null 2>&1 </dev/null &
}

pending_update_version() { # -> release version newer than VERSION from the last check, or nothing; empty when checks are disabled
  [ "$UPDATE_CHECK" = "1" ] || return 1
  local v; v="$(cat "$STATE_ROOT/latest_release" 2>/dev/null || true)"; v="${v#v}"
  { [[ "$v" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] && [ "$v" != "$VERSION" ] && ver_gt "$v" "$VERSION"; } || return 1
  echo "$v"
}

