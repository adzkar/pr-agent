                    # prs/activity, loading:true. status -w paints it through the
                    # normal layout path so the first frame is immediate instead
                    # of waiting on the gather worker. Read-only like the layout
                    # side — the field set mirrors status_gather's jq emission.
  local now running=0 pid='' launchd=0 cyc=0 last_cycle=0 t watch_lbl reacts extras=''
  local gh_err=0 upd
  now="$(date +%s)"
  if is_running; then running=1; pid="$(cat "$PID_FILE" 2>/dev/null)"; fi
  [ -f "$LAUNCHD_PLIST" ] && launchd=1
  [ -f "$STATE_DIR/cycle_active" ] && cyc=1
  [ -f "$STATE_DIR/last_cycle" ] && last_cycle="$(cat "$STATE_DIR/last_cycle")"
  t="$(cat "$STATE_DIR/targets" 2>/dev/null || echo all)"
  if [ "$t" = "all" ] || [ -z "$t" ]; then watch_lbl="$(scope_label)"; else watch_lbl="$(hash_list "$t")"; fi
  if [ -n "$AUTHOR_FILTER" ]; then reacts="$AUTHOR_FILTER"; else reacts="humans"; [ -n "$BOTS" ] && reacts+=" + $BOTS"; fi
  [ "$SANDBOX" = "1" ] && extras+=" · sandbox"
  [ "$CI_TRIGGER" = "1" ] && extras+=" · CI"
  [ "$CONFLICT_TRIGGER" = "1" ] && extras+=" · conflicts"
  [ "$MAIN_SYNC" = "1" ] && extras+=" · main-sync"
  [ -f "$STATE_DIR/gh_error" ] && gh_err=1
  upd="$(pending_update_version || true)"
  jq -n --argjson now "$now" --arg repo "$(repo)" --arg update "$upd" \
